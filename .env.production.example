# ─────────────────────────────────────────────────────────────
# ETicketsGo — PRODUCTION environment template.
# Copy to `.env.production`, fill in real values, and NEVER commit the result.
# Consumed by docker-compose.prod.yml (env_file) and by the CI/CD deploy job.
#
# Secrets management: in real deployments prefer your platform's secret store
# (GitHub Actions secrets, AWS SSM/Secrets Manager, Vault, Fly/Render secrets)
# over a plaintext file. This template documents EVERY variable each service
# needs so nothing is missed. See docs/guides/DEPLOYMENT.md.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
# Deployment environment for the payment platform (ADR-020). PRODUCTION fails
# closed on invalid payment configuration. See docs/guides/PAYMENT-PLATFORM.md.
APP_ENV=PRODUCTION

# ─── Postgres (db service) ───────────────────────────────────
# POSTGRES_PASSWORD is REQUIRED (compose fails fast if unset).
POSTGRES_USER=eticketsgo
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=eticketsgo

# ─── Database + Redis URLs (api, worker, migrate) ────────────
# Hostnames `db` / `redis` are the compose service names. If you use managed
# Postgres/Redis, replace with their URLs (and require TLS: `?sslmode=require`).
DATABASE_URL="postgresql://eticketsgo:CHANGE_ME_strong_db_password@db:5432/eticketsgo?schema=public"
REDIS_URL="redis://redis:6379"

# ─── API server ──────────────────────────────────────────────
API_PORT=4000
API_GLOBAL_PREFIX=api
# Comma-separated allowed browser origins (your real customer/organizer/admin
# hostnames, https). No trailing slash.
CORS_ORIGINS="https://tickets.example.com,https://organizer.example.com,https://admin.example.com"
# How the api container port is published on the host. Behind a reverse proxy on
# the same host keep it loopback-only (default 127.0.0.1:4000). Set to
# "0.0.0.0:4000" only if nothing else terminates TLS in front of it.
# API_PUBLISH=127.0.0.1:4000

# ─── Auth / signing secrets (api) ────────────────────────────
# Generate with: openssl rand -base64 48   (use DISTINCT values, keep secret)
JWT_ACCESS_SECRET=CHANGE_ME_long_random_access_secret
JWT_REFRESH_SECRET=CHANGE_ME_long_random_refresh_secret
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="30d"
QR_SIGNING_SECRET=CHANGE_ME_long_random_qr_secret

# ─── Payments (api) ──────────────────────────────────────────
# Default adapter + single-provider webhook path: razorpay | stripe | paypal |
# square. Use a REAL provider in production — never `mock` (the fail-closed
# validator rejects the dummy provider here). Per-currency routing, failover and
# enable/mode flags are managed at runtime in the admin console (Payment Config)
# and stored per APP_ENV in the database. Secrets are stored as REFERENCES; your
# secret manager injects the resolved values into the raw vars below at boot.
PAYMENT_PROVIDER_NAME=stripe
# Signature-verification secret for the generic webhook guard.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# The mock "simulate payment" path MUST be disabled in production. Setting
# NODE_ENV=production already forces it off; this makes the intent explicit.
PAYMENTS_MOCK_ENABLED=false

# --- Razorpay (only if PAYMENT_PROVIDER_NAME=razorpay) ---
# RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# --- Stripe (only if PAYMENT_PROVIDER_NAME=stripe) ---
STRIPE_SECRET_KEY="sk_live_CHANGE_ME"
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_ME"
STRIPE_SUCCESS_URL="https://tickets.example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="https://tickets.example.com/checkout/cancel"

# --- PayPal (only if routed to paypal). Webhook: /api/payments/webhook/paypal ---
# PAYPAL_CLIENT_ID="CHANGE_ME"
# PAYPAL_CLIENT_SECRET="CHANGE_ME"
# PAYPAL_WEBHOOK_ID="CHANGE_ME"
# PAYPAL_API_BASE_URL="https://api-m.paypal.com"

# --- Square (only if routed to square). Webhook: /api/payments/webhook/square ---
# SQUARE_ACCESS_TOKEN="CHANGE_ME"
# SQUARE_LOCATION_ID="CHANGE_ME"
# SQUARE_API_BASE_URL="https://connect.squareup.com"
# SQUARE_WEBHOOK_SIGNATURE_KEY="CHANGE_ME"
# SQUARE_WEBHOOK_URL="https://api.example.com/api/payments/webhook/square"

# ─── Notifications (api) ─────────────────────────────────────
# Each channel selects a transport; the selected provider's keys are required or
# the API fails fast on boot. Default `log` is dev-only — pick real transports.

# Email: log | sendgrid | ses
EMAIL_PROVIDER=sendgrid
EMAIL_FROM="no-reply@example.com"
# SendGrid:
SENDGRID_API_KEY="SG.CHANGE_ME"
# AWS SES v2 (if EMAIL_PROVIDER=ses) — omit keys to use the instance IAM role:
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIA_CHANGE_ME"
# AWS_SECRET_ACCESS_KEY="CHANGE_ME"

# SMS: log | twilio
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID="AC_CHANGE_ME"
# TWILIO_AUTH_TOKEN="CHANGE_ME"
# TWILIO_FROM_NUMBER="+10000000000"

# WhatsApp: log | cloud
WHATSAPP_PROVIDER=log
# WHATSAPP_PHONE_NUMBER_ID="CHANGE_ME"
# WHATSAPP_ACCESS_TOKEN="CHANGE_ME"

# Push: log | fcm
PUSH_PROVIDER=log
# FCM_PROJECT_ID="your-firebase-project-id"
# FCM_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── Storage (api) ───────────────────────────────────────────
# `local` writes to a container path (ephemeral). For production assets use an
# S3-compatible bucket (future blob storage for uploads/exports).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=".storage"
# S3_ENDPOINT=""
# S3_REGION="us-east-1"
# S3_BUCKET="eticketsgo"
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""

# ─── Worker (worker service) ─────────────────────────────────
WORKER_PORT=4100
# HOLD_EXPIRY_INTERVAL_MS=60000
# NOTIFICATION_SWEEP_INTERVAL_MS=30000

# ─── Web apps (customer-web / organizer-web / admin-web) ─────
# BUILD-TIME value — inlined into the browser bundle. Must be the PUBLIC API URL
# reachable from users' browsers (through your reverse proxy / LB), including the
# /api prefix. Rebuild the web images when this changes.
NEXT_PUBLIC_API_URL="https://api.example.com/api"
# Host publish bindings (behind a reverse proxy, keep loopback):
# CUSTOMER_WEB_PUBLISH=127.0.0.1:3000
# ORGANIZER_WEB_PUBLISH=127.0.0.1:3001
# ADMIN_WEB_PUBLISH=127.0.0.1:3002

# ─── Container image coordinates (compose image tags) ────────
# Used by docker-compose.prod.yml when pulling CI-built images.
# REGISTRY=ghcr.io/your-org/eticketsgo
# IMAGE_TAG=latest

# ─── Feature flags ───────────────────────────────────────────
# Shipped features default ON, enterprise capabilities default OFF — leave
# enterprise flags off in production unless you are deliberately enabling one.
# FEATURE_AI_RECOMMENDATIONS=0
# FEATURE_DYNAMIC_PRICING=0
# FEATURE_SPONSORS=0

# ── Cloud secret manager (required when SECRET_MANAGER_PROVIDER != env) ──
# SECRET_CACHE_TTL_MS=300000              # resolved-secret cache TTL (supports rotation)
# AWS_SECRETS_REGION=us-east-1            # SECRET_MANAGER_PROVIDER=aws
# AZURE_KEY_VAULT_URL=https://<vault>.vault.azure.net   # SECRET_MANAGER_PROVIDER=azure
# GCP_PROJECT_ID=my-gcp-project           # SECRET_MANAGER_PROVIDER=gcp
