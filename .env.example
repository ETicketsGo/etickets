# ─────────────────────────────────────────────────────────────
# ETicketsGo — environment variables
# Copy to .env and adjust for your machine. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# --- Database (Postgres) ---
# Matches docker-compose.yml service `db`.
DATABASE_URL="postgresql://eticketsgo:eticketsgo@localhost:5432/eticketsgo?schema=public"

# --- Redis (booking holds, cache, queues) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# --- Auth (JWT) ---
# Use long random strings in production. These are local dev defaults.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="30d"

# --- QR signed tokens ---
QR_SIGNING_SECRET="dev-qr-signing-secret-change-me"

# --- Mock payment provider ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"
# Mock "simulate payment" path is allowed unless this is "false" or NODE_ENV=production.
# Read directly in apps/api/src/payments/payments.service.ts (not validated by the config schema).
# PAYMENTS_MOCK_ENABLED=true

# --- Payment provider selection ---
# Which real provider the platform charges through: mock | razorpay | stripe.
# Defaults to `mock` so dev/test/e2e need no gateway keys. See docs/guides/PAYMENT-INTEGRATION.md.
PAYMENT_PROVIDER_NAME=mock

# --- Razorpay (India) ---
# Only required when PAYMENT_PROVIDER_NAME=razorpay. Sandbox vs production is
# simply test keys vs live keys (same code). Register the webhook at:
#   POST {API_URL}/api/payments/webhook  (events: payment.captured, payment.failed)
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# --- Stripe (global) ---
# Only required when PAYMENT_PROVIDER_NAME=stripe. Sandbox vs production is
# simply test keys (sk_test_…) vs live keys (sk_live_…) — same code.
# Register the webhook at POST {API_URL}/api/payments/webhook with events:
#   checkout.session.completed, payment_intent.succeeded,
#   payment_intent.payment_failed, checkout.session.async_payment_failed
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
# STRIPE_SUCCESS_URL="http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}"
# STRIPE_CANCEL_URL="http://localhost:3000/checkout/cancel"

# --- Storage (S3-compatible abstraction) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=".storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="eticketsgo"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# --- Frontend apps ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- Background worker (apps/worker) ---
# Read directly from process.env in apps/worker/src/main.ts (not validated by the
# config schema). Values below are the built-in defaults; uncomment to override.
# WORKER_PORT=4100                       # worker health/readiness HTTP port
# HOLD_EXPIRY_INTERVAL_MS=60000          # interval of the expire-holds repeatable job
# NOTIFICATION_SWEEP_INTERVAL_MS=30000   # interval of the dispatch-notifications sweep

# --- Feature flags (optional overrides) ---
# Defaults live in packages/shared-types/src/features.ts. Override any flag with
# FEATURE_<KEY> (API) or NEXT_PUBLIC_FEATURE_<KEY> (web); truthy = "1" or "true".
# <KEY> is the upper-snake name, e.g. AI_RECOMMENDATIONS, DYNAMIC_PRICING, SPONSORS.
# Shipped features default on; enterprise capabilities default off.
# FEATURE_AI_RECOMMENDATIONS=1
# FEATURE_DYNAMIC_PRICING=1
# FEATURE_SPONSORS=1
