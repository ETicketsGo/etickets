# ─────────────────────────────────────────────────────────────
# ETicketsGo — environment variables
# Copy to .env and adjust for your machine. Never commit .env.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# --- Deployment environment (payment platform, ADR-020) ---
# Selects which env-scoped payment provider configs / routes / merchant accounts
# apply and which safety guards run. One of: LOCAL DEV QA UAT STAGING PRODUCTION.
# LOCAL/DEV/QA allow the simulated dummy provider; STAGING/PRODUCTION fail closed
# on invalid payment configuration. See docs/guides/PAYMENT-PLATFORM.md and the
# per-environment templates (.env.<env>.example).
APP_ENV=LOCAL

# --- Database (Postgres) ---
# Matches docker-compose.yml service `db`.
DATABASE_URL="postgresql://eticketsgo:eticketsgo@localhost:5432/eticketsgo?schema=public"

# --- Redis (booking holds, cache, queues) ---
REDIS_URL="redis://localhost:6379"

# --- API ---
API_PORT=4000
API_GLOBAL_PREFIX=api
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"

# --- Auth (JWT) ---
# Use long random strings in production. These are local dev defaults.
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="900s"
JWT_REFRESH_TTL="30d"

# --- QR signed tokens ---
QR_SIGNING_SECRET="dev-qr-signing-secret-change-me"

# --- Mock payment provider ---
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"
# Mock "simulate payment" path is allowed unless this is "false" or NODE_ENV=production.
# Read directly in apps/api/src/payments/payments.service.ts (not validated by the config schema).
# PAYMENTS_MOCK_ENABLED=true

# --- Payment provider selection ---
# Which provider this process constructs for the single-provider webhook path and
# as the orchestrator's default: mock | razorpay | stripe | paypal | square.
# Defaults to `mock` so dev/test/e2e need no gateway keys. The multi-country /
# multi-provider ROUTING (which provider serves which currency, failover, enable
# flags, modes) is managed at runtime in the admin console (Payment Config) and
# stored in the database per APP_ENV — not here. See docs/guides/PAYMENT-PLATFORM.md.
PAYMENT_PROVIDER_NAME=mock

# ─────────────────────────────────────────────────────────────
# Secrets are stored as REFERENCES, never raw values
# The runtime payment config (PaymentProviderConfig) stores only public keys and
# secret *references* — a path in your secret manager, e.g.
#   payments/stripe/live/secret-key
# Your deployment resolves each reference and injects the resolved secret into the
# raw environment variable the adapter reads (STRIPE_SECRET_KEY, etc.) at boot.
# Never commit real credentials. Never store raw card/PAN/CVV/UPI-PIN/bank creds.
# ─────────────────────────────────────────────────────────────

# --- Razorpay (India) ---
# Only required when PAYMENT_PROVIDER_NAME=razorpay. Sandbox vs production is
# simply test keys vs live keys (same code). Register the webhook at:
#   POST {API_URL}/api/payments/webhook  (events: payment.captured, payment.failed)
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# --- Stripe (global) ---
# Only required when PAYMENT_PROVIDER_NAME=stripe. Sandbox vs production is
# simply test keys (sk_test_…) vs live keys (sk_live_…) — same code.
# Register the webhook at POST {API_URL}/api/payments/webhook with events:
#   checkout.session.completed, payment_intent.succeeded,
#   payment_intent.payment_failed, checkout.session.async_payment_failed
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
# STRIPE_SUCCESS_URL="http://localhost:3000/checkout/success?session_id={CHECKOUT_SESSION_ID}"
# STRIPE_CANCEL_URL="http://localhost:3000/checkout/cancel"

# --- PayPal (global, Orders v2 REST) ---
# Only required when PAYMENT_PROVIDER_NAME=paypal. Sandbox vs production is the API
# base URL + credentials (never hardcoded). Route webhooks to
#   POST {API_URL}/api/payments/webhook/paypal
# PAYPAL_CLIENT_ID="xxxxxxxxxxxxxxxxxxxx"
# PAYPAL_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxx"
# PAYPAL_WEBHOOK_ID="xxxxxxxxxxxxx"
# PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"   # live: https://api-m.paypal.com
# PAYPAL_RETURN_URL="http://localhost:3000/checkout/success"
# PAYPAL_CANCEL_URL="http://localhost:3000/checkout/cancel"

# --- Square (Connect REST) ---
# Only required when PAYMENT_PROVIDER_NAME=square. Route webhooks to
#   POST {API_URL}/api/payments/webhook/square
# SQUARE_ACCESS_TOKEN="xxxxxxxxxxxxxxxxxxxx"
# SQUARE_LOCATION_ID="xxxxxxxxxxxxx"
# SQUARE_API_BASE_URL="https://connect.squareupsandbox.com"  # live: https://connect.squareup.com
# SQUARE_API_VERSION="2024-01-18"
# SQUARE_WEBHOOK_SIGNATURE_KEY="xxxxxxxxxxxxxxxxxxxx"
# SQUARE_WEBHOOK_URL="https://yourdomain.com/api/payments/webhook/square"

# --- Storage (S3-compatible abstraction) ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=".storage"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="eticketsgo"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# ─────────────────────────────────────────────────────────────
# Notification delivery transports
# Each channel selects a transport via <CHANNEL>_PROVIDER. Default `log` keeps
# the original log-only behaviour, so dev/test/e2e need NONE of the keys below.
# Only the selected provider is constructed; choosing a provider without its keys
# fails fast on boot. Sandbox vs production is just test vs live keys/tokens.
# See docs/guides/NOTIFICATION-INTEGRATION.md.
# ─────────────────────────────────────────────────────────────

# --- Email --- (log | sendgrid | ses). Recipient = the notification's toEmail.
EMAIL_PROVIDER=log
# EMAIL_FROM="no-reply@yourdomain.com"       # required for sendgrid & ses
# SendGrid (EMAIL_PROVIDER=sendgrid):
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxx"
# AWS SES v2 (EMAIL_PROVIDER=ses). Omit the key pair to use the default AWS
# credential chain (IAM role / shared config):
# AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="AKIAxxxxxxxxxxxxxxxx"
# AWS_SECRET_ACCESS_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- SMS --- (log | twilio). Recipient phone = payload.phone (E.164).
# NOTE: the platform does not collect phone numbers yet — with no payload.phone
# the twilio transport logs a "no SMS recipient" warning and skips (no error).
SMS_PROVIDER=log
# TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_AUTH_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# TWILIO_FROM_NUMBER="+15005550006"          # Twilio test-from number for sandbox

# --- WhatsApp --- (log | cloud). Recipient = payload.phone. WhatsApp Business
# Cloud API via fetch (no SDK). Same no-recipient skip behaviour as SMS.
WHATSAPP_PROVIDER=log
# WHATSAPP_PHONE_NUMBER_ID="1234567890"      # test number id for sandbox
# WHATSAPP_ACCESS_TOKEN="EAAxxxxxxxxxxxxxxxx"

# --- Push --- (log | fcm). Recipient token(s) = payload.pushToken or
# payload.pushTokens[]. Skips with a warning when neither is present.
PUSH_PROVIDER=log
# FCM_PROJECT_ID="your-firebase-project-id"
# FCM_CLIENT_EMAIL="firebase-adminsdk@your-project.iam.gserviceaccount.com"
# Escape newlines as \n on a single line:
# FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Frontend apps ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# --- Background worker (apps/worker) ---
# Read directly from process.env in apps/worker/src/main.ts (not validated by the
# config schema). Values below are the built-in defaults; uncomment to override.
# WORKER_PORT=4100                       # worker health/readiness + /metrics HTTP port
# HOLD_EXPIRY_INTERVAL_MS=60000          # interval of the expire-holds repeatable job
# NOTIFICATION_SWEEP_INTERVAL_MS=30000   # interval of the dispatch-notifications sweep
# QUEUE_METRICS_INTERVAL_MS=15000        # interval the worker samples queue depth into etg_queue_jobs

# --- Observability (all optional; unset ⇒ the feature is a complete no-op) ---
# See docs/guides/MONITORING.md. Defaults keep behaviour unchanged.
#
# Slow-query reporting: queries slower than this (ms) are logged (duration + target
# only, never SQL/params) and counted in etg_slow_queries_total. Read by PrismaService.
# SLOW_QUERY_MS=500
#
# Error tracking (Sentry). No DSN ⇒ Sentry is never initialised (API + worker).
# SENTRY_DSN="https://<key>@<org>.ingest.sentry.io/<project>"
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=eticketsgo@0.1.0
# SENTRY_TRACES_SAMPLE_RATE=0            # error tracking only by default
#
# Distributed tracing (OpenTelemetry). No endpoint ⇒ tracing never starts.
# Also install the OTel packages (see docs/guides/MONITORING.md) to activate.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
# OTEL_SERVICE_NAME=eticketsgo-api

# --- Feature flags (optional overrides) ---
# Defaults live in packages/shared-types/src/features.ts. Override any flag with
# FEATURE_<KEY> (API) or NEXT_PUBLIC_FEATURE_<KEY> (web); truthy = "1" or "true".
# <KEY> is the upper-snake name, e.g. AI_RECOMMENDATIONS, DYNAMIC_PRICING, SPONSORS.
# Shipped features default on; enterprise capabilities default off.
# FEATURE_AI_RECOMMENDATIONS=1
# FEATURE_DYNAMIC_PRICING=1
# FEATURE_SPONSORS=1

# ── Wallet passes (Apple / Google) — OFF by default; fail-closed when unset ──
# A wallet pass is a projection of an existing valid ticket (same signed QR). Secret
# material is referenced (…_REF) via a secret manager and is NEVER placed here.
# WALLET_APPLE_ENABLED=true
# WALLET_APPLE_MODE=sandbox            # sandbox | production
# WALLET_APPLE_PASS_TYPE_ID=pass.com.yourorg.tickets
# WALLET_APPLE_TEAM_ID=YOURTEAMID
# WALLET_APPLE_CERT_REF=secret://apple-pass-cert   # reference only, not the cert
# WALLET_GOOGLE_ENABLED=true
# WALLET_GOOGLE_MODE=sandbox
# WALLET_GOOGLE_ISSUER_ID=3388000000000000000
# WALLET_GOOGLE_SERVICE_ACCOUNT_REF=secret://google-wallet-sa   # reference only
