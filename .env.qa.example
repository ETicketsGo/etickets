# ─────────────────────────────────────────────────────────────
# ETicketsGo — QA environment (test/automation)
# Payment posture: dummy provider permitted for deterministic tests; real
# providers may run in TEST (sandbox) mode. No live money.
# Copy the FULL variable set from .env.example; this file shows the QA deltas.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
APP_ENV=QA

PAYMENT_PROVIDER_NAME=mock
PAYMENT_WEBHOOK_SECRET="qa-webhook-secret-from-secret-manager"

# Real providers, if enabled in the admin console for QA, must be TEST mode with
# SANDBOX credentials (references resolved by the secret manager):
#   payments/stripe/test/secret-key        payments/razorpay/test/secret-key
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-test-webhook-secret"

# NOTE: the dummy provider is still permitted in QA; it is REJECTED in UAT/STAGING/
# PRODUCTION by the fail-closed validator.
