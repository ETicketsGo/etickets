# ─────────────────────────────────────────────────────────────
# ETicketsGo — UAT environment (user acceptance testing)
# Payment posture: real providers in TEST (sandbox) mode. The dummy provider is
# NOT permitted. No live money moves, but flows are end-to-end against gateways.
# Copy the FULL variable set from .env.example; this file shows the UAT deltas.
#
# Deploying UAT on Railway? Use deploy/railway/env/uat.env.example instead — it
# lists every variable as a dashboard service variable, grouped and classified.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
APP_ENV=UAT

# Active adapter for the single-provider webhook path. Enablement + routing per
# provider is managed in the admin console (seeded: INR→Razorpay, else→Stripe).
PAYMENT_PROVIDER_NAME=stripe
PAYMENT_WEBHOOK_SECRET="uat-webhook-secret-from-secret-manager"

# SANDBOX credentials, injected from secret-manager references at boot:
#   payments/stripe/test/secret-key         payments/stripe/test/webhook-secret
#   payments/razorpay/test/secret-key        payments/razorpay/test/webhook-secret
STRIPE_SECRET_KEY="sk_test_replace_from_secret_manager"
STRIPE_WEBHOOK_SECRET="whsec_replace_from_secret_manager"
STRIPE_SUCCESS_URL="https://uat.eticketsgo.com/checkout/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="https://uat.eticketsgo.com/checkout/cancel"
RAZORPAY_KEY_ID="rzp_test_replace_from_secret_manager"
RAZORPAY_KEY_SECRET="replace_from_secret_manager"
RAZORPAY_WEBHOOK_SECRET="replace_from_secret_manager"

# The fail-closed validator rejects the dummy provider and LIVE mode in UAT.
