# ─────────────────────────────────────────────────────────────
# ETicketsGo — DEV environment (shared development)
# Payment posture: dummy provider by default; real providers may be enabled in
# TEST (sandbox) mode from the admin console for integration work.
# Copy the FULL variable set from .env.example; this file shows the DEV deltas.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=DEV

# Default active adapter. Switch to a sandbox provider only for integration tests.
PAYMENT_PROVIDER_NAME=mock
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"

# If you enable a real provider (TEST mode) in the admin console, provide its
# SANDBOX credentials. Secret manager references (documented per provider):
#   payments/stripe/test/secret-key       payments/stripe/test/webhook-secret
#   payments/razorpay/test/secret-key      payments/razorpay/test/webhook-secret
# Your deployment injects the resolved secret into the raw vars below at boot.
# STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
# RAZORPAY_WEBHOOK_SECRET="your-razorpay-test-webhook-secret"
