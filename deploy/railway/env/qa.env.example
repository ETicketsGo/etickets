# ─────────────────────────────────────────────────────────────────────────────
# ETicketsGo — Railway QA environment variable template  (project: ETicketsGo-QA)
#
# NOT a file you deploy. Railway has no .env file support for deployed services:
# every line below is entered as a SERVICE VARIABLE in the Railway dashboard (or
# via `railway variables --set`). This template exists so nothing is missed and so
# the required/optional/secret classification is reviewable in git.
#
# NEVER commit a filled-in copy. Values shown are placeholders or safe defaults.
#
# Legend
#   [REQUIRED]   the service will not boot (or will fail closed) without it
#   [OPTIONAL]   has a safe default; set only to override
#   [GENERATED]  a secret you generate — `openssl rand -base64 48` — unique per environment
#   [REFERENCE]  a Railway variable reference, resolved by Railway at deploy time
#   [TEST-ONLY]  must be a sandbox/test credential in this environment
#   [PROD-ONLY]  must NOT appear in this environment
#
# Applies to services: api, worker, customer-web, organizer-web, admin-web.
# The "Set on" note against each group says which services need it.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ APPLICATION / ENVIRONMENT IDENTITY ══════════════════ Set on: api, worker
# APP_ENV is the master isolation switch. It selects the payment environment
# (which provider configs/routes/merchant accounts apply), drives the fail-closed
# credential validation, and namespaces EVERY Redis key this environment writes
# (BullMQ queue prefix, cache, seat locks, maintenance flag). Getting it wrong is
# the single most dangerous misconfiguration on this platform.
APP_ENV=QA                                    # [REQUIRED] exactly QA here
NODE_ENV=production                           # [REQUIRED] QA runs production builds
API_GLOBAL_PREFIX=api                         # [OPTIONAL] default: api
TRUST_PROXY_HOPS=1                            # [OPTIONAL] Railway edge = 1 proxy hop
ENABLE_SWAGGER=true                           # [OPTIONAL] QA only — leave UNSET in Production

# PORT is injected by Railway. Do NOT set it. API_PORT/WORKER_PORT are only the
# non-Railway fallbacks and should stay unset here.


# ═══ DATABASE ════════════════════════════════════════════ Set on: api, worker
# Use the QA project's own PostgreSQL plugin. Reference it rather than pasting a
# URL so credential rotation propagates automatically.
DATABASE_URL=${{Postgres.DATABASE_URL}}       # [REQUIRED] [REFERENCE] QA Postgres ONLY
# Railway's private network avoids egress fees and keeps the DB off the internet.
# Prefer the *_PRIVATE_URL reference if the plugin exposes one.


# ═══ REDIS ═══════════════════════════════════════════════ Set on: api, worker
REDIS_URL=${{Redis.REDIS_URL}}                # [REQUIRED] [REFERENCE] QA Redis ONLY
REDIS_COMMAND_TIMEOUT_MS=1000                 # [OPTIONAL] default 1000
# Queue/cache/lock namespacing is derived from APP_ENV in code (etg:qa:*). There is
# no separate prefix variable to set — and nothing to get wrong — but it only works
# if APP_ENV above is correct.


# ═══ AUTHENTICATION ══════════════════════════════════════ Set on: api
# Distinct values per environment AND distinct from each other. Minimum 24 chars;
# a shipped placeholder ("CHANGE_ME", "replace_me", …) is rejected at boot.
JWT_ACCESS_SECRET=REPLACE_ME_openssl_rand_base64_48    # [REQUIRED] [GENERATED]
JWT_REFRESH_SECRET=REPLACE_ME_openssl_rand_base64_48   # [REQUIRED] [GENERATED]
JWT_ACCESS_TTL=900s                           # [OPTIONAL]
JWT_REFRESH_TTL=30d                           # [OPTIONAL]


# ═══ SIGNING / ENCRYPTION ════════════════════════════════ Set on: api, worker
QR_SIGNING_SECRET=REPLACE_ME_openssl_rand_base64_48    # [REQUIRED] [GENERATED]
# A QA-signed ticket must never validate in Production: keep this value unique.
# MANIFEST_SIGNING_SECRET=...                 # [OPTIONAL] offline check-in; falls back to QR_SIGNING_SECRET


# ═══ PAYMENTS ════════════════════════════════════════════ Set on: api, worker
# QA posture: dummy provider for deterministic automated tests. Real gateways may
# be enabled in TEST mode from the admin console. Live keys are REFUSED at boot.
PAYMENT_PROVIDER_NAME=mock                    # [REQUIRED] mock | stripe | razorpay
PAYMENT_LIVE_ENABLED=false                    # [REQUIRED] must stay false
PAYMENT_ALLOW_LIVE_KEYS_LOWER_ENV=false       # [REQUIRED] must stay false — see note below
# Setting PAYMENT_ALLOW_LIVE_KEYS_LOWER_ENV=true is the ONLY way a live key can boot
# in QA. It exists for one supervised scenario and must be reverted immediately after.

# --- Stripe (only if a real gateway is exercised in QA) --- [TEST-ONLY]
# STRIPE_SECRET_KEY=sk_test_REPLACE_ME        # boot FAILS on an sk_live_ key here
# STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME      # QA-specific endpoint secret
# STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME   # public, not a secret
# STRIPE_SUCCESS_URL=https://qa.eticketsgo.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://qa.eticketsgo.com/checkout/cancel

# --- Razorpay (only if a real gateway is exercised in QA) --- [TEST-ONLY]
# RAZORPAY_KEY_ID=rzp_test_REPLACE_ME         # boot FAILS on an rzp_live_ key here
# RAZORPAY_KEY_SECRET=REPLACE_ME
# RAZORPAY_WEBHOOK_SECRET=REPLACE_ME          # MUST differ from RAZORPAY_KEY_SECRET
# RAZORPAY_MODE=test                          # must agree with the key prefix
# RAZORPAY_CALLBACK_URL=https://qa.eticketsgo.com/checkout/razorpay/callback


# ═══ WEBHOOKS ════════════════════════════════════════════ Set on: api
# Generic webhook signature secret. Per-environment by construction: a QA webhook
# replay must never verify against Production.
PAYMENT_WEBHOOK_SECRET=REPLACE_ME_openssl_rand_base64_48   # [REQUIRED] [GENERATED]
# Must be DISTINCT from STRIPE_WEBHOOK_SECRET (enforced at boot).
# QA webhook endpoints to register in the provider dashboards:
#   Stripe   https://api-qa.eticketsgo.com/api/payments/webhook/stripe
#   Razorpay https://api-qa.eticketsgo.com/api/payments/webhooks/razorpay


# ═══ EMAIL ═══════════════════════════════════════════════ Set on: api, worker
# `log` writes the notification to stdout instead of sending — the right default for
# QA, where real sends to real addresses are a liability.
EMAIL_PROVIDER=log                            # [OPTIONAL] log | sendgrid | ses
# EMAIL_FROM=qa-noreply@eticketsgo.com        # required if a real provider is selected
# SENDGRID_API_KEY=REPLACE_ME                 # [TEST-ONLY] a QA-scoped key, never the prod key


# ═══ PUSH NOTIFICATIONS ══════════════════════════════════ Set on: api, worker
PUSH_PROVIDER=log                             # [OPTIONAL] log | fcm
# FCM_PROJECT_ID / FCM_CLIENT_EMAIL / FCM_PRIVATE_KEY — a SEPARATE Firebase project
# from Production, so a QA push can never reach a real customer's device.
WEBPUSH_PROVIDER=log                          # [OPTIONAL] log | vapid
SMS_PROVIDER=log                              # [OPTIONAL] log | twilio
WHATSAPP_PROVIDER=log                         # [OPTIONAL] log | cloud


# ═══ OBJECT STORAGE ══════════════════════════════════════ Set on: api
# NOTE: the S3 driver is declared in config but NOT implemented in this codebase —
# no upload/object-storage code path exists today. `local` is the only working value
# and Railway's filesystem is EPHEMERAL (wiped on every deploy). Do not rely on it
# for durable artefacts. See docs/deployment/RAILWAY_DEPLOYMENT_RUNBOOK.md.
STORAGE_DRIVER=local                          # [OPTIONAL] default: local


# ═══ MONITORING ══════════════════════════════════════════ Set on: api, worker
# Same Sentry project as the other environments is fine; the ENVIRONMENT tag is what
# separates the issue streams. A separate project also works.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>   # [OPTIONAL]
SENTRY_ENVIRONMENT=qa                         # [OPTIONAL] must match the environment
# SENTRY_RELEASE is set automatically by the deploy workflow to the git SHA.
SENTRY_TRACES_SAMPLE_RATE=0                   # [OPTIONAL] error tracking only
SLOW_QUERY_MS=500                             # [OPTIONAL]
# Bearer credential for GET /api/metrics and the worker's :WORKER_PORT/metrics.
# The scrape publishes etg_gmv_minor_total, etg_bookings_confirmed_total and the payment
# success/failure counters, so it is not public. UNSET in a deployed environment means the
# route answers 404 — closed, never open. Generate per environment; do not reuse across
# them, and set the SAME value as the METRICS_TOKEN secret on the GitHub Environment or
# the post-deploy smoke check skips itself with a warning.
# METRICS_TOKEN=<generate: openssl rand -hex 32>   # [OPTIONAL] required to expose metrics
# Tells the STOREFRONT it is not production, so the footer says the payments are simulated.
# Unset in production — absent means no notice, which is the safe default: a notice shown
# where it is false is worse than one missing where it is true.
NEXT_PUBLIC_APP_ENV=qa                        # [OPTIONAL] Set on: customer-web
# The state your COMPANY is registered in, e.g. Telangana. Decides IGST against CGST + SGST
# on the convenience fee, which follows where the buyer is rather than where the event is.
# Unset means unknown, and an unknown side never counts as crossing a border — so an
# unconfigured platform charges CGST + SGST, which is the same amount and the safe answer.
# PLATFORM_TAX_REGION=Telangana                # [OPTIONAL] required for correct GST attribution


# ═══ FEATURE FLAGS (P6 safety posture — do not weaken) ═══ Set on: api, worker
BOOKING_ORCHESTRATOR_MODE=shadow              # [REQUIRED]
BOOKING_REFUND_POLICY_MODE=MANUAL_ONLY        # [REQUIRED]
BOOKING_COMPENSATION_AUTO_REFUND_ENABLED=false   # [REQUIRED]
BOOKING_COMPENSATION_AUTO_VOID_ENABLED=false     # [REQUIRED]
BOOKING_COMPENSATION_EXECUTION_ENABLED=false     # [REQUIRED]
INVENTORY_LOCKS_ENABLED=false                 # [OPTIONAL] shadow-mode proof only
DOMAIN_EVENTS_ENABLED=false                   # [OPTIONAL]
DOMAIN_EVENT_DELIVERY_MODE=in_process         # [OPTIONAL]


# ═══ URLS AND CORS ═══════════════════════════════════════
# api service: the browser origins allowed to call the API. Comma-separated, https,
# no trailing slash. Never use a wildcard, and never include localhost here.
CORS_ORIGINS=https://qa.eticketsgo.com,https://organizer-qa.eticketsgo.com,https://admin-qa.eticketsgo.com   # [REQUIRED]

# web services: BUILD-TIME variable, inlined into the JS bundle. Must be set BEFORE
# the first build; changing it requires a rebuild, not a restart.
NEXT_PUBLIC_API_URL=https://api-qa.eticketsgo.com/api   # [REQUIRED] on all three web services


# ═══ WORKER TUNABLES ═════════════════════════════════════ Set on: worker
# All optional; defaults shown. QA can run slower sweeps to save resources.
# HOLD_EXPIRY_INTERVAL_MS=60000
# NOTIFICATION_SWEEP_INTERVAL_MS=30000
# WEBHOOK_SWEEP_INTERVAL_MS=15000
# QUEUE_METRICS_INTERVAL_MS=15000
