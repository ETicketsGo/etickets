# ─────────────────────────────────────────────────────────────────────────────
# ETicketsGo — Railway UAT environment variable template (project: ETicketsGo-UAT)
#
# NOT a file you deploy. Every line is entered as a SERVICE VARIABLE in the Railway
# dashboard (or via `railway variables --set`). NEVER commit a filled-in copy.
#
# UAT differs from QA in posture, not shape: real gateways in SANDBOX mode, the
# dummy provider is NOT permitted, and access is restricted to acceptance testers.
# Read deploy/railway/env/qa.env.example for the per-variable commentary; only the
# UAT-specific reasoning is repeated here.
#
# Legend: [REQUIRED] [OPTIONAL] [GENERATED] [REFERENCE] [TEST-ONLY] [PROD-ONLY]
# ─────────────────────────────────────────────────────────────────────────────


# ═══ APPLICATION / ENVIRONMENT IDENTITY ══════════════════ Set on: api, worker
APP_ENV=UAT                                   # [REQUIRED] exactly UAT here
NODE_ENV=production                           # [REQUIRED]
API_GLOBAL_PREFIX=api                         # [OPTIONAL]
TRUST_PROXY_HOPS=1                            # [OPTIONAL]
# ENABLE_SWAGGER — leave UNSET. UAT mirrors the production surface, and the API
# schema is free reconnaissance for anyone who reaches the host.

# PORT is injected by Railway. Do NOT set it.


# ═══ DATABASE ════════════════════════════════════════════ Set on: api, worker
DATABASE_URL=${{Postgres.DATABASE_URL}}       # [REQUIRED] [REFERENCE] UAT Postgres ONLY
# UAT is where realistic-volume acceptance data lives. If you seed it from a
# production snapshot, the data MUST be anonymised first — see the runbook's
# "Restoring the production database" section for why a raw copy is not acceptable.


# ═══ REDIS ═══════════════════════════════════════════════ Set on: api, worker
REDIS_URL=${{Redis.REDIS_URL}}                # [REQUIRED] [REFERENCE] UAT Redis ONLY
REDIS_COMMAND_TIMEOUT_MS=1000                 # [OPTIONAL]
# Keyspace is namespaced etg:uat:* from APP_ENV.


# ═══ AUTHENTICATION ══════════════════════════════════════ Set on: api
JWT_ACCESS_SECRET=REPLACE_ME_openssl_rand_base64_48    # [REQUIRED] [GENERATED]
JWT_REFRESH_SECRET=REPLACE_ME_openssl_rand_base64_48   # [REQUIRED] [GENERATED]
JWT_ACCESS_TTL=900s                           # [OPTIONAL]
JWT_REFRESH_TTL=30d                           # [OPTIONAL]


# ═══ SECRET STORAGE ══════════════════════════════════════ Set on: api, worker
# [REQUIRED] UAT, STAGING and PRODUCTION REFUSE TO BOOT with the env-var backend:
#   Error: SECRET_MANAGER_PROVIDER=env is not permitted in UAT.
# The default is `env`, so leaving this unset is the single most likely reason a freshly
# provisioned UAT starts and immediately dies. It is a deliberate fail-closed control
# (ADR-024): once an environment holds real provider credentials, they come from a managed
# store, not from a dashboard variable.
SECRET_MANAGER_PROVIDER=azure                 # azure | aws | gcp — NOT `env`
AZURE_KEY_VAULT_URL=https://REPLACE-ME.vault.azure.net/   # if azure (uses DefaultAzureCredential)
# AWS_SECRETS_REGION=ap-south-1               # if aws
# GCP_PROJECT_ID=REPLACE_ME                   # if gcp


# ═══ SIGNING / ENCRYPTION ════════════════════════════════ Set on: api, worker
QR_SIGNING_SECRET=REPLACE_ME_openssl_rand_base64_48    # [REQUIRED] [GENERATED]
# MANIFEST_SIGNING_SECRET=...                 # [OPTIONAL]


# ═══ PAYMENTS ════════════════════════════════════════════ Set on: api, worker
# UAT posture: real gateways, SANDBOX credentials. End-to-end flows run against the
# providers' test infrastructure — no money moves. Live keys are REFUSED at boot.
PAYMENT_PROVIDER_NAME=stripe                  # [REQUIRED] a real adapter — `mock` is not the UAT posture
PAYMENT_LIVE_ENABLED=false                    # [REQUIRED] must stay false
PAYMENT_ALLOW_LIVE_KEYS_LOWER_ENV=false       # [REQUIRED] must stay false

# ─── FOR AN INDIA PILOT REHEARSAL, SET THIS INSTEAD ───────────────────────────
#   PAYMENT_PROVIDER_NAME=razorpay
# and treat the three Razorpay values below as [REQUIRED] rather than optional.
#
# `stripe` above is the default UAT posture for the US market. It is a real adapter, so
# UAT boots and Stripe flows work — but an Indian cinema's checkout would have no INR
# provider, and cinema readiness reports PAYMENT_PROVIDER_NOT_INR_CAPABLE rather than
# pretending otherwise.
#
# Leaving `mock` here would be worse than either: UAT REFUSES the simulated gateway
# (isDummyAllowed is LOCAL/DEV/QA only), so readiness blocks with PAYMENT_MOCK_ONLY. That
# refusal is deliberate — a pilot rehearsal whose payment step is a stub has rehearsed
# nothing, because a mock confirms every booking it is asked to.
#
# See docs/india-pilot/RAZORPAY-SANDBOX.md for the full environment matrix.

# --- Stripe --- [TEST-ONLY] boot FAILS on an sk_live_ key in UAT
STRIPE_SECRET_KEY=sk_test_REPLACE_ME          # [REQUIRED]
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME        # [REQUIRED] UAT-specific endpoint secret
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME     # [OPTIONAL] public
STRIPE_SUCCESS_URL=https://uat.eticketsgo.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://uat.eticketsgo.com/checkout/cancel
STRIPE_CONNECT_RETURN_URL=https://organizer-uat.eticketsgo.com/organizer/payouts?onboarding=return
STRIPE_CONNECT_REFRESH_URL=https://organizer-uat.eticketsgo.com/organizer/payouts?onboarding=refresh

# --- Razorpay (INR routing) --- [TEST-ONLY] boot FAILS on an rzp_live_ key in UAT
# [REQUIRED] for an India pilot rehearsal; [OPTIONAL] only if INR flows are out of scope.
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME            # MUST differ from RAZORPAY_KEY_SECRET — boot refuses if equal
RAZORPAY_MODE=test                            # must agree with the key prefix
RAZORPAY_CALLBACK_URL=https://uat.eticketsgo.com/checkout/razorpay/callback
RAZORPAY_ROUTE_ENABLED=false                  # [REQUIRED] no organizer payouts from UAT
#
# Credentials alone are NOT enough for checkout to work. Provider selection is a database
# row, not an environment variable: one PaymentRoute with currency=INR → razorpay must
# exist in UAT, or readiness reports NO_INR_ROUTE and checkout has nothing to select.
# Bootstrap it with `npm run db:payment-routes -w @eticketsgo/api` (idempotent), or through
# the admin Payments screen.


# ═══ WEBHOOKS ════════════════════════════════════════════ Set on: api
PAYMENT_WEBHOOK_SECRET=REPLACE_ME_openssl_rand_base64_48   # [REQUIRED] [GENERATED]
# UAT webhook endpoints to register in the provider dashboards:
#   Stripe   https://api-uat.eticketsgo.com/api/payments/webhook/stripe
#   Razorpay https://api-uat.eticketsgo.com/api/payments/webhooks/razorpay   <- plural
# Register these as SEPARATE endpoints from QA/Production, each with its own signing
# secret — a shared secret would let a UAT replay authenticate against Production.


# ═══ EMAIL ═══════════════════════════════════════════════ Set on: api, worker
# UAT usually needs real delivery so testers receive tickets. Restrict the sender
# domain/subdomain to UAT and use a provider key scoped to it.
EMAIL_PROVIDER=log                            # [OPTIONAL] switch to sendgrid|ses when testers need real mail
# EMAIL_FROM=uat-noreply@eticketsgo.com       # required if a real provider is selected
# SENDGRID_API_KEY=REPLACE_ME                 # [TEST-ONLY] UAT-scoped key, never the prod key


# ═══ PUSH NOTIFICATIONS ══════════════════════════════════ Set on: api, worker
PUSH_PROVIDER=log                             # [OPTIONAL]
# FCM_* — a SEPARATE Firebase project from Production.
WEBPUSH_PROVIDER=log                          # [OPTIONAL]
SMS_PROVIDER=log                              # [OPTIONAL]
WHATSAPP_PROVIDER=log                         # [OPTIONAL]


# ═══ OBJECT STORAGE ══════════════════════════════════════ Set on: api
# The S3 driver is declared but NOT implemented; Railway's filesystem is ephemeral.
STORAGE_DRIVER=local                          # [OPTIONAL]


# ═══ MONITORING ══════════════════════════════════════════ Set on: api, worker
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>   # [OPTIONAL]
SENTRY_ENVIRONMENT=uat                        # [OPTIONAL] must match the environment
SENTRY_TRACES_SAMPLE_RATE=0                   # [OPTIONAL]
SLOW_QUERY_MS=500                             # [OPTIONAL]


# ═══ FEATURE FLAGS (P6 safety posture — do not weaken) ═══ Set on: api, worker
BOOKING_ORCHESTRATOR_MODE=shadow              # [REQUIRED]
BOOKING_REFUND_POLICY_MODE=MANUAL_ONLY        # [REQUIRED]
BOOKING_COMPENSATION_AUTO_REFUND_ENABLED=false   # [REQUIRED]
BOOKING_COMPENSATION_AUTO_VOID_ENABLED=false     # [REQUIRED]
BOOKING_COMPENSATION_EXECUTION_ENABLED=false     # [REQUIRED]
INVENTORY_LOCKS_ENABLED=false                 # [OPTIONAL]
DOMAIN_EVENTS_ENABLED=false                   # [OPTIONAL]
DOMAIN_EVENT_DELIVERY_MODE=in_process         # [OPTIONAL]


# ═══ URLS AND CORS ═══════════════════════════════════════
CORS_ORIGINS=https://uat.eticketsgo.com,https://organizer-uat.eticketsgo.com,https://admin-uat.eticketsgo.com   # [REQUIRED]
NEXT_PUBLIC_API_URL=https://api-uat.eticketsgo.com/api   # [REQUIRED] BUILD-TIME, on all three web services


# ═══ WORKER TUNABLES ═════════════════════════════════════ Set on: worker
# Defaults are fine for UAT; override only to reproduce a timing-sensitive defect.
# HOLD_EXPIRY_INTERVAL_MS=60000
# NOTIFICATION_SWEEP_INTERVAL_MS=30000
# WEBHOOK_SWEEP_INTERVAL_MS=15000
