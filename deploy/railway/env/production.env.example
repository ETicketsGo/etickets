# ─────────────────────────────────────────────────────────────────────────────
# ETicketsGo — Railway PRODUCTION variable template (project: ETicketsGo-Production)
#
# NOT a file you deploy. Every line is entered as a SERVICE VARIABLE in the Railway
# dashboard (or via `railway variables --set`). NEVER commit a filled-in copy, never
# paste a live key into a ticket, chat message, or CI log.
#
# Production is fail-closed by design. The API REFUSES TO BOOT if it finds a shipped
# placeholder secret, a secret under 24 characters, unset/localhost CORS, a sandbox
# payment key, the dummy gateway, or any money-automation flag switched on. Those
# guards are the reason a bad deploy stops at startup instead of at the first
# customer. Do not work around them.
#
# Legend: [REQUIRED] [OPTIONAL] [GENERATED] [REFERENCE] [PROD-ONLY]
# ─────────────────────────────────────────────────────────────────────────────


# ═══ APPLICATION / ENVIRONMENT IDENTITY ══════════════════ Set on: api, worker
APP_ENV=PRODUCTION                            # [REQUIRED] exactly PRODUCTION
NODE_ENV=production                           # [REQUIRED]
API_GLOBAL_PREFIX=api                         # [OPTIONAL]
TRUST_PROXY_HOPS=1                            # [OPTIONAL] Railway edge = 1 hop; raise only if you add another proxy
# ENABLE_SWAGGER — MUST stay UNSET. Setting it publishes the full API surface.

# PORT is injected by Railway. Do NOT set it.


# ═══ DATABASE ════════════════════════════════════════════ Set on: api, worker
DATABASE_URL=${{Postgres.DATABASE_URL}}       # [REQUIRED] [REFERENCE] Production Postgres ONLY
# This reference must resolve to the PostgreSQL plugin inside the
# ETicketsGo-Production project. A hand-pasted URL is how a production service ends
# up pointed at UAT — use the reference so it cannot happen.


# ═══ REDIS ═══════════════════════════════════════════════ Set on: api, worker
REDIS_URL=${{Redis.REDIS_URL}}                # [REQUIRED] [REFERENCE] Production Redis ONLY
REDIS_COMMAND_TIMEOUT_MS=1000                 # [OPTIONAL]
# Keyspace is namespaced etg:production:* from APP_ENV — defence in depth on top of
# the separate instance, so even a mis-pointed URL cannot cross-consume jobs.


# ═══ AUTHENTICATION ══════════════════════════════════════ Set on: api
# Generate fresh: openssl rand -base64 48. Never reuse a QA/UAT value; never reuse
# the access secret as the refresh secret. Rotation procedure is in the runbook.
JWT_ACCESS_SECRET=REPLACE_ME_openssl_rand_base64_48    # [REQUIRED] [GENERATED] min 24 chars
JWT_REFRESH_SECRET=REPLACE_ME_openssl_rand_base64_48   # [REQUIRED] [GENERATED] min 24 chars
JWT_ACCESS_TTL=900s                           # [OPTIONAL]
JWT_REFRESH_TTL=30d                           # [OPTIONAL]


# ═══ SECRET STORAGE ══════════════════════════════════════ Set on: api, worker
# [REQUIRED] PRODUCTION REFUSES TO BOOT with the env-var backend:
#   Error: SECRET_MANAGER_PROVIDER=env is not permitted in PRODUCTION.
# The default is `env`, so leaving this unset means the service starts and immediately dies.
# Deliberate and fail-closed (ADR-024): live credentials come from a managed store, never
# from a dashboard variable that anyone with project access can read.
SECRET_MANAGER_PROVIDER=azure                 # azure | aws | gcp — NOT `env`
AZURE_KEY_VAULT_URL=https://REPLACE-ME.vault.azure.net/   # if azure (DefaultAzureCredential)
# AWS_SECRETS_REGION=ap-south-1               # if aws
# GCP_PROJECT_ID=REPLACE_ME                   # if gcp


# ═══ SIGNING / ENCRYPTION ════════════════════════════════ Set on: api, worker
QR_SIGNING_SECRET=REPLACE_ME_openssl_rand_base64_48    # [REQUIRED] [GENERATED] min 24 chars
# Rotating this invalidates every issued ticket QR. Treat it as a scheduled,
# announced operation, not a routine rotation.
# MANIFEST_SIGNING_SECRET=...                 # [OPTIONAL] offline check-in manifests


# ═══ PAYMENTS ════════════════════════════════════════════ Set on: api, worker
# Production posture: LIVE credentials only. A sandbox key here means orders that
# never collect money, so the API refuses to boot on sk_test_ / rzp_test_ — with no
# override. The dummy gateway is likewise refused.
PAYMENT_PROVIDER_NAME=stripe                  # [REQUIRED] a real adapter; `mock` is refused
PAYMENT_ALLOW_LIVE_KEYS_LOWER_ENV=false       # [REQUIRED] irrelevant here but keep false

# Master switch for accepting real money. Ships OFF. Turn it on only after the
# go-live checklist passes and the merchant certification is current.
PAYMENT_LIVE_ENABLED=false                    # [REQUIRED] flip to true at go-live, deliberately

# --- Stripe --- [PROD-ONLY] live credentials
STRIPE_SECRET_KEY=sk_live_REPLACE_ME          # [REQUIRED] boot FAILS on sk_test_
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME        # [REQUIRED] production endpoint secret; MUST differ from PAYMENT_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_live_REPLACE_ME     # [OPTIONAL] public
STRIPE_API_VERSION=                           # [OPTIONAL] pin to your dashboard API version
STRIPE_SUCCESS_URL=https://eticketsgo.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://eticketsgo.com/checkout/cancel
STRIPE_CONNECT_RETURN_URL=https://organizer.eticketsgo.com/organizer/payouts?onboarding=return
STRIPE_CONNECT_REFRESH_URL=https://organizer.eticketsgo.com/organizer/payouts?onboarding=refresh
STRIPE_SETTLEMENT_RESERVE_BPS=0               # [OPTIONAL] organizer transfer reserve, basis points

# --- Razorpay (INR routing) --- [PROD-ONLY] live credentials
RAZORPAY_KEY_ID=rzp_live_REPLACE_ME           # [OPTIONAL] required if INR is sold; boot FAILS on rzp_test_
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME            # MUST differ from RAZORPAY_KEY_SECRET (enforced at boot)
RAZORPAY_MODE=live                            # must agree with the key prefix (enforced at boot)
RAZORPAY_CALLBACK_URL=https://eticketsgo.com/checkout/razorpay/callback
RAZORPAY_ROUTE_ENABLED=false                  # [REQUIRED] organizer payouts stay OFF until Route KYC is signed off
# RAZORPAY_ACCOUNT_NUMBER=REPLACE_ME          # required by some Route transfer flows


# ═══ WEBHOOKS ════════════════════════════════════════════ Set on: api
PAYMENT_WEBHOOK_SECRET=REPLACE_ME_openssl_rand_base64_48   # [REQUIRED] [GENERATED]
# Production webhook endpoints to register in the provider dashboards:
#   Stripe   https://api.eticketsgo.com/api/payments/webhook/stripe
#   Razorpay https://api.eticketsgo.com/api/payments/webhooks/razorpay
# Distinct endpoints with distinct signing secrets per environment. Exclude these
# paths from Cloudflare caching and from any Access policy (providers cannot log in).


# ═══ EMAIL ═══════════════════════════════════════════════ Set on: api, worker
# [REQUIRED] THE API REFUSES TO BOOT with EMAIL_PROVIDER=log in production or staging:
#   Error: Notifications cannot be delivered in this environment
# `log` writes to the service log and sends nothing. Left on, the platform boots clean,
# reports healthy, takes the money, and the customer never receives their ticket — while
# the log records a line that reads like success. Invisible to every health check; visible
# only to the person who paid. Hence fail-closed, exactly like a payment credential.
EMAIL_PROVIDER=ses                            # [REQUIRED] sendgrid | ses — `log` is refused
EMAIL_FROM=noreply@eticketsgo.com             # [REQUIRED] on a verified, SPF/DKIM-signed domain
# AWS SES: AWS_REGION + (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or the instance role)
AWS_REGION=REPLACE_ME                         # [REQUIRED if EMAIL_PROVIDER=ses]
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY   # [OPTIONAL] omit to use the default AWS chain
# SENDGRID_API_KEY=REPLACE_ME                 # [REQUIRED if EMAIL_PROVIDER=sendgrid]
#
# Escape hatch — for bringing an environment up to run migrations or a smoke check BEFORE
# the mail provider exists. Never set it while serving customers.
# ALLOW_UNDELIVERABLE_NOTIFICATIONS=true      # [OPTIONAL] disarms the guard above
#
# NOT enforceable from inside the process, and therefore YOUR checklist, not the app's:
#   - the sending domain is verified with SPF and DKIM
#   - if SES: the account is OUT OF THE SANDBOX. In the sandbox SES only delivers to
#     verified addresses, and the failure looks exactly like "the customer never got their
#     ticket". Request production access early; approval is not instant.
#   - a DMARC record exists, and the bounce/complaint destination is monitored


# ═══ PUSH NOTIFICATIONS ══════════════════════════════════ Set on: api, worker
PUSH_PROVIDER=log                             # [OPTIONAL] switch to fcm when mobile ships
# FCM_PROJECT_ID / FCM_CLIENT_EMAIL / FCM_PRIVATE_KEY — the PRODUCTION Firebase
# project, never shared with QA/UAT.
WEBPUSH_PROVIDER=log                          # [OPTIONAL] log | vapid
# VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY / VAPID_SUBJECT
SMS_PROVIDER=log                              # [OPTIONAL]
WHATSAPP_PROVIDER=log                         # [OPTIONAL]


# ═══ OBJECT STORAGE ══════════════════════════════════════ Set on: api
# The S3 driver is declared in config but NOT implemented in this codebase — there is
# no upload/object-storage code path today, so there is nothing to configure and
# nothing durable being written. Railway's filesystem is EPHEMERAL: it is wiped on
# every deploy. Do not introduce a feature that writes files to disk here without
# first implementing an object-storage driver.
STORAGE_DRIVER=local                          # [OPTIONAL]


# ═══ MONITORING ══════════════════════════════════════════ Set on: api, worker
SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>   # [REQUIRED at go-live]
SENTRY_ENVIRONMENT=production                 # [REQUIRED] separates the issue stream
# SENTRY_RELEASE is set by the deploy workflow to the git SHA — do not hardcode it.
SENTRY_TRACES_SAMPLE_RATE=0                   # [OPTIONAL] raise deliberately; it costs quota
SLOW_QUERY_MS=500                             # [OPTIONAL]
# Bearer credential for GET /api/metrics and the worker's :WORKER_PORT/metrics.
# The scrape publishes etg_gmv_minor_total, etg_bookings_confirmed_total and the payment
# success/failure counters, so it is not public. UNSET in a deployed environment means the
# route answers 404 — closed, never open. Generate per environment; do not reuse across
# them, and set the SAME value as the METRICS_TOKEN secret on the GitHub Environment or
# the post-deploy smoke check skips itself with a warning.
# METRICS_TOKEN=<generate: openssl rand -hex 32>   # [OPTIONAL] required to expose metrics


# ═══ TAX ═════════════════════════════════════════════════ Set on: api, worker
# Where the answer to "what tax is owed" comes from. Nothing in this codebase asserts a
# rate, a threshold or a jurisdiction rule; TaxRule rows default to inactive, so an
# unconfigured platform charges no tax and every total is what it was before tax existed.
#
#   manual   — the TaxRule table an owner configures. Right for ONE jurisdiction with a
#              stable rate that an advisor can state. That is the India pilot.
#   external — a tax service. Right for the US, where the rate depends on the buyer's
#              city and whether anything is owed at all depends on nexus thresholds.
TAX_PROVIDER=manual                           # [REQUIRED] manual | external
# TAX_EXTERNAL_VENDOR=stripe-tax              # [REQUIRED if external] label for the audit trail
# TAX_EXTERNAL_ENDPOINT=https://REPLACE_ME/quote   # [REQUIRED if external] your adapter's URL
# TAX_EXTERNAL_API_KEY=REPLACE_ME             # [REQUIRED if external] boot FAILS without it
# TAX_EXTERNAL_TIMEOUT_MS=4000                # [OPTIONAL] bounded: this call is in checkout
# TAX_EXTERNAL_FAIL_OPEN=false                # [OPTIONAL] see below — leave false unless decided
#
# Fail-closed by default: if the tax service is unreachable the sale is REFUSED, because
# charging no tax under-collects on every order for the duration of the outage and the
# platform, not the customer, owes the difference. TAX_EXTERNAL_FAIL_OPEN=true trades that
# for a working checkout with zero tax and a reconciliation job. Your call, not a default.


# ═══ PRICE DISPLAY ═══════════════════════════════════════ Set on: api
# What LISTINGS advertise. Several US states, and federal rules, now require the total
# including mandatory fees to be shown upfront — the number a buyer sees while DECIDING,
# not the breakdown after they have decided. Itemising correctly at checkout while
# advertising a bare ticket price on the browse page complies with nothing.
#
#   itemised — advertise the ticket face price; fees appear at checkout (current behaviour)
#   all_in   — advertise ticket + mandatory customer-borne fees
#
# Applies to every listing surface at once (browse, organizer page, showtimes,
# recommendation carousels) so two surfaces can never quote different prices for the same
# ticket. Tax is never included: it depends on the buyer's location, which is unknown while
# they browse. Confirm the requirement for YOUR markets before changing this.
PRICE_DISPLAY_MODE=itemised                   # [REQUIRED] itemised | all_in


# ═══ FEATURE FLAGS (P6 safety posture — production-enforced) ═ Set on: api, worker
# The API REFUSES TO BOOT in production with money automation enabled. These are not
# advisory defaults; they are the fail-closed contract agreed in P5.3B.
BOOKING_ORCHESTRATOR_MODE=shadow                 # [REQUIRED]
BOOKING_REFUND_POLICY_MODE=MANUAL_ONLY           # [REQUIRED]
BOOKING_COMPENSATION_AUTO_REFUND_ENABLED=false   # [REQUIRED] boot fails if true
BOOKING_COMPENSATION_AUTO_VOID_ENABLED=false     # [REQUIRED] boot fails if true
BOOKING_COMPENSATION_EXECUTION_ENABLED=false     # [REQUIRED]
BOOKING_PROVIDER_CONFIRMATION_ENABLED=false      # [REQUIRED] boot fails if true (no real adapter exists)
INVENTORY_SYNC_MOCK_PROVIDER_ENABLED=false       # [REQUIRED] boot fails if true
INVENTORY_LOCKS_ENABLED=false                    # [OPTIONAL]
DOMAIN_EVENTS_ENABLED=false                      # [OPTIONAL]
DOMAIN_EVENT_DELIVERY_MODE=in_process            # [OPTIONAL]


# ═══ URLS AND CORS ═══════════════════════════════════════
# Exact production origins only. No wildcard, no localhost, no QA/UAT hostnames —
# boot fails if CORS_ORIGINS is unset or contains localhost.
CORS_ORIGINS=https://eticketsgo.com,https://www.eticketsgo.com,https://organizer.eticketsgo.com,https://admin.eticketsgo.com   # [REQUIRED]

# BUILD-TIME on the three web services. Must be set before the first build.
NEXT_PUBLIC_API_URL=https://api.eticketsgo.com/api   # [REQUIRED]


# ═══ WORKER TUNABLES ═════════════════════════════════════ Set on: worker
# Defaults are production-appropriate. Change only with a measured reason.
# HOLD_EXPIRY_INTERVAL_MS=60000               # seat holds released this often
# NOTIFICATION_SWEEP_INTERVAL_MS=30000
# WEBHOOK_SWEEP_INTERVAL_MS=15000             # provider webhook retry sweep
# QUEUE_METRICS_INTERVAL_MS=15000
# RECONCILE_INTERVAL_MS=86400000              # daily finance reconciliation
