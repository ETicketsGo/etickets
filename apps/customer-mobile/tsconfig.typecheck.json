{
  // Typecheck-only config. react-native is hoisted to the monorepo root (required so the
  // Expo/Metro build tooling — react-native-css-interop, @react-native/jest-preset — can
  // resolve it), where it otherwise picks up the web apps' @types/react 18. This alias forces
  // tsc to resolve React's types from THIS app's @types/react 19 for the whole program,
  // including react-native's own .d.ts, so there is a single React 19 type surface.
  //
  // It lives in a SEPARATE config (not tsconfig.json) on purpose: Expo Metro and jest-expo
  // both read tsconfig.json's `paths` and would map the RUNTIME `react` import to the
  // types-only @types/react (breaking bundling/tests). Only `tsc` uses this file.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "react": ["./node_modules/@types/react"],
      // Same problem as react, different package. nativewind carries its own react-native as
      // an auto-installed peer of react-native-css-interop, while this app uses the
      // Expo-SDK-aligned 0.86.3. The nested version is not named here because it FLOATS —
      // css-interop's peer is `react-native: "*"`, so npm takes the newest release going
      // (0.86.2 under SDK 56, 0.87.1 after the SDK 57 upgrade). Without this alias,
      // nativewind's `className` augmentation lands on the nested copy's component types
      // while the app's components resolve to 0.86.3 — so every `className` prop fails to
      // typecheck while the styling works fine at runtime. Metro is pinned to the same single
      // copy (see metro.config.js).
      "react-native": ["./node_modules/react-native"],
      "react-native/*": ["./node_modules/react-native/*"]
    }
  }
}
