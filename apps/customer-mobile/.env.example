# ETicketsGo customer-mobile — public (client) env. NEVER put secrets here; the
# mobile client only ever talks to the existing NestJS API. Copy to `.env`.

# Base URL of the existing API (include the /api prefix).
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Public web host for universal/app links (deep linking); leave blank in dev.
EXPO_PUBLIC_WEB_HOST=

# Environment label (development | staging | production).
EXPO_PUBLIC_ENV=development

# Sentry DSN for the mobile app (public DSN is safe to ship). Optional.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only (used by the Sentry Expo plugin for source-map upload in CI).
# SENTRY_ORG=eticketsgo
# SENTRY_PROJECT=customer-mobile
