# ETicketsGo customer-mobile — PUBLIC client config only.
#
# Everything here ships inside the app bundle and is readable by anyone who unzips the
# APK/IPA. EXPO_PUBLIC_* is inlined at build time by design. Never put a secret here:
# no API keys, no payment credentials, no signing material. The app holds no payment
# provider key at all — the backend returns a clientActionUrl and the app follows it
# (see docs/PAYMENTS.md).
#
# Copy to `.env` for local development. `.env` is gitignored and must stay that way.

# ── API ────────────────────────────────────────────────────────────────────────────
# Base URL of the existing NestJS API, INCLUDING the /api prefix.
#
# Local device/emulator note: "localhost" on an Android emulator means the emulator
# itself, not your machine. Use 10.0.2.2 for the Android emulator, or your LAN IP for a
# physical device.
EXPO_PUBLIC_API_URL=http://localhost:4000/api

# Live QA (verified reachable 2026-08-04):
#   EXPO_PUBLIC_API_URL=https://api-qa-f580.up.railway.app/api
#
# The preferred custom domain is https://api-qa.eticketsgo.com/api, but as of
# 2026-08-04 it is NXDOMAIN — the CNAME is not yet at the registrar, so Railway cannot
# issue a certificate. Do not switch until DNS, TLS, /api/health and CORS all verify.
# See docs/ENVIRONMENTS.md for the switch checklist. Nothing in the code needs editing;
# this variable is the only thing that changes.

# ── Deep linking ───────────────────────────────────────────────────────────────────
# The web host used for universal links (iOS) and app links (Android).
#
# This is also a SECURITY control, not just configuration: an https deep link is only
# accepted if its host matches this value exactly. Left blank, https deep links are
# refused entirely rather than accepted from any host.
EXPO_PUBLIC_WEB_HOST=

# QA: qa.eticketsgo.com

# ── Environment ────────────────────────────────────────────────────────────────────
# development | staging | production
#
# `production` makes env.ts fail the build rather than start against a missing or
# localhost API URL — a prod build pointing at a dev API is a release defect, not a
# fallback worth having.
EXPO_PUBLIC_ENV=development

# ── Observability ──────────────────────────────────────────────────────────────────
# Sentry DSN. A DSN is a public write-only endpoint and is safe to ship. Optional.
EXPO_PUBLIC_SENTRY_DSN=

# ── Build-time only (CI), NOT shipped in the bundle ────────────────────────────────
# Used by the Sentry Expo plugin to upload source maps. Set as EAS secrets, never here.
# SENTRY_ORG=eticketsgo
# SENTRY_PROJECT=customer-mobile
# SENTRY_AUTH_TOKEN=<EAS secret — never commit>
