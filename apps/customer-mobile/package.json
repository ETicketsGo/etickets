{
  "name": "@eticketsgo/customer-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "prebuild": "expo prebuild",
    "doctor": "npx expo-doctor",
    "test:mobile": "jest",
    "lint:mobile": "eslint .",
    "typecheck:mobile": "tsc --noEmit -p tsconfig.typecheck.json",
    "smoke:web": "expo export --platform web --clear && node scripts/web-smoke.mjs"
  },
  "expo": {
    "install": {
      "//": "react/react-dom differ by design in this monorepo (web=18, mobile=19); they are JS-only and Metro bundles exactly one copy (resolver.extraNodeModules). typescript is pinned to the monorepo's 5.x toolchain shared with web/api.",
      "exclude": [
        "react",
        "react-dom",
        "typescript"
      ]
    }
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "//": "react-native-css-interop is nested under nativewind rather than hoisted, because it takes react-native as a * peer and this repo deliberately keeps react-native app-local (the web apps are React 18, mobile is React 19 — hoisting react-native would force React 19 on web and break it). jest-preset resolves css-interop from the app, cannot see the nested copy, and the whole suite fails to start. Mapping it here keeps the React 18/19 split intact. Metro handles the runtime equivalent via resolver.extraNodeModules.",
      "^@/(.*)$": "<rootDir>/src/$1",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-dom$": "<rootDir>/node_modules/react-dom",
      "^react-dom/(.*)$": "<rootDir>/node_modules/react-dom/$1",
      "^react-native-css-interop$": "<rootDir>/../../node_modules/nativewind/node_modules/react-native-css-interop",
      "^react-native-css-interop/(.*)$": "<rootDir>/../../node_modules/nativewind/node_modules/react-native-css-interop/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|expo-.*|@expo(nent)?/.*|@expo-google-fonts/.*|jest-expo|@sentry/react-native|nativewind|react-native-.*|@eticketsgo/.*)/)"
    ]
  },
  "dependencies": {
    "@eticketsgo/design-tokens": "*",
    "@eticketsgo/shared-types": "*",
    "@eticketsgo/validation": "*",
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "axios": "^1.7.9",
    "expo": "~56.0.19",
    "expo-brightness": "~56.0.5",
    "expo-clipboard": "~56.0.4",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-font": "~56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.11",
    "expo-linking": "~56.0.12",
    "expo-localization": "~56.0.6",
    "expo-notifications": "~56.0.23",
    "expo-router": "~56.2.18",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-is-edge-to-edge": "^1.3.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.8.3",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@react-native/jest-preset": "^0.85.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~56.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
