{
  "name": "@eticketsgo/customer-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "prebuild": "expo prebuild",
    "doctor": "npx expo-doctor",
    "test:mobile": "jest",
    "lint:mobile": "eslint .",
    "typecheck:mobile": "tsc --noEmit"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@sentry/react-native|nativewind|react-native-.*|@eticketsgo/.*)/)"
    ]
  },
  "dependencies": {
    "@eticketsgo/design-tokens": "*",
    "@eticketsgo/shared-types": "*",
    "@eticketsgo/validation": "*",
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^15.0.0",
    "@hookform/resolvers": "^3.10.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~8.19.0",
    "@tanstack/react-query": "^5.66.0",
    "axios": "^1.7.9",
    "expo": "~56.0.0",
    "expo-camera": "~56.0.7",
    "expo-constants": "~56.0.16",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.12",
    "expo-notifications": "~56.0.14",
    "expo-router": "~56.2.7",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "nativewind": "^4.2.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~3.0.2",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.0",
    "eslint": "^9.18.0",
    "eslint-config-expo": "~56.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.2"
  }
}
