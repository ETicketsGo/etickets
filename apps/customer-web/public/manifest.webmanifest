{
  "name": "ETicketsGo",
  "short_name": "ETicketsGo",
  "description": "Your tickets and passes, available even offline.",
  "start_url": "/account/tickets",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#FBF9F5",
  "theme_color": "#FBF9F5",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "My tickets",
      "short_name": "Tickets",
      "description": "Open your wallet",
      "url": "/account/tickets"
    },
    {
      "name": "Explore events",
      "short_name": "Explore",
      "description": "Discover what's on",
      "url": "/explore"
    },
    {
      "name": "My bookings",
      "short_name": "Bookings",
      "description": "View your orders",
      "url": "/account/bookings"
    }
  ]
}
