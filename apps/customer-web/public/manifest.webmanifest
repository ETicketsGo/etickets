{
  "name": "ETicketsGo — Experience Wallet",
  "short_name": "ETicketsGo",
  "description": "Your experiences, tickets and passes — available even offline.",
  "start_url": "/account/tickets",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b0f1a",
  "theme_color": "#1A5CEA",
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "My tickets",
      "short_name": "Tickets",
      "description": "Open your wallet",
      "url": "/account/tickets"
    },
    {
      "name": "Explore events",
      "short_name": "Explore",
      "description": "Discover what's on",
      "url": "/explore"
    },
    {
      "name": "My bookings",
      "short_name": "Bookings",
      "description": "View your orders",
      "url": "/account/bookings"
    }
  ]
}
