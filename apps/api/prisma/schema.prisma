// ETicketsGo data model — modular monolith, multi-tenant by organizationId.
// Money is stored as integer minor units (paise for INR) to avoid float error.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  CUSTOMER
  ORGANIZER_OWNER
  ORGANIZER_MANAGER
  CHECKIN_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum EventStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  PAUSED
  SOLD_OUT
  CANCELLED
  COMPLETED
  ARCHIVED
}

// The kind of experience an Event row represents. Existing rows default to EVENT,
// keeping all current behaviour identical. New types are additive. See ADR-009.
enum ExperienceType {
  EVENT
  MOVIE
  MUSEUM
  THEME_PARK
  ATTRACTION
  TOUR
}

enum SessionStatus {
  SCHEDULED
  CANCELLED
  COMPLETED
}

enum FeeMode {
  CUSTOMER_PAYS
  ORGANIZER_PAYS
  SHARED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum TicketStatus {
  ACTIVE
  TRANSFERRED
  CHECKED_IN
  CANCELLED
  REFUNDED
  VOID
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Deployment environments for runtime payment configuration (ADR-020). Each env
// independently enables providers, modes, routes and merchant accounts, so the
// same code base serves local through production without redeploys.
enum PaymentEnv {
  LOCAL
  DEV
  QA
  UAT
  STAGING
  PRODUCTION
}

// A provider config's operating mode. DUMMY is the simulated in-process provider
// (local/dev/QA only); TEST/LIVE are a real gateway's sandbox vs production keys.
enum PaymentProviderMode {
  DUMMY
  TEST
  LIVE
}

enum PaymentAttemptStatus {
  CREATED
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PAID
  FAILED
}

enum CouponType {
  PERCENT
  FIXED
}

enum NotificationType {
  BOOKING_CONFIRMED
  PAYMENT_FAILED
  EVENT_REMINDER
  BOOKING_CANCELLED
  REFUND_COMPLETED
  TICKET_CHECKED_IN
  ATTENDEE_INVITED
  ATTENDEE_ACCEPTED
  ATTENDEE_DECLINED
  TICKET_TRANSFERRED
  SHARE_CREATED
  SHARE_VIEWED
  SHARE_REVOKED
}

// Assignment lifecycle of a ticket to an attendee (identity layer, ADR-031).
// Orthogonal to TicketStatus (gate/refund lifecycle); reused by every experience.
enum AttendeeAssignmentStatus {
  UNASSIGNED
  ASSIGNED
  INVITED
  ACCEPTED
  DECLINED
}

enum TicketInviteKind {
  INVITE
  TRANSFER
}

enum TicketInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

// What a share link grants (ADR-032). VIEW = read-only (no live QR); GUEST =
// temporary access incl. live QR (checkable in); TRANSFER = ownership handover.
enum SharePermission {
  VIEW
  GUEST
  TRANSFER
}

// Generic shareable resource type. Only TICKET today; additive for the wallet.
enum ResourceType {
  TICKET
  MEMBERSHIP
  PARKING_PASS
  FOOD_VOUCHER
  VIP_PASS
}

enum CheckInResultType {
  SUCCESS
  DUPLICATE
  INVALID
  CANCELLED
  WRONG_SESSION
}

// ─────────────────────────── Identity ───────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  roles        Role[]     @default([CUSTOMER])
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens RefreshToken[]
  memberships   OrganizationMember[]
  bookings      Booking[]
  assignedTickets Ticket[]           @relation("TicketAttendee")
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  feedback                Feedback[]
  checkIns      CheckIn[]            @relation("CheckInActor")
  auditLogs     AuditLog[]
  reviews       Review[]

  @@index([status])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────── Tenancy ───────────────────────────

model Organization {
  id           String             @id @default(cuid())
  name         String
  slug         String             @unique
  status       OrganizationStatus @default(PENDING)
  contactEmail String?
  // Public organizer profile (v1.2 WS6). All optional; empty = not shown.
  description   String?
  logoUrl       String?
  coverImageUrl String?
  website       String?
  contactPhone  String?
  twitterUrl    String?
  instagramUrl  String?
  facebookUrl   String?
  // Verification badge is a manual/admin placeholder for now (no automated flow).
  verified     Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members OrganizationMember[]
  venues  Venue[]
  events  Event[]
  payouts Payout[]
  refunds Refund[]
  movies  Movie[]
  cinemas Cinema[]
  merchantOnboardings MerchantOnboarding[]

  @@index([status])
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─────────────────────────── Catalog ───────────────────────────

model Venue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  city           String
  country        String       @default("India")
  address        String?
  capacity       Int?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  areas   VenueArea[]
  events  Event[]
  cinemas Cinema[]

  @@index([organizationId])
  @@index([city])
}

model VenueArea {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

// ─────────────────────────── Movies & Cinemas ───────────────────────────
// Additive movie domain (ADR-011). A film is catalogued as a Movie; it becomes
// bookable as an Event with experienceType = MOVIE whose sessions (shows) play
// on a Screen. Seat maps and seat-level booking arrive in PR-3 (ADR-013).

enum MovieStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Movie {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  slug           String       @unique
  synopsis       String?
  runtimeMinutes Int
  certificate    String? // U, UA, A, S
  language       String
  genres         String[]
  releaseDate    DateTime?
  posterUrl      String?
  trailerUrl     String?
  cast           String[]
  director       String?
  status         MovieStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events Event[] // bookable movie listings screening this film

  @@index([organizationId])
  @@index([status])
  @@index([status, releaseDate])
}

model Cinema {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // A cinema is a specialised venue; reuse Venue for city/discovery when linked.
  venueId        String?
  venue          Venue?       @relation(fields: [venueId], references: [id])
  name           String
  brand          String?
  city           String
  address        String?
  latitude       Float?
  longitude      Float?
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  screens Screen[]

  @@index([organizationId])
  @@index([city])
}

model Screen {
  id         String   @id @default(cuid())
  cinemaId   String
  cinema     Cinema   @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  name       String
  screenType String   @default("2D") // 2D, 3D, IMAX, 4DX
  capacity   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sessions EventSession[]
  seatMap  SeatMap?

  @@index([cinemaId])
}

// ─────────────────── Seat maps & seat-level inventory (ADR-013) ───────────────────
// A screen has one SeatMap: categories (pricing tiers) + sections → rows → seats.
// Per-show seat availability lives in ShowSeat (one row per session×seat), the
// atomic lock target that makes seat booking oversell- and double-book-proof.

model SeatMap {
  id        String   @id @default(cuid())
  screenId  String   @unique
  screen    Screen   @relation(fields: [screenId], references: [id], onDelete: Cascade)
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories SeatCategory[]
  sections   SeatSection[]
  seats      Seat[]
}

model SeatCategory {
  id             String       @id @default(cuid())
  seatMapId      String
  seatMap        SeatMap      @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  name           String // Recliner, Premium, Normal
  colorHex       String?
  basePriceMinor Int
  sortOrder      Int          @default(0)

  seats       Seat[]
  ticketTypes TicketType[]

  @@index([seatMapId])
}

model SeatSection {
  id        String   @id @default(cuid())
  seatMapId String
  seatMap   SeatMap  @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)

  rows SeatRow[]

  @@index([seatMapId])
}

model SeatRow {
  id        String      @id @default(cuid())
  sectionId String
  section   SeatSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String // "A", "B", ...
  sortOrder Int         @default(0)

  seats Seat[]

  @@index([sectionId])
}

model Seat {
  id             String       @id @default(cuid())
  seatMapId      String
  seatMap        SeatMap      @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  rowId          String
  row            SeatRow      @relation(fields: [rowId], references: [id], onDelete: Cascade)
  seatCategoryId String
  seatCategory   SeatCategory @relation(fields: [seatCategoryId], references: [id])
  label          String // "12" (combined with row = "A12")
  colIndex       Int // position within the row for layout
  kind           String       @default("SEAT") // SEAT | GAP (aisle spacer)

  showSeats ShowSeat[]
  tickets   Ticket[]

  @@unique([rowId, label])
  @@index([seatMapId])
}

model ShowSeat {
  id             String       @id @default(cuid())
  eventSessionId String
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  seatId         String
  seat           Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)
  status         String       @default("AVAILABLE") // AVAILABLE | HELD | SOLD
  holdBookingId  String?
  holdBooking    Booking?     @relation(fields: [holdBookingId], references: [id])
  holdExpiresAt  DateTime?
  version        Int          @default(0)
  updatedAt      DateTime     @updatedAt

  @@unique([eventSessionId, seatId])
  @@index([eventSessionId, status])
  @@index([holdBookingId])
}

model Event {
  id               String      @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId          String
  venue            Venue       @relation(fields: [venueId], references: [id])
  experienceType   ExperienceType @default(EVENT)
  // Set only for MOVIE experiences: the film this bookable listing screens.
  movieId          String?
  movie            Movie?      @relation(fields: [movieId], references: [id])
  title            String
  slug             String      @unique
  category         String
  description      String?
  status           EventStatus @default(DRAFT)
  feeMode          FeeMode     @default(CUSTOMER_PAYS)
  refundPolicy     String?
  publishedAt      DateTime?
  reviewedByUserId String?
  reviewNote       String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  sessions EventSession[]
  bookings Booking[]
  reviews  Review[]

  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([experienceType])
  @@index([movieId])
  @@index([venueId])
  @@index([status, experienceType, publishedAt])
}

model Review {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
}

model EventSession {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Set only for movie shows: the screen this session plays on.
  screenId  String?
  screen    Screen?       @relation(fields: [screenId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    SessionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  ticketTypes TicketType[]
  bookings    Booking[]
  tickets     Ticket[]
  checkIns    CheckIn[]
  showSeats   ShowSeat[]

  @@index([eventId])
  @@index([startsAt])
  @@index([screenId])
}

model TicketType {
  id             String        @id @default(cuid())
  eventSessionId String
  eventSession   EventSession  @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  // For seat-based (movie) sessions: the seat category this price applies to.
  seatCategoryId String?
  seatCategory   SeatCategory? @relation(fields: [seatCategoryId], references: [id])
  name           String
  priceMinor     Int
  currency       String        @default("INR")
  quantityTotal  Int
  maxPerOrder    Int           @default(10)
  salesStartAt   DateTime?
  salesEndAt     DateTime?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  inventory    TicketInventory?
  bookingItems BookingItem[]
  tickets      Ticket[]

  @@index([eventSessionId])
  @@index([seatCategoryId])
}

// One row per ticket type; the concurrency-safe source of truth for stock.
model TicketInventory {
  id            String     @id @default(cuid())
  ticketTypeId  String     @unique
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  quantityTotal Int
  quantitySold  Int        @default(0)
  quantityHeld  Int        @default(0)
  version       Int        @default(0)
  updatedAt     DateTime   @updatedAt
}

// ─────────────────────────── Commerce ───────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  organizationId String?
  code           String     @unique
  type           CouponType
  value          Int
  maxRedemptions Int?
  redemptions    Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  status         String     @default("ACTIVE")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  bookings Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id])
  eventSessionId String
  eventSession   EventSession  @relation(fields: [eventSessionId], references: [id])
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])

  // Human-readable, globally-unique, immutable public reference assigned once at
  // confirmation, e.g. "ETG-IND-2026-000001" (brand-country-year-sequence). Null
  // for pending/legacy bookings; read paths fall back to a derived short code.
  // See BookingReferenceService + BookingReferenceCounter.
  reference  String?       @unique
  buyerName  String
  buyerEmail String
  status     BookingStatus @default(PENDING_PAYMENT)
  currency   String        @default("INR")
  feeMode    FeeMode       @default(CUSTOMER_PAYS)

  // Immutable money snapshot (minor units) so historical bookings never drift.
  subtotalMinor     Int
  bookingFeeMinor   Int @default(0)
  paymentFeeMinor   Int @default(0)
  discountMinor     Int @default(0)
  customerFeeMinor  Int @default(0)
  organizerFeeMinor Int @default(0)
  totalMinor        Int

  holdExpiresAt DateTime
  confirmedAt   DateTime?
  cancelledAt   DateTime?
  idempotencyKey String?  @unique

  heldSeats ShowSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   BookingItem[]
  tickets Ticket[]
  payment Payment?
  refunds Refund[]

  @@index([organizationId])
  @@index([eventId])
  @@index([status])
  @@index([holdExpiresAt])
  @@index([userId])
  @@index([eventSessionId, status])
  @@index([confirmedAt])
}

model BookingItem {
  id            String     @id @default(cuid())
  bookingId     String
  booking       Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketTypeId  String
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id])
  quantity      Int
  unitPriceMinor Int
  lineTotalMinor Int
  createdAt     DateTime   @default(now())

  @@index([bookingId])
}

model Ticket {
  id             String       @id @default(cuid())
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketTypeId   String
  ticketType     TicketType   @relation(fields: [ticketTypeId], references: [id])
  eventSessionId String
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id])
  organizationId String
  serial         String       @unique
  nonce          String
  qrVersion      Int          @default(1)
  status         TicketStatus @default(ACTIVE)
  // Set for seat-based (movie) tickets: the specific seat this ticket admits.
  seatId         String?
  seat           Seat?        @relation(fields: [seatId], references: [id])
  seatLabel      String?
  // ── Attendee identity (ADR-031). holderName/holderEmail are the attendee's
  //    name/email; the fields below enrich the profile. assignmentStatus is the
  //    identity lifecycle, orthogonal to `status` (gate/refund). attendeeUserId
  //    links a claimed ticket to the attendee's account. Additive + optional, so
  //    existing tickets keep working unchanged.
  holderName     String?
  holderEmail    String?
  assignmentStatus AttendeeAssignmentStatus @default(UNASSIGNED)
  attendeeUserId String?
  attendeeUser   User?        @relation("TicketAttendee", fields: [attendeeUserId], references: [id])
  attendeePhone       String?
  attendeeCountry     String?
  attendeeCompany     String?
  attendeeDesignation String?
  attendeeStudentId   String?
  attendeeMemberId    String?
  // Per-experience custom attendee fields (configurable), stored as { key: value }.
  attendeeCustomFields Json?
  issuedAt       DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  checkIns CheckIn[]
  invites  TicketInvite[]

  @@index([bookingId])
  @@index([eventSessionId])
  @@index([status])
  @@index([seatId])
  @@index([attendeeUserId])
}

// Invitation / transfer ledger for the attendee identity layer (ADR-031). Each
// row is one tokenised invite or transfer of a single ticket. Only a token HASH
// is stored (never the raw token); expiry + status prevent replay and stale
// links. Accepting rotates the ticket's QR nonce so any previously-shared QR
// stops working — there is only ever one valid QR per ticket.
model TicketInvite {
  id             String             @id @default(cuid())
  ticketId       String
  ticket         Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId String
  kind           TicketInviteKind   @default(INVITE)
  status         TicketInviteStatus @default(PENDING)
  // Secure Experience Sharing (ADR-032). permission drives what the link grants;
  // resourceType keeps the ledger generic for future wallet items; open counters
  // + limits enforce single/multi-use policy. Existing rows are TRANSFER/TICKET.
  permission     SharePermission    @default(TRANSFER)
  resourceType   ResourceType       @default(TICKET)
  maxOpens       Int?
  openCount      Int                @default(0)
  lastOpenedAt   DateTime?
  lastOpenedByUserId String?
  label          String?
  // Intended recipient (for delivery + display); the accepting account may differ.
  email          String?
  phone          String?
  tokenHash      String             @unique
  expiresAt      DateTime
  createdByUserId String?
  acceptedByUserId String?
  resolvedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([ticketId])
  @@index([status])
  @@index([organizationId])
}

model Payment {
  id         String        @id @default(cuid())
  bookingId  String        @unique
  booking    Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider   String        @default("mock")
  status     PaymentStatus @default(REQUIRES_PAYMENT)
  amountMinor Int
  currency   String        @default("INR")
  providerRef String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  attempts PaymentAttempt[]

  @@index([status])
}

model PaymentAttempt {
  id          String               @id @default(cuid())
  paymentId   String
  payment     Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status      PaymentAttemptStatus @default(CREATED)
  providerRef String?
  rawEvent    Json?
  createdAt   DateTime             @default(now())

  @@index([paymentId])
}

model Refund {
  id               String       @id @default(cuid())
  bookingId        String
  booking          Booking      @relation(fields: [bookingId], references: [id])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  amountMinor      Int
  status           RefundStatus @default(REQUESTED)
  reason           String
  ticketIds        String[]     @default([])
  requestedByUserId String?
  processedByUserId String?
  providerRef      String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([organizationId])
}

model Payout {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String?
  periodStart    DateTime?
  periodEnd      DateTime?
  grossMinor     Int          @default(0)
  bookingFeeMinor Int         @default(0)
  paymentFeeMinor Int         @default(0)
  refundMinor    Int          @default(0)
  netMinor       Int          @default(0)
  currency       String       @default("INR")
  status         PayoutStatus @default(PENDING)
  scheduledAt    DateTime?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ─────────── Offline gate check-in (ADR-035) — DISABLED by default ───────────
// A registered, org/event-scoped device that may validate tickets during a
// temporary connectivity loss against a server-signed manifest. Private keys
// never leave the device; only a reference is stored. Feature-flagged off until
// live conflict/device-loss/reconciliation drills pass — see OFFLINE-CHECKIN docs.

enum CheckInDeviceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

model CheckInDevice {
  id                  String              @id @default(cuid())
  organizationId      String
  eventId             String?
  eventSessionId      String?
  assignedStaffUserId String?
  name                String
  platform            String?
  // Reference to the device's public key (never a private key). Non-secret.
  publicKeyRef        String?
  status              CheckInDeviceStatus @default(PENDING)
  manifestVersion     Int                 @default(0)
  keyVersion          Int                 @default(1)
  expiresAt           DateTime?
  lastSeenAt          DateTime?
  approvedByUserId    String?
  createdByUserId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([organizationId])
  @@index([eventId])
  @@index([status])
}

// Audit header for a signed offline manifest issued for a session (the entries
// themselves are derived from tickets at build time and transmitted, not stored).
model CheckInManifest {
  id              String   @id @default(cuid())
  organizationId  String
  eventId         String
  eventSessionId  String
  version         Int
  validFrom       DateTime
  expiresAt       DateTime
  ticketCount     Int
  signature       String
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([eventSessionId, version])
  @@index([organizationId])
  @@index([eventSessionId])
}

// Recorded result of a live/browser offline certification drill (ADR-035). The
// activation gate reads the latest PASS per drill key within a freshness window as
// evidence — a drill never recorded, last FAILED, or stale keeps the gate closed
// (fail-closed). Evidence is structured + non-secret (ticket/device ids, outcomes);
// never PII or credentials.
enum OfflineDrillKey {
  TWO_DEVICE_CONFLICT
  DEVICE_LOSS
  RECONCILIATION
  NETWORK_LOSS
}

enum OfflineDrillOutcome {
  PASS
  FAIL
}

model OfflineDrillRun {
  id             String              @id @default(cuid())
  organizationId String
  eventId        String?
  eventSessionId String?
  drillKey       OfflineDrillKey
  outcome        OfflineDrillOutcome
  summary        String
  evidence       Json?
  ranByUserId    String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, drillKey, createdAt])
}

// A recorded administrator decision to activate offline gate check-in for a specific
// scope (ADR-035). Activation is never a bare flag flip: it is scoped to an
// org/event/session and an explicit set of approved devices, may only be recorded
// when every blocking readiness + drill check is green and current, carries an
// immutable evidence snapshot, and is fully audited + revocable. mustDowngrade and
// the activation policy remain authoritative at read time.
enum OfflineActivationState {
  ACTIVE
  REVOKED
  SUPERSEDED
}

model OfflineActivation {
  id               String                 @id @default(cuid())
  organizationId   String
  eventId          String
  eventSessionId   String
  deviceIds        String[]
  state            OfflineActivationState @default(ACTIVE)
  reason           String
  // Immutable snapshot of the ActivationInputs + derived checks at approval time.
  evidenceSnapshot Json
  approvedByUserId String
  approvedAt       DateTime               @default(now())
  revokedByUserId  String?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime               @default(now())

  @@index([organizationId, eventSessionId, state])
}

// A durable per-item record of an offline check-in reconciliation (ADR-035). Written
// by the reconcile engine for every queued item it processes, this is the ledger the
// Reconciliation Console reads. The outcome is IMMUTABLE — supervisor resolution is an
// audit-only annotation that never converts an outcome into an admission.
enum ReconcileReviewState {
  NOT_REQUIRED
  PENDING
  RESOLVED
}

enum ReconcileResolutionAction {
  ACKNOWLEDGED
  DISMISSED
}

model OfflineReconciliationRecord {
  id               String                     @id @default(cuid())
  organizationId   String
  eventId          String?
  eventSessionId   String
  deviceId         String
  ticketId         String
  operatorUserId   String?
  localScannedAt   DateTime
  reconciledAt     DateTime                   @default(now())
  outcome          String
  wasOverride      Boolean                    @default(false)
  reviewState      ReconcileReviewState       @default(NOT_REQUIRED)
  resolutionAction ReconcileResolutionAction?
  resolutionReason String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime                   @default(now())

  @@index([organizationId, eventSessionId])
  @@index([organizationId, reviewState])
  @@index([organizationId, outcome])
  @@index([deviceId])
  @@index([ticketId])
}

// A manager/admin acknowledgement of a Live Event Command Center alert (ADR-035).
// Alerts themselves are DERIVED deterministically per poll (deduped by key); only the
// acknowledgement is persisted. Acknowledging records who/when/why for audit — it
// never suppresses the underlying condition (the alert keeps deriving) or changes the
// gate. Unique per (session, alertKey) so re-acknowledging is idempotent.
model OfflineAlertAck {
  id                 String   @id @default(cuid())
  organizationId     String
  eventSessionId     String
  alertKey           String
  severityAtAck      String
  reason             String
  acknowledgedByUserId String
  acknowledgedAt     DateTime @default(now())

  @@unique([eventSessionId, alertKey])
  @@index([organizationId, eventSessionId])
}

// ─────────────────────────── Operations ───────────────────────────

model CheckIn {
  id             String            @id @default(cuid())
  ticketId       String
  ticket         Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventSessionId String
  eventSession   EventSession      @relation(fields: [eventSessionId], references: [id])
  result         CheckInResultType
  byUserId       String?
  by             User?             @relation("CheckInActor", fields: [byUserId], references: [id])
  deviceInfo     String?
  reversed       Boolean           @default(false)
  reversedByUserId String?
  reversedAt     DateTime?
  createdAt      DateTime          @default(now())

  @@index([ticketId])
  @@index([eventSessionId])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  type         NotificationType
  channel      String           @default("email") // email | sms | whatsapp | push | in_app
  locale       String           @default("en")
  toEmail      String?
  payload      Json
  // PENDING | SCHEDULED | SENT | FAILED | CANCELLED
  status       String           @default("PENDING")
  scheduledFor DateTime? // set for scheduled (deferred) sends
  attempts     Int              @default(0)
  lastError    String?
  sentAt       DateTime?
  cancelledAt  DateTime?
  // Read state for the in-app notification center (v1.2 WS8); null = unread.
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([type])
  @@index([status, scheduledFor])
  @@index([userId, channel, readAt])
}

// Per-user opt-out for a (type, channel). Absence of a row = enabled.
model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   String
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
}

// Customer-success submissions: contact/bug/feature/general + satisfaction surveys.
enum FeedbackKind {
  CONTACT
  BUG
  FEATURE
  GENERAL
  CSAT // customer satisfaction (rating)
  ORGANIZER_CSAT // organizer satisfaction (rating)
}

model Feedback {
  id        String       @id @default(cuid())
  kind      FeedbackKind
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  email     String?
  subject   String?
  message   String
  rating    Int? // 1..5 for CSAT/ORGANIZER_CSAT
  metadata  Json? // url, userAgent, appVersion, etc.
  status    String       @default("OPEN") // OPEN | TRIAGED | CLOSED
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actor          User?    @relation(fields: [actorUserId], references: [id])
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  correlationId  String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([action])
}

model IdempotencyRecord {
  id           String    @id @default(cuid())
  scope        String
  key          String
  requestHash  String?
  responseJson Json?
  status       String    @default("IN_PROGRESS")
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@unique([scope, key])
}

// Monotonic per-(country, year) sequence backing human-readable booking references
// (ADR-030). `scope` is "<ALPHA3>-<YEAR>" e.g. "IND-2026"; `value` is the last
// number issued. Incremented atomically inside the booking-confirm transaction so
// references are collision-free and gap-tolerant under concurrency and multi-region.
model BookingReferenceCounter {
  scope     String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Configurable, tiered platform fee rules. Admin-managed (section 13).
model FeeRule {
  id        String   @id @default(cuid())
  label     String
  minMinor  Int
  maxMinor  Int?
  feeMinor  Int
  currency  String   @default("INR")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

// ─────────────────── Runtime payment configuration (ADR-020) ───────────────────
// Env-scoped, admin-editable configuration for the multi-country / multi-provider
// payment platform. NO raw secrets are ever stored here — only non-secret public
// identifiers and secret *references* (a path/key resolved from the secret manager
// at runtime). Production fails closed when this configuration is invalid; see
// PaymentConfigValidator.

// One payment provider's configuration within one environment.
model PaymentProviderConfig {
  id       String              @id @default(cuid())
  env      PaymentEnv
  provider String // 'dummy' | 'stripe' | 'razorpay' | 'paypal' | 'square'
  enabled  Boolean             @default(false)
  mode     PaymentProviderMode @default(TEST)

  // Non-secret public identifier (publishable key / client id) — safe to store.
  publicKey String?
  // Secret REFERENCES only, e.g. 'payments/stripe/test/secret-key'. Never raw.
  secretKeyRef     String?
  webhookSecretRef String?
  // Optional endpoint override (e.g. a sandbox base URL). Not hardcoded in code.
  apiBaseUrl String?

  // Operational controls (failover / circuit-breaker / timeouts) consumed by the
  // orchestrator. Editable per env without a deploy.
  timeoutMs               Int @default(15000)
  maxRetries              Int @default(2)
  retryBackoffMs          Int @default(500)
  circuitFailureThreshold Int @default(5)
  circuitCooldownMs       Int @default(30000)
  // Lower value = higher priority when several providers can serve a route.
  priority                Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantAccounts MerchantAccount[]

  @@unique([env, provider])
  @@index([env, enabled])
}

// A merchant/settlement account for a provider config, optionally scoped to a
// country and/or currency (null = applies to anything the provider serves). Holds
// only non-secret identifiers and secret references.
model MerchantAccount {
  id       String                @id @default(cuid())
  configId String
  config   PaymentProviderConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  label    String
  country  String? // ISO-3166 alpha-2; null = any
  currency String? // ISO-4217; null = any
  // Provider-side account identifier (e.g. Stripe connected account id). Reference,
  // not a secret credential.
  merchantIdRef String?
  active        Boolean @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([configId, country, currency])
  @@index([configId, active])
}

// Merchant onboarding workflow (ADR-025). Tracks a merchant/provider application
// from DRAFT to ACTIVE, per environment. Stores only provider account IDs and
// secret REFERENCES / external-account references — never bank credentials.
enum MerchantOnboardingStatus {
  DRAFT
  PENDING_CONFIGURATION
  PENDING_VERIFICATION
  TESTING
  READY_FOR_LIVE
  ACTIVE
  SUSPENDED
  REJECTED
}

model MerchantOnboarding {
  id             String                   @id @default(cuid())
  env            PaymentEnv
  organizationId String?
  organization   Organization?            @relation(fields: [organizationId], references: [id])
  // Business identity.
  country           String // ISO-3166 alpha-2
  legalBusinessName String
  displayName       String
  merchantType      String   @default("STANDARD") // STANDARD | MARKETPLACE | INDIVIDUAL
  settlementCurrency String  // ISO-4217
  // Provider binding.
  provider          String // stripe | razorpay | paypal | square
  mode              PaymentProviderMode @default(TEST)
  // Provider-side account identifier + secret REFERENCES (never raw secrets).
  accountIdentifier String?
  secretKeyRef      String?
  webhookSecretRef  String?
  publicKey         String?
  // Settlement + payout (references only; never bank credentials).
  settlementSchedule    String  @default("T_PLUS_2") // e.g. T_PLUS_2, WEEKLY
  payoutDestinationRef  String?
  // Verification + webhook posture.
  webhookEndpointStatus String  @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED | VERIFIED
  verificationStatus    String  @default("UNVERIFIED") // UNVERIFIED | IN_REVIEW | VERIFIED | FAILED
  // Terms + lifecycle.
  termsAcceptedAt DateTime?
  termsAcceptedBy String?
  status          MerchantOnboardingStatus @default(DRAFT)
  activatedAt     DateTime?
  suspendedAt     DateTime?
  rejectedReason  String?
  // Linked runtime merchant account once activated.
  merchantAccountId String?
  createdByUserId   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([env, status])
  @@index([organizationId])
  @@index([provider])
}

// Finance reconciliation discrepancy queue (ADR-029). Detected differences between
// our records and provider truth, triaged by finance ops. Financial records are
// NEVER auto-corrected — resolution is a human, audited action.
enum DiscrepancyType {
  PAYMENT_MISSING_INTERNALLY
  PAYMENT_MISSING_AT_PROVIDER
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  DUPLICATE_CAPTURE
  REFUND_MISMATCH
  CHARGEBACK
  SETTLEMENT_MISMATCH
  GATEWAY_FEE_MISMATCH
  ORGANIZER_PAYABLE_MISMATCH
}

enum DiscrepancyStatus {
  OPEN
  ASSIGNED
  RESOLVED
  IGNORED
}

model ReconciliationDiscrepancy {
  id               String            @id @default(cuid())
  env              PaymentEnv
  type             DiscrepancyType
  provider         String
  // The business/transaction key this discrepancy is about (bookingId / providerRef).
  entityRef        String
  amountMinor      Int?
  currency         String?
  detail           String?
  status           DiscrepancyStatus @default(OPEN)
  assignedToUserId String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([env, type])
  @@index([entityRef])
}

// Sandbox certification of a merchant/provider combination (ADR-027). Records the
// result of the automated end-to-end certification run (health → payment → webhook
// → confirm → ticket → partial refund → refund webhook → reconcile → settlement).
enum CertificationResult {
  PASS
  PARTIAL
  FAIL
}

model MerchantCertification {
  id                   String              @id @default(cuid())
  merchantOnboardingId String?
  env                  PaymentEnv
  provider             String
  result               CertificationResult
  // Steps: [{ step, label, status: PASS|FAIL|SKIP, detail, ref }] (refs are tx ids,
  // never secrets).
  steps                Json
  passedCount          Int                 @default(0)
  failedCount          Int                 @default(0)
  skippedCount         Int                 @default(0)
  operator             String?
  createdAt            DateTime            @default(now())

  @@index([merchantOnboardingId])
  @@index([env, provider])
}

// Controlled environment promotion of a provider configuration (ADR-026). A
// promotion is validated, then approved (two-person for PRODUCTION), then applied —
// never copied blindly. The report + approvals are retained for audit.
enum PromotionStatus {
  PENDING_APPROVAL
  APPROVED
  APPLIED
  REJECTED
}

model PromotionRequest {
  id                String          @id @default(cuid())
  provider          String
  fromEnv           PaymentEnv
  toEnv             PaymentEnv
  status            PromotionStatus @default(PENDING_APPROVAL)
  requiredApprovals Int             @default(1)
  // Validation report snapshot at request time: { ok, checks: [...] }.
  report            Json
  // Approvals list: [{ userId, at, note }] — distinct users; 2 required for prod.
  approvals         Json            @default("[]")
  requestedByUserId String?
  rejectedReason    String?
  appliedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([toEnv, status])
  @@index([provider])
}

// Editable routing policy. For an environment a (country, currency, method) tuple
// selects a primary provider and an optional failover provider. '*' is a wildcard;
// the most specific active row wins, ties broken by priority (lower first).
model PaymentRoute {
  id               String     @id @default(cuid())
  env              PaymentEnv
  country          String     @default("*") // ISO-3166 alpha-2 or '*'
  currency         String     @default("*") // ISO-4217 or '*'
  method           String     @default("*") // PaymentMethod or '*'
  provider         String // primary provider name
  failoverProvider String? // optional secondary provider
  priority         Int        @default(100)
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([env, country, currency, method])
  @@index([env, active])
}
