// ETicketsGo data model — modular monolith, multi-tenant by organizationId.
// Money is stored as integer minor units (paise for INR) to avoid float error.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum Role {
  CUSTOMER
  ORGANIZER_OWNER
  ORGANIZER_MANAGER
  CHECKIN_STAFF
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  /// Self-service account deletion (GDPR / app-store requirement). The row is kept
  /// because bookings, tickets, settlements and audit entries reference it and are
  /// retained for tax and dispute purposes; the personal data on it is anonymised.
  /// A DELETED user can never authenticate again.
  DELETED
}

enum OrganizationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum MemberStatus {
  INVITED
  ACTIVE
  REMOVED
}

enum EventStatus {
  DRAFT
  UNDER_REVIEW
  PUBLISHED
  PAUSED
  SOLD_OUT
  CANCELLED
  COMPLETED
  ARCHIVED
}

// The kind of experience an Event row represents. Existing rows default to EVENT,
// keeping all current behaviour identical. New types are additive. See ADR-009.
enum ExperienceType {
  EVENT
  MOVIE
  MUSEUM
  THEME_PARK
  ATTRACTION
  TOUR
}

enum ScreenStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

/// Lifecycle of a seat layout version.
///
/// Only DRAFT is editable. Publishing is the point of no return, and it is deliberately
/// one-way: once a version can be attached to a show it must never change underneath one.
/// How a seat map is laid out, and therefore how it is drawn and read.
///
/// GRID is every layout that existed before venue maps: rows of seats facing a screen, drawn
/// as a grid, small enough to send whole. It stays the default so no existing cinema changes
/// behaviour by having this column added.
///
/// SECTIONED is the arena/theatre/stadium shape. The audience is divided into blocks arranged
/// around a focal point, and those blocks carry geometry so they can be drawn as a map rather
/// than as a list. The practical difference is not cosmetic: a sectioned venue can hold twenty
/// thousand seats, which is far too many to send to a phone at once, so it is read as an
/// overview first and one section at a time after that.
enum VenueLayoutKind {
  GRID
  SECTIONED
}

/// What the audience is facing. Drives where the focal shape is drawn and how sections curve.
enum FocalPointKind {
  /// A cinema screen across one end.
  SCREEN
  /// A proscenium stage at one end — a theatre, a concert hall, an amphitheatre.
  STAGE_END
  /// A stage projecting into the audience, seated on three sides.
  STAGE_THRUST
  /// In the round: the audience surrounds the performance.
  STAGE_CENTRE
  /// A pitch, court or arena floor with stands on all sides.
  FIELD
}

enum SeatLayoutStatus {
  /// Editable, invisible to scheduling. A layout being worked on.
  DRAFT
  /// Immutable and assignable to shows.
  PUBLISHED
  /// Immutable and NOT assignable to new shows. Existing shows keep working — they hold
  /// their own seat rows — so archiving is a planning decision, never a data deletion.
  ARCHIVED
}

/// Why an operator made a seat unavailable for one specific show.
///
/// Kept separate from `ShowSeat.status` on purpose. Status answers "can this be sold"
/// (booking only ever takes AVAILABLE); the kind answers "why not", which is what an
/// operator, a report and an auditor each need and none of them can get from a status flag.
enum SeatOverrideKind {
  /// Generic operator block with a reason.
  MANUAL_BLOCK
  /// Physically unusable: broken recliner, obstructed view, spillage. May auto-expire.
  MAINTENANCE
  /// Held back by the house — comps, press, sponsors, management.
  HOUSE
  /// Reserved for a named VIP or guest.
  VIP
  /// Held beside an accessible seat so a companion can sit together.
  COMPANION
  /// Safety: gangway keep-clear, evacuation route, incident. Highest severity.
  EMERGENCY
}

enum SessionStatus {
  SCHEDULED
  PAUSED
  CANCELLED
  COMPLETED
}

enum FeeMode {
  CUSTOMER_PAYS
  ORGANIZER_PAYS
  SHARED
}

/// How a booking is paid for.
///
/// ONLINE means money moves through a payment provider and the platform holds it until
/// settlement. CASH means it does not: the customer pays a person at the venue, and the
/// platform never touches the money at any point.
///
/// That distinction is not a preference — it changes what the product may claim. A cash
/// booking must never appear in a settlement as money the platform owes the organizer,
/// because there is no bank statement it could ever be reconciled against.
enum BookingPaymentMethod {
  ONLINE
  CASH
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
  EXPIRED
  DISPUTED
}

enum TicketStatus {
  ACTIVE
  TRANSFERRED
  CHECKED_IN
  CANCELLED
  REFUNDED
  VOID
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  // Authorized but NOT captured (auth/capture providers). Voidable in P5.3B Phase 5.
  AUTHORIZED
  SUCCEEDED
  FAILED
  // Authorization cancelled/voided before capture (no funds moved; never a refund).
  VOIDED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Deployment environments for runtime payment configuration (ADR-020). Each env
// independently enables providers, modes, routes and merchant accounts, so the
// same code base serves local through production without redeploys.
enum PaymentEnv {
  LOCAL
  DEV
  QA
  UAT
  STAGING
  PRODUCTION
}

// A provider config's operating mode. DUMMY is the simulated in-process provider
// (local/dev/QA only); TEST/LIVE are a real gateway's sandbox vs production keys.
enum PaymentProviderMode {
  DUMMY
  TEST
  LIVE
}

enum PaymentAttemptStatus {
  CREATED
  SUCCEEDED
  FAILED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutStatus {
  PENDING
  SCHEDULED
  PAID
  FAILED
}

// ─────────── Stripe Connect marketplace (US) ───────────

// An organizer's connected-account onboarding state, synchronised from Stripe's
// account.updated webhook (charges_enabled / payouts_enabled / requirements).
enum ConnectOnboardingStatus {
  NOT_STARTED // no connected account created yet
  ONBOARDING // account created, hosted onboarding not finished
  PENDING_VERIFICATION // details submitted, Stripe still verifying
  ENABLED // charges + payouts enabled
  RESTRICTED // enabled but has currently-due requirements / partial capability
  DISABLED // disabled_reason set by Stripe
  REJECTED // rejected by Stripe or platform
}

// Explicit settlement lifecycle. Organizer funds are HELD until the event completes
// and are only moved by an authorised release (Separate Charges & Transfers).
enum SettlementStatus {
  PENDING // created from payments, event not yet complete
  HELD // event window active / conditions not yet met
  ELIGIBLE // event complete + conditions pass, awaiting approval
  APPROVED // finance-approved, ready to release
  TRANSFER_PROCESSING // transfer submitted to Stripe
  TRANSFERRED // funds moved to the connected account
  PARTIALLY_REFUNDED // some proceeds refunded/reversed
  BLOCKED // blocked by ops (dispute, fraud, review)
  FAILED // transfer failed
  REVERSED // transfer reversed (e.g. post-transfer refund/dispute loss)
}

// Provider-level webhook processing state (idempotency + dead-lettering).
enum WebhookProcessingStatus {
  RECEIVED // persisted, not yet processed
  PROCESSING // handler running
  PROCESSED // handled successfully
  FAILED // handler errored, will retry
  DEAD_LETTER // exceeded retries; flagged for ops review
  IGNORED // event type we deliberately do not act on
}

// Chargeback/dispute lifecycle mirrored from Stripe (platform is merchant of record).
enum DisputeStatus {
  NEEDS_RESPONSE
  UNDER_REVIEW
  WON
  LOST
  WARNING_CLOSED
  CLOSED
}

enum CouponType {
  PERCENT
  FIXED
}

// Experience Commerce (v1.3). Configurable non-ticket products sold alongside
// tickets. DONATION and DIGITAL are unlimited-stock by default; the rest track
// inventory like ticket types.
enum AddOnType {
  MERCHANDISE
  PARKING
  FOOD_BEVERAGE
  VIP_UPGRADE
  MEET_GREET
  DONATION
  DIGITAL
}

// Marketing category for a bundle; purely descriptive (pricing lives on the rule).
enum BundleType {
  VIP
  FAMILY
  COMBO
  EARLY_BIRD
}

// How a bundle is priced: a fixed all-in price, or a percentage off the sum of
// its components' list prices.
enum BundlePricingKind {
  FIXED
  PERCENT_DISCOUNT
}

// Kind of a booking line: a ticket, a standalone add-on, or a bundle component.
enum BookingItemKind {
  TICKET
  ADDON
  BUNDLE
}

enum NotificationType {
  BOOKING_CONFIRMED
  PAYMENT_FAILED
  EVENT_REMINDER
  BOOKING_CANCELLED
  REFUND_COMPLETED
  TICKET_CHECKED_IN
  ATTENDEE_INVITED
  ATTENDEE_ACCEPTED
  ATTENDEE_DECLINED
  TICKET_TRANSFERRED
  SHARE_CREATED
  SHARE_VIEWED
  SHARE_REVOKED
  // Marketplace / Stripe ops (admin + organizer directed).
  PAYOUT_ACCOUNT_UPDATED
  SETTLEMENT_RELEASED
  PAYMENT_DISPUTE_OPENED
  PAYMENT_DISPUTE_CLOSED
  TRANSFER_FAILED
  // Onboarding + approval lifecycle. The first ADMIN-directed notifications: until these
  // existed, an organization could register and an event could be submitted for review with
  // nothing telling a human to look at it.
  ORGANIZATION_REGISTERED
  ORGANIZATION_APPROVED
  ORGANIZATION_REJECTED
  EVENT_SUBMITTED
  EVENT_APPROVED
  EVENT_REJECTED

  // Account security, addressed to the account holder about their own credentials.
  PASSWORD_RESET_REQUESTED
  PASSWORD_CHANGED
}

// Assignment lifecycle of a ticket to an attendee (identity layer, ADR-031).
// Orthogonal to TicketStatus (gate/refund lifecycle); reused by every experience.
enum AttendeeAssignmentStatus {
  UNASSIGNED
  ASSIGNED
  INVITED
  ACCEPTED
  DECLINED
}

enum TicketInviteKind {
  INVITE
  TRANSFER
}

enum TicketInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
  EXPIRED
}

// What a share link grants (ADR-032). VIEW = read-only (no live QR); GUEST =
// temporary access incl. live QR (checkable in); TRANSFER = ownership handover.
enum SharePermission {
  VIEW
  GUEST
  TRANSFER
}

// Generic shareable resource type. Only TICKET today; additive for the wallet.
enum ResourceType {
  TICKET
  MEMBERSHIP
  PARKING_PASS
  FOOD_VOUCHER
  VIP_PASS
}

enum CheckInResultType {
  SUCCESS
  DUPLICATE
  INVALID
  CANCELLED
  WRONG_SESSION
}

// ─────────────────────────── Identity ───────────────────────────

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  roles        Role[]     @default([CUSTOMER])
  status       UserStatus @default(ACTIVE)

  /// The language this person is written to in — email, receipts, tickets.
  ///
  /// Nullable on purpose, and the null is meaningful: it means "never chose", which is
  /// different from "chose English". A null falls back to the request's Accept-Language at
  /// the moment of sending, so somebody who has only ever browsed in French gets French
  /// email without having found a setting. Once they pick one, this is set and nothing
  /// overrides it — a preference that a browser header can silently undo is not a preference.
  ///
  /// An IETF tag ("en", "fr-CA"), not an enum: adding a locale must not need a migration,
  /// and an unrecognised value falls back rather than failing.
  locale       String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens           RefreshToken[]
  invitationsSent         AccountInvitation[]      @relation("InvitationsSent")
  invitationReceived      AccountInvitation?       @relation("InvitationsReceived")
  passwordResetTokens     PasswordResetToken[]
  cashCollected           Booking[]                @relation("CashCollected")
  memberships             OrganizationMember[]
  bookings                Booking[]
  assignedTickets         Ticket[]                 @relation("TicketAttendee")
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  devices                 UserDevice[]
  feedback                Feedback[]
  checkIns                CheckIn[]                @relation("CheckInActor")
  auditLogs               AuditLog[]
  seatOverrides           ShowSeat[]               @relation("SeatOverrideActor")
  reviews                 Review[]
  marketingConsents       MarketingConsent[]
  adminGrants             AdminGrant[]             @relation("AdminGrantHolder")
  adminGrantsIssued       AdminGrant[]             @relation("AdminGrantIssuer")

  @@index([status])
}

// AI usage/cost/latency telemetry (v2.0 WS1/WS9). One row per gateway call —
// including disabled/fallback/error outcomes — so the ops console can report request
// volume, fallback rate, latency, cost estimate and safety events. Never stores the
// prompt text or any customer payload; only the feature/prompt key + counters.
model AiUsage {
  id             String   @id @default(cuid())
  feature        String
  promptKey      String
  promptVersion  String
  provider       String
  // success | fallback | error | disabled
  status         String
  latencyMs      Int      @default(0)
  tokensIn       Int      @default(0)
  tokensOut      Int      @default(0)
  costMinor      Int      @default(0)
  // Count of PII redactions performed on the input (a safety signal; 0 = clean).
  redactions     Int      @default(0)
  organizationId String?
  actorUserId    String?
  correlationId  String?
  createdAt      DateTime @default(now())

  @@index([feature])
  @@index([status])
  @@index([createdAt])
}

// A browser Web Push subscription (v1.4). Stores only the standard public
// subscription material (endpoint + p256dh/auth keys) — no secrets. Delivery goes
// through the pluggable WebPush dispatcher (default: log placeholder; a VAPID
// transport drops in without schema change). One row per browser/endpoint.
/// A mobile device registered for push.
///
/// Separate from PushSubscription, which is Web Push and carries an endpoint URL plus
/// p256dh/auth keys. A native token is a single opaque string with different lifecycle
/// rules; overloading one model would leave half the columns null on every row and put
/// two unrelated expiry behaviours in one table.
///
/// Provider-neutral by design: the provider column records who issued the token, so an
/// APNs or FCM token can be stored here later without a migration. No provider
/// credentials live in this repo — see apps/customer-mobile/docs/NOTIFICATIONS.md.
model UserDevice {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The push token. UNIQUE: one physical device must never appear twice, and a token
  /// that moves to another account is reassigned rather than duplicated.
  token String @unique

  /// Issuer of the token: expo | fcm | apns.
  provider   String  @default("expo")
  platform   String
  appVersion String?
  locale     String?
  timezone   String?

  /// OS permission state the client last observed: granted | denied | undetermined.
  permissionStatus String @default("undetermined")

  /// Set when the provider reports the token as invalid. Kept rather than deleted so a
  /// repeat failure is not mistaken for a brand-new device at the next registration.
  disabled Boolean @default(false)

  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, disabled])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A pending invitation to claim an account, and optionally to join a team with it.
///
/// -- WHY THIS IS ABOUT A USER, NOT A MEMBERSHIP -------------------------------------
/// It began as an organization-team invitation, because that is where the defect was
/// found: inviting somebody created a member at status INVITED, nothing ever moved a
/// member to ACTIVE, and an invitee with no account got one with a random password nobody
/// could know — which then made self-registration fail and bricked the address.
///
/// The BACK-OFFICE staff screen had the same hole for the same reason, and had written it
/// down as a deliberate limitation: it would only search accounts that already existed,
/// because "minting credentials here would mean this screen handing out passwords the
/// account holder never picked". That reasoning was right, and this row is what makes it
/// obsolete — the invitee sets their own password and no administrator ever sees it.
///
/// So the invitation is about the USER: proving the address holder wants the account and
/// choosing their password. Joining a team is a consequence, carried in the optional
/// `organizationMemberId`. Modelling it the other way would have meant a second, parallel
/// invitation system for admins, and this codebase has already paid once for a rule that
/// existed in two places.
model AccountInvitation {
  id     String @id @default(cuid())
  /// One live invitation per account. A resend replaces it rather than adding a second key.
  userId String @unique
  user   User   @relation("InvitationsReceived", fields: [userId], references: [id], onDelete: Cascade)

  /// Set when accepting should also activate a team membership. Null for back-office staff,
  /// whose capabilities are granted on the account itself.
  organizationMemberId String?             @unique
  organizationMember   OrganizationMember? @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, never the token itself — same reasoning as RefreshToken.
  /// A leaked database must not hand the reader somebody else's access.
  tokenHash String @unique

  expiresAt  DateTime
  acceptedAt DateTime?

  /// Who sent it, so "who let this person in" has an answer during an investigation.
  invitedByUserId String
  invitedBy       User   @relation("InvitationsSent", fields: [invitedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// A pending password reset.
///
/// -- WHY THIS IS NOT AN AccountInvitation ------------------------------------------
/// They look alike — a hashed single-use token with an expiry — and sharing them would be
/// wrong. An invitation is issued BY somebody with authority, TO an address they chose,
/// and the link is handed back to them to send. A reset is requested by an anonymous
/// caller about an address they merely typed, so the link may only ever leave by email,
/// and it must be impossible for the requester to learn anything from the response.
///
/// Merging the two would mean one code path where "return the link to the caller" is
/// sometimes correct and sometimes an account-takeover primitive. That is not a
/// distinction to leave to a boolean.
///
/// The expiry is also deliberately much shorter. An invitation waits for somebody to get
/// round to joining; a reset is acted on within minutes, and a link that lingers in a
/// mailbox for a week is a standing key to the account.
model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// SHA-256 of the token, never the token itself — same reasoning as RefreshToken.
  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  /// Recorded for the security trail: a burst of resets from one address is worth seeing.
  requestedIp String?

  createdAt DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String    @unique
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?
  userAgent         String?
  ip                String?
  createdAt         DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────── Tenancy ───────────────────────────

model Organization {
  id            String             @id @default(cuid())
  name          String
  slug          String             @unique
  status        OrganizationStatus @default(PENDING)

  /// This organizer's events go live without a human reviewing them.
  ///
  /// Default OFF, and that default is the feature. Review exists because a new organizer can
  /// publish anything — a fraudulent listing, a venue they do not have, a price that is a
  /// typo — and by the time it is noticed somebody has paid for a ticket. What review costs
  /// is a delay on every event from organizers who have earned trust twenty times over, and
  /// that is what this removes.
  ///
  /// Only a platform admin can set it. An organizer marking themselves trusted is not trust,
  /// it is a checkbox — and the API refuses to turn it on for an organization that has never
  /// had an event approved the ordinary way, so "trusted" always means an actual history.
  autoApproveEvents Boolean @default(false)

  contactEmail  String?
  // Public organizer profile (v1.2 WS6). All optional; empty = not shown.
  description   String?
  logoUrl       String?
  coverImageUrl String?
  website       String?
  contactPhone  String?
  twitterUrl    String?
  instagramUrl  String?
  facebookUrl   String?
  /// ── Legal + tax identity ──────────────────────────────────────────────────
  /// Everything an invoice must name, and everything a payout has to be reported
  /// against. All optional: an organization can exist and sell nothing while these are
  /// blank, and a pilot in a market with no tax registration should not be forced to
  /// invent one. Readiness decides when they become required, not the column.

  /// The registered legal entity, when it differs from the trading name customers see.
  /// An invoice names this one.
  legalName             String?
  /// Tax registration: GSTIN in India, sales-tax permit or EIN in the US, GST/HST number
  /// in Canada. Deliberately ONE free-text field plus a kind, rather than a column per
  /// country — the format is a jurisdiction's business and hardcoding a regex here would
  /// mean shipping code every time a market is added.
  taxRegistrationKind   String?
  taxRegistrationNumber String?

  /// Registered address, structured because an invoice needs the parts separately.
  registeredAddressLine1 String?
  registeredAddressLine2 String?
  registeredCity         String?
  /// State / province. Also the input a regional tax rule matches on.
  registeredRegion       String?
  registeredPostalCode   String?
  /// ISO-3166 alpha-2. Decides which tax rules can apply to this organizer's sales.
  registeredCountry      String?

  /// Who to reach about money, as opposed to `contactEmail`, which customers see.
  financeContactName  String?
  financeContactEmail String?
  financeContactPhone String?

  // Verification badge is a manual/admin placeholder for now (no automated flow).
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members                 OrganizationMember[]
  venues                  Venue[]
  events                  Event[]
  payouts                 Payout[]
  refunds                 Refund[]
  movies                  Movie[]
  cinemas                 Cinema[]
  merchantOnboardings     MerchantOnboarding[]
  organizerPaymentAccount OrganizerPaymentAccount[]
  settlements             Settlement[]
  disputes                Dispute[]
  receipts                Receipt[]

  @@index([status])
  /// Whether this organizer may sell tickets paid for in cash at the venue.
  ///
  /// Off by default and declared, never inferred. Turning it on means the organizer is
  /// taking money the platform will never see, so it changes who is responsible for
  /// collecting it, what a settlement can promise, and what a receipt can honestly say.
  /// Somebody has to choose that deliberately.
  cashPaymentsEnabled Boolean @default(false)

}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role
  status         MemberStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  invitation AccountInvitation?

  @@unique([organizationId, userId])
  @@index([userId])
}

// ─────────────────────────── Catalog ───────────────────────────

model Venue {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  city           String
  country        String       @default("India")

  /// IANA zone for events at this venue, e.g. "Asia/Kolkata", "America/Chicago".
  ///
  /// ── WHY A VENUE NEEDS ONE AT ALL ──────────────────────────────────────────────
  /// A start time means the time AT THE VENUE. Cinemas have carried a zone since the
  /// theater work; ordinary venues did not, so an event's start time was rendered in
  /// whatever zone the reader's browser happened to be in — the same defect that made a
  /// ticket and its confirmation disagree by eleven and a half hours, still live for every
  /// non-cinema event.
  ///
  /// Defaults to the pilot market's zone, matching Cinema, so nothing changes for existing
  /// venues. An organizer selling outside India has to set it, and cannot be guessed for:
  /// a country is not a timezone, and several of the launch markets span more than one.
  timezone  String   @default("Asia/Kolkata")
  address   String?
  capacity  Int?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  areas   VenueArea[]
  events  Event[]
  cinemas Cinema[]

  @@index([organizationId])
  @@index([city])
}

model VenueArea {
  id        String   @id @default(cuid())
  venueId   String
  venue     Venue    @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId])
}

// ─────────────────────────── Movies & Cinemas ───────────────────────────
// Additive movie domain (ADR-011). A film is catalogued as a Movie; it becomes
// bookable as an Event with experienceType = MOVIE whose sessions (shows) play
// on a Screen. Seat maps and seat-level booking arrive in PR-3 (ADR-013).

enum MovieStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Movie {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  slug           String       @unique
  synopsis       String?
  runtimeMinutes Int
  certificate    String? // U, UA, A, S
  language       String
  genres         String[]
  releaseDate    DateTime?
  posterUrl      String?
  trailerUrl     String?
  cast           String[]
  director       String?
  status         MovieStatus  @default(DRAFT)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events Event[] // bookable movie listings screening this film

  @@index([organizationId])
  @@index([status])
  @@index([status, releaseDate])
}

model Cinema {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // A cinema is a specialised venue; reuse Venue for city/discovery when linked.
  venueId        String?
  venue          Venue?       @relation(fields: [venueId], references: [id])
  name           String
  brand          String?
  city           String
  address        String?
  latitude       Float?
  longitude      Float?
  /// IANA zone this cinema's local dates and times are reckoned in, e.g. "Asia/Kolkata".
  ///
  /// AUTHORITATIVE. Every local date the platform computes for this venue — the schedule
  /// day, the week grid, booking windows, live operations, public showtime grouping — reads
  /// this column. Not the deployment region, not the browser, and not a hardcoded launch
  /// default: a hardcoded zone has already produced two real defects on this track, and it
  /// stops being merely wrong the moment a second city is onboarded.
  ///
  /// The DEFAULT exists for two narrow reasons and is not a runtime fallback: it backfills
  /// pre-existing India cinemas, and it keeps an older API instance that does not yet write
  /// the column working during a rolling deploy. Application code must never rely on it.
  timezone       String       @default("Asia/Kolkata")
  status         String       @default("ACTIVE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  screens Screen[]

  @@index([organizationId])
  @@index([city])
  @@index([venueId])
}

model Screen {
  id         String       @id @default(cuid())
  cinemaId   String
  cinema     Cinema       @relation(fields: [cinemaId], references: [id], onDelete: Cascade)
  name       String
  screenType String       @default("2D") // 2D, 3D, IMAX, 4DX
  capacity   Int
  /// Operational state. Existing rows default ACTIVE, so this is purely additive.
  status     ScreenStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sessions EventSession[]
  /// A screen has MANY layout versions over its life, not one. See SeatMap.
  seatMaps SeatMap[]

  @@index([cinemaId])
}

// ─────────────────── Seat maps & seat-level inventory (ADR-013) ───────────────────
// A screen has one SeatMap: categories (pricing tiers) + sections → rows → seats.
// Per-show seat availability lives in ShowSeat (one row per session×seat), the
// atomic lock target that makes seat booking oversell- and double-book-proof.

/// A seat layout version.
///
/// A screen used to have exactly one SeatMap (`screenId @unique`), which meant a layout
/// could never change: `generateSeatMap` refused outright once one existed. That is safe but
/// useless — a theater re-seats a room, converts a row to recliners, or adds a wheelchair
/// bay, and the software had no answer.
///
/// Versions make that safe rather than merely possible. Seats belong to a VERSION, and a
/// show's `ShowSeat` rows point at specific `Seat` rows, so a new version creates new seats
/// and cannot reach backwards into a show that has already sold. Immutability is structural,
/// not a rule someone has to remember to enforce.
model SeatMap {
  id       String  @id @default(cuid())
  screenId String
  screen   Screen  @relation(fields: [screenId], references: [id], onDelete: Cascade)
  name     String?

  /// Monotonic per screen, starting at 1. Human-facing: "Screen 3, layout v4".
  version Int              @default(1)
  status  SeatLayoutStatus @default(PUBLISHED)

  /// The version this was cloned from. Lineage, so a comparison has something to compare to.
  clonedFromId String?
  clonedFrom   SeatMap?  @relation("SeatMapLineage", fields: [clonedFromId], references: [id])
  clones       SeatMap[] @relation("SeatMapLineage")

  /// When this version starts applying to newly scheduled shows. Null means "as soon as it
  /// was published". This is what "activate a future version" means: publish it dated
  /// tomorrow, and tonight's shows are untouched because they are already pinned.
  effectiveFrom DateTime?
  publishedAt   DateTime?
  archivedAt    DateTime?

  /// GRID (a room of rows) or SECTIONED (blocks arranged around a focal point).
  ///
  /// Defaulted to GRID so every layout that already exists keeps rendering and selling
  /// exactly as it did. Nothing reads the geometry columns below unless this says SECTIONED.
  layoutKind VenueLayoutKind @default(GRID)

  /// What the audience faces, and where it sits on the map.
  focalPoint FocalPointKind @default(SCREEN)

  /// The focal shape's outline, as [[x, y], ...] in the same 0–1000 space as sections.
  ///
  /// Null means "derive it from focalPoint", which is right for the overwhelming majority of
  /// venues — a bar across the top for an end stage, a rectangle in the middle for a pitch.
  /// It is stored rather than always derived because real rooms have odd stages, and a venue
  /// whose map is subtly wrong is one customers do not trust.
  focalShape Json?

  /// What to call it on the map: "SCREEN", "STAGE", "PITCH". Null falls back to focalPoint.
  focalLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories SeatCategory[]
  sections   SeatSection[]
  seats      Seat[]
  /// Shows pinned to this exact version.
  sessions   EventSession[]

  @@unique([screenId, version])
  @@index([screenId, status])
}

model SeatCategory {
  id             String  @id @default(cuid())
  seatMapId      String
  seatMap        SeatMap @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  name           String // Recliner, Premium, Normal
  colorHex       String?
  basePriceMinor Int
  sortOrder      Int     @default(0)

  seats       Seat[]
  ticketTypes TicketType[]

  @@index([seatMapId])
}

model SeatSection {
  id        String  @id @default(cuid())
  seatMapId String
  seatMap   SeatMap @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int     @default(0)

  /// The block's outline on the venue map, as [[x, y], ...] in an abstract 0–1000 square
  /// with y increasing downward.
  ///
  /// Abstract rather than metres, because the map is a diagram for finding your seat, not a
  /// survey — and a unitless square renders identically on a phone and a wall display.
  ///
  /// Null on GRID layouts, which have no map. A SECTIONED layout without a shape is drawn in
  /// a fallback strip rather than dropped: a section the customer cannot see is a section
  /// whose seats cannot be sold.
  shape Json?

  /// Where the block's name sits. Null means the polygon's centroid, which is right until a
  /// section is L-shaped or a horseshoe and the centroid lands outside it.
  labelX Int?
  labelY Int?

  /// FLOOR, LOWER, CLUB, UPPER, LAWN — free text on purpose.
  ///
  /// Every venue names its decks differently and an enum would need a migration each time a
  /// new one is onboarded. Used to group the legend and to select a whole deck when pricing,
  /// never to decide what anything costs.
  tier String?

  /// How far the seats inside are turned, in degrees clockwise, so a side block's rows face
  /// the stage instead of the top of the screen.
  rotationDeg Int @default(0)

  rows SeatRow[]

  @@index([seatMapId])
}

model SeatRow {
  id        String      @id @default(cuid())
  sectionId String
  section   SeatSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  label     String // "A", "B", ...
  sortOrder Int         @default(0)

  seats Seat[]

  @@index([sectionId])
}

model Seat {
  id             String       @id @default(cuid())
  seatMapId      String
  seatMap        SeatMap      @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  rowId          String
  row            SeatRow      @relation(fields: [rowId], references: [id], onDelete: Cascade)
  seatCategoryId String
  seatCategory   SeatCategory @relation(fields: [seatCategoryId], references: [id])
  label          String // "12" (combined with row = "A12")
  colIndex       Int // position within the row for layout
  /// SEAT | GAP (aisle spacer) | WHEELCHAIR | COMPANION
  ///
  /// Accessibility is a property of the ROOM, not of a night's trading, so it lives on the
  /// layout and changes only by publishing a new version. Putting it on ShowSeat would mean
  /// a wheelchair bay could quietly differ between two showings of the same film.
  kind           String       @default("SEAT")

  showSeats ShowSeat[]
  tickets   Ticket[]

  @@unique([rowId, label])
  @@index([seatMapId])
  @@index([seatCategoryId])
}

model ShowSeat {
  id             String       @id @default(cuid())
  eventSessionId String
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  seatId         String
  seat           Seat         @relation(fields: [seatId], references: [id], onDelete: Cascade)
  /// AVAILABLE | HELD | SOLD | BLOCKED
  ///
  /// BLOCKED is every operator override. Booking's hold is
  /// `UPDATE … WHERE status = 'AVAILABLE'`, so anything else is unbookable atomically —
  /// the override needs no cooperation from the booking path to be safe.
  status         String       @default("AVAILABLE")
  holdBookingId  String?
  holdBooking    Booking?     @relation(fields: [holdBookingId], references: [id])
  holdExpiresAt  DateTime?
  version        Int          @default(0)
  updatedAt      DateTime     @updatedAt

  // ── Operator override (null on an untouched seat) ──────────────────────────────
  /// Why this seat is BLOCKED. Always set together with status = 'BLOCKED'.
  overrideKind      SeatOverrideKind?
  /// Free text from the operator. Required for every override: a block nobody can explain
  /// is a seat nobody dares release, and it stays dead for the run of the film.
  overrideReason    String?
  overrideByUserId  String?
  overrideBy        User?             @relation("SeatOverrideActor", fields: [overrideByUserId], references: [id])
  overrideAt        DateTime?
  /// Optional auto-expiry, used by MAINTENANCE. A cleaning block should not outlive the
  /// spill; requiring someone to remember to undo it is how seats stay dead for a week.
  overrideExpiresAt DateTime?

  @@unique([eventSessionId, seatId])
  @@index([eventSessionId, status])
  @@index([holdBookingId])
  @@index([seatId])
  @@index([eventSessionId, overrideKind])
  @@index([overrideExpiresAt])
}

model Event {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  venueId        String
  venue          Venue          @relation(fields: [venueId], references: [id])
  experienceType ExperienceType @default(EVENT)
  // Set only for MOVIE experiences: the film this bookable listing screens.
  movieId        String?
  movie          Movie?         @relation(fields: [movieId], references: [id])
  title          String
  slug           String         @unique
  category       String
  description    String?
  status         EventStatus    @default(DRAFT)
  feeMode        FeeMode        @default(CUSTOMER_PAYS)

  /// This event costs nothing, and nothing about it touches money.
  ///
  /// A DECLARATION, not something inferred from the prices. Deriving it from "every ticket
  /// type is zero" would flip an event into and out of free as an organizer edited a price,
  /// and a booking taken under one reading would be confirmed under the other. Declared, it
  /// is a fact the whole flow can rely on — and one the API enforces: a free event's ticket
  /// types must all be zero, and its bookings carry no booking fee, no payment fee and no
  /// platform share.
  ///
  /// Free bookings skip the payment provider entirely. There is no Payment row, no
  /// REQUIRES_PAYMENT state and no zero-amount charge sent to Razorpay or Stripe — a
  /// gateway asked to collect nothing is a support ticket waiting to happen. Everything
  /// after the money still runs: tickets, QR codes, notifications, transfers, cancellation.
  isFree       Boolean @default(false)
  /// Free text shown to buyers. Describes the policy; does not enforce it.
  refundPolicy String?

  /// Whether this event offers refunds at all, and until when.
  ///
  /// ── WHY THE ORGANIZER OWNS THIS ────────────────────────────────────────────────
  /// The cut-off used to be a constant in platform code: 48 hours, for everybody. That is
  /// the platform deciding an organizer's cancellation terms on their behalf, and then
  /// showing buyers a refund button the organizer never agreed to honour. If a request is
  /// granted that the organizer would have refused, the money still leaves — so the
  /// platform was quietly underwriting a promise it had no right to make.
  ///
  /// Defaults preserve today's behaviour exactly (refunds on, 48 hours), so nothing changes
  /// for an event nobody has touched.
  refundsEnabled    Boolean   @default(true)
  /// Hours before the session start after which refunds close. 0 means "up to start time".
  refundCutoffHours Int       @default(48)
  publishedAt       DateTime?
  reviewedByUserId  String?
  reviewNote        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  sessions    EventSession[]
  bookings    Booking[]
  reviews     Review[]
  addOns      AddOn[]
  bundles     Bundle[]
  settlements Settlement[]

  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([experienceType])
  @@index([movieId])
  @@index([venueId])
  @@index([status, experienceType, publishedAt])
}

model Review {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventSession {
  id        String        @id @default(cuid())
  eventId   String
  event     Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// The room this session happens in, when it happens in one with a seat map.
  ///
  /// Named `screen` for historical reasons — it began as "the screen a film plays on" — but
  /// what it actually means is "a room with a seat layout". A concert in a seated theatre
  /// wants exactly the same thing a cinema does: a map of the room, and a seat per ticket.
  ///
  /// Null means general admission. That is the difference the booking path cares about, and
  /// it is a property of the ROOM rather than of the kind of event: the same concert is
  /// reserved seating in a theatre and general admission in a standing arena.
  screenId  String?
  screen    Screen?       @relation(fields: [screenId], references: [id])
  /// The seat layout VERSION this show was scheduled against, pinned at scheduling time.
  ///
  /// Recoverable from ShowSeat → Seat → seatMapId, but recording it explicitly is what lets
  /// the schedule answer "which layout will tomorrow's show use" before a single seat has
  /// moved, and makes a re-layout auditable rather than inferred.
  seatMapId String?
  seatMap   SeatMap?      @relation(fields: [seatMapId], references: [id])
  startsAt  DateTime
  endsAt    DateTime
  status    SessionStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  ticketTypes TicketType[]
  bookings    Booking[]
  tickets     Ticket[]
  checkIns    CheckIn[]
  showSeats   ShowSeat[]

  @@index([eventId])
  @@index([startsAt])
  @@index([screenId])
}

model TicketType {
  id             String        @id @default(cuid())
  eventSessionId String
  eventSession   EventSession  @relation(fields: [eventSessionId], references: [id], onDelete: Cascade)
  // For seat-based (movie) sessions: the seat category this price applies to.
  seatCategoryId String?
  seatCategory   SeatCategory? @relation(fields: [seatCategoryId], references: [id])
  name           String
  priceMinor     Int
  currency       String        @default("INR")
  quantityTotal  Int
  maxPerOrder    Int           @default(10)
  salesStartAt   DateTime?
  salesEndAt     DateTime?
  status         String        @default("ACTIVE")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  inventory    TicketInventory?
  bookingItems BookingItem[]
  tickets      Ticket[]
  bundleItems  BundleItem[]

  @@index([eventSessionId])
  @@index([seatCategoryId])
}

// One row per ticket type; the concurrency-safe source of truth for stock.
model TicketInventory {
  id            String     @id @default(cuid())
  ticketTypeId  String     @unique
  ticketType    TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Cascade)
  quantityTotal Int
  quantitySold  Int        @default(0)
  quantityHeld  Int        @default(0)
  version       Int        @default(0)
  updatedAt     DateTime   @updatedAt
}

// ─────────────────────────── Commerce ───────────────────────────

model Coupon {
  id             String     @id @default(cuid())
  organizationId String?
  code           String     @unique
  type           CouponType
  value          Int
  maxRedemptions Int?
  redemptions    Int        @default(0)
  startsAt       DateTime?
  endsAt         DateTime?
  status         String     @default("ACTIVE")

  /// Whether buyers are SHOWN this code, as opposed to having to know it.
  ///
  /// ── WHY THIS DEFAULTS TO FALSE ────────────────────────────────────────────────────
  /// Listing every active code at checkout would publish codes that were never meant to be
  /// public — a win-back offer mailed to lapsed customers, a rate given to one partner, an
  /// influencer's code. Those are worth exactly as much as their scarcity, and a platform
  /// that leaks them by default destroys their value silently and irreversibly.
  ///
  /// So a code is private unless an organizer deliberately publishes it. Private codes still
  /// work perfectly — the buyer types them, which is the point of having them.
  isPublic    Boolean @default(false)
  /// Shown beside the code in the offers list, e.g. "10% off your first booking". Falls back
  /// to a description generated from the discount when blank.
  publicLabel String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([isPublic, status])
}

model Booking {
  id             String       @id @default(cuid())
  organizationId String
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id])
  eventSessionId String
  eventSession   EventSession @relation(fields: [eventSessionId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  couponId       String?
  coupon         Coupon?      @relation(fields: [couponId], references: [id])

  // Human-readable, globally-unique, immutable public reference assigned once at
  // confirmation, e.g. "ETG-IND-2026-000001" (brand-country-year-sequence). Null
  // for pending/legacy bookings; read paths fall back to a derived short code.
  // See BookingReferenceService + BookingReferenceCounter.
  reference  String?       @unique
  buyerName  String
  buyerEmail String
  status     BookingStatus @default(PENDING_PAYMENT)

  /// Whether this booking holds named seats, decided when it was created.
  ///
  /// Stored rather than re-derived, for the same reason `Event.isFree` is: a booking is a
  /// settled fact and the session it belongs to can be edited afterwards. If a room were
  /// ever detached from a session, every booking against it would silently flip to general
  /// admission — and the confirmation path would then try to settle seat inventory as a
  /// counter, or the reverse. Reading a value written at the time removes the question.
  seatBased Boolean @default(false)

  /// How this booking is paid for, decided when it was created.
  ///
  /// Stored rather than inferred, for the same reason `seatBased` and `Event.isFree` are: a
  /// booking is a settled fact. Deriving it later from "has no Payment row" would make an
  /// online booking whose payment failed indistinguishable from a cash one, and those are
  /// owed completely different things.
  paymentMethod BookingPaymentMethod @default(ONLINE)

  /// When the cash was actually handed over, and who took it. Null until then.
  ///
  /// The collector is recorded because this is the one payment path with no provider record
  /// behind it — if the money and the till disagree, this row is the only account of who was
  /// holding it.
  cashCollectedAt       DateTime?
  cashCollectedByUserId String?
  cashCollectedBy       User?     @relation("CashCollected", fields: [cashCollectedByUserId], references: [id])

  /// How many times the buyer has asked for more time on this hold.
  ///
  /// WCAG 2.2.1 (Timing Adjustable, Level A) requires that a time limit can be extended, and
  /// a seat hold is a time limit on a commercial transaction. Counting the extensions rather
  /// than allowing unlimited ones is the compromise the criterion itself anticipates: it asks
  /// for "at least ten", which bounds how long one person can hold inventory they have not
  /// paid for while still giving somebody using a screen reader, a switch, or simply reading
  /// carefully the time they need.
  ///
  /// On the row rather than in a cache because it has to survive a page reload — the person
  /// most likely to need an extension is the one most likely to have navigated away and back.
  holdExtensions Int @default(0)
  currency   String        @default("INR")
  feeMode    FeeMode       @default(CUSTOMER_PAYS)

  // Immutable money snapshot (minor units) so historical bookings never drift.
  subtotalMinor     Int
  bookingFeeMinor   Int              @default(0)
  paymentFeeMinor   Int              @default(0)
  discountMinor     Int              @default(0)
  customerFeeMinor  Int              @default(0)
  organizerFeeMinor Int              @default(0)
  /// Tax the CUSTOMER pays, summed from `taxLines`. Zero until somebody activates a
  /// TaxRule — no rate is assumed anywhere in this codebase.
  taxMinor          Int              @default(0)
  taxLines          BookingTaxLine[]
  totalMinor        Int

  holdExpiresAt  DateTime
  confirmedAt    DateTime?
  cancelledAt    DateTime?
  idempotencyKey String?   @unique

  heldSeats ShowSeat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   BookingItem[]
  tickets Ticket[]
  payment Payment?
  refunds Refund[]
  Receipt Receipt[]

  @@index([organizationId])
  @@index([eventId])
  @@index([status])
  @@index([holdExpiresAt])
  @@index([userId])
  @@index([eventSessionId, status])
  @@index([confirmedAt])
  // Serves the platform-wide createdAt-window scan in the risk service (v2.1 audit).
  @@index([createdAt])
  @@index([couponId])
  /// The counter's worklist: unpaid cash reservations, which is the one query cash adds.
  @@index([paymentMethod, status])
}

model BookingItem {
  id             String          @id @default(cuid())
  bookingId      String
  booking        Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  // Experience Commerce (v1.3): a line is a ticket, an add-on, or a bundle
  // component. ticketTypeId is now nullable (add-on lines have addOnId instead);
  // existing ticket lines keep ticketTypeId set and default kind TICKET.
  kind           BookingItemKind @default(TICKET)
  ticketTypeId   String?
  ticketType     TicketType?     @relation(fields: [ticketTypeId], references: [id])
  addOnId        String?
  addOn          AddOn?          @relation(fields: [addOnId], references: [id])
  // Set when this line came from a bundle (groups the expanded components).
  bundleId       String?
  bundle         Bundle?         @relation(fields: [bundleId], references: [id])
  // Snapshot label for display (add-on/bundle name at purchase time).
  label          String?
  quantity       Int
  unitPriceMinor Int
  lineTotalMinor Int
  createdAt      DateTime        @default(now())

  @@index([bookingId])
  @@index([addOnId])
  @@index([bundleId])
  @@index([ticketTypeId])
}

// A configurable non-ticket product an organizer sells for an event (v1.3 WS1/WS4).
model AddOn {
  id           String    @id @default(cuid())
  eventId      String
  event        Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type         AddOnType
  name         String
  description  String?
  priceMinor   Int
  currency     String    @default("INR")
  imageUrl     String?
  // Max units of this add-on per order (donations ignore this; see service).
  maxPerOrder  Int       @default(10)
  // Availability window; null = always on sale while enabled.
  salesStartAt DateTime?
  salesEndAt   DateTime?
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inventory    AddOnInventory?
  bookingItems BookingItem[]
  bundleItems  BundleItem[]

  @@index([eventId])
  @@index([eventId, enabled])
}

// Stock for an add-on. quantityTotal null = unlimited (donations/digital).
model AddOnInventory {
  id            String   @id @default(cuid())
  addOnId       String   @unique
  addOn         AddOn    @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  quantityTotal Int?
  quantitySold  Int      @default(0)
  quantityHeld  Int      @default(0)
  version       Int      @default(0)
  updatedAt     DateTime @updatedAt
}

// A pre-priced package of ticket types and/or add-ons (v1.3 WS3).
model Bundle {
  id              String            @id @default(cuid())
  eventId         String
  event           Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type            BundleType
  name            String
  description     String?
  currency        String            @default("INR")
  pricingKind     BundlePricingKind @default(FIXED)
  // FIXED → the all-in bundle price (minor units). PERCENT_DISCOUNT → percent off.
  priceMinor      Int?
  discountPercent Int?
  maxPerOrder     Int               @default(5)
  salesStartAt    DateTime?
  salesEndAt      DateTime?
  enabled         Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items        BundleItem[]
  bookingItems BookingItem[]

  @@index([eventId])
  @@index([eventId, enabled])
}

// One component (a ticket type or an add-on) inside a bundle, with a quantity.
model BundleItem {
  id           String      @id @default(cuid())
  bundleId     String
  bundle       Bundle      @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  ticketTypeId String?
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])
  addOnId      String?
  addOn        AddOn?      @relation(fields: [addOnId], references: [id])
  quantity     Int         @default(1)

  @@index([bundleId])
  @@index([ticketTypeId])
  @@index([addOnId])
}

model Ticket {
  id                   String                   @id @default(cuid())
  bookingId            String
  booking              Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketTypeId         String
  ticketType           TicketType               @relation(fields: [ticketTypeId], references: [id])
  eventSessionId       String
  eventSession         EventSession             @relation(fields: [eventSessionId], references: [id])
  organizationId       String
  serial               String                   @unique
  nonce                String
  qrVersion            Int                      @default(1)
  status               TicketStatus             @default(ACTIVE)
  // Set for seat-based (movie) tickets: the specific seat this ticket admits.
  seatId               String?
  seat                 Seat?                    @relation(fields: [seatId], references: [id])
  seatLabel            String?
  // ── Attendee identity (ADR-031). holderName/holderEmail are the attendee's
  //    name/email; the fields below enrich the profile. assignmentStatus is the
  //    identity lifecycle, orthogonal to `status` (gate/refund). attendeeUserId
  //    links a claimed ticket to the attendee's account. Additive + optional, so
  //    existing tickets keep working unchanged.
  holderName           String?
  holderEmail          String?
  assignmentStatus     AttendeeAssignmentStatus @default(UNASSIGNED)
  attendeeUserId       String?
  attendeeUser         User?                    @relation("TicketAttendee", fields: [attendeeUserId], references: [id])
  attendeePhone        String?
  attendeeCountry      String?
  attendeeCompany      String?
  attendeeDesignation  String?
  attendeeStudentId    String?
  attendeeMemberId     String?
  // Per-experience custom attendee fields (configurable), stored as { key: value }.
  attendeeCustomFields Json?
  issuedAt             DateTime                 @default(now())
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  checkIns CheckIn[]
  invites  TicketInvite[]

  @@index([bookingId])
  @@index([eventSessionId])
  @@index([status])
  @@index([seatId])
  @@index([attendeeUserId])
  @@index([ticketTypeId])
}

// Invitation / transfer ledger for the attendee identity layer (ADR-031). Each
// row is one tokenised invite or transfer of a single ticket. Only a token HASH
// is stored (never the raw token); expiry + status prevent replay and stale
// links. Accepting rotates the ticket's QR nonce so any previously-shared QR
// stops working — there is only ever one valid QR per ticket.
model TicketInvite {
  id                 String             @id @default(cuid())
  ticketId           String
  ticket             Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organizationId     String
  kind               TicketInviteKind   @default(INVITE)
  status             TicketInviteStatus @default(PENDING)
  // Secure Experience Sharing (ADR-032). permission drives what the link grants;
  // resourceType keeps the ledger generic for future wallet items; open counters
  // + limits enforce single/multi-use policy. Existing rows are TRANSFER/TICKET.
  permission         SharePermission    @default(TRANSFER)
  resourceType       ResourceType       @default(TICKET)
  maxOpens           Int?
  openCount          Int                @default(0)
  lastOpenedAt       DateTime?
  lastOpenedByUserId String?
  label              String?
  // Intended recipient (for delivery + display); the accepting account may differ.
  email              String?
  phone              String?
  tokenHash          String             @unique
  expiresAt          DateTime
  createdByUserId    String?
  acceptedByUserId   String?
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([ticketId])
  @@index([status])
  @@index([organizationId])
  // Serves the transfer-velocity window scan in the risk service (v2.1 audit).
  @@index([kind, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String        @unique
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider    String        @default("mock")
  status      PaymentStatus @default(REQUIRES_PAYMENT)
  amountMinor Int
  currency    String        @default("INR")
  // Generic provider reference (kept for back-compat: holds the PaymentIntent id or
  // Checkout Session id). The typed fields below are populated for Stripe.
  providerRef String?

  // ─── Stripe / marketplace fields (nullable so existing rows/other providers are unaffected) ───
  providerPaymentIntentId   String?
  providerCheckoutSessionId String?
  // Provider order id (Razorpay order_id; provider-neutral pre-payment reference).
  providerOrderId           String?
  // Raw provider-reported status (e.g. Razorpay 'captured'/'authorized') for reconciliation.
  providerStatus            String?
  // The organizer's connected account this payment will settle to (Separate Charges
  // & Transfers: the charge lands on the PLATFORM; funds move here later via a transfer).
  connectedAccountId        String?
  // Money split (integer minor units), snapshotted from the booking at checkout.
  subtotalMinor             Int       @default(0)
  taxMinor                  Int       @default(0)
  // ETicketsGo's retained platform/convenience fee (gross margin before Stripe's fee).
  platformFeeMinor          Int       @default(0)
  // Stripe's processing fee, when captured from the balance transaction.
  processingFeeMinor        Int?
  // What the organizer is eligible to receive (the transfer base, before reserve).
  organizerNetMinor         Int       @default(0)
  // Cumulative amount refunded so far (guards refunds against exceeding the capture).
  refundedMinor             Int       @default(0)
  // Server-generated idempotency key (== bookingId today) so retries never double-charge.
  idempotencyKey            String?   @unique
  failureCode               String?
  failureMessage            String?
  paidAt                    DateTime?
  metadata                  Json?

  // Which settlement batch this payment's organizer proceeds belong to (set on success).
  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts PaymentAttempt[]
  disputes Dispute[]

  @@index([status])
  @@index([providerPaymentIntentId])
  @@index([connectedAccountId])
  @@index([settlementId])
}

model PaymentAttempt {
  id          String               @id @default(cuid())
  paymentId   String
  payment     Payment              @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  status      PaymentAttemptStatus @default(CREATED)
  providerRef String?
  rawEvent    Json?
  createdAt   DateTime             @default(now())

  @@index([paymentId])
  // Serves the payment-failure window scan in the risk service (v2.1 audit).
  @@index([createdAt])
}

model Refund {
  id                String       @id @default(cuid())
  bookingId         String
  booking           Booking      @relation(fields: [bookingId], references: [id])
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  amountMinor       Int
  /// The portion of `amountMinor` that is tax being returned.
  ///
  /// Recorded rather than re-derived: the credit note has to state the tax component exactly,
  /// and apportioning it back out of a total afterwards reintroduces rounding error into a
  /// figure a tax authority may read. Zero on every refund taken before tax existed, and on
  /// every refund where no tax was charged — which is the default.
  taxMinor          Int          @default(0)
  status            RefundStatus @default(REQUESTED)
  reason            String
  ticketIds         String[]     @default([])
  requestedByUserId String?
  processedByUserId String?
  providerRef       String?
  creditNote        Receipt?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([bookingId])
  // Composite serves both status-only reads and the risk service's
  // status+createdAt window scan (leftmost prefix covers status alone). (v2.1 audit)
  @@index([status, createdAt])
  @@index([organizationId])
}

model Payout {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId         String?
  periodStart     DateTime?
  periodEnd       DateTime?
  grossMinor      Int          @default(0)
  bookingFeeMinor Int          @default(0)
  paymentFeeMinor Int          @default(0)
  refundMinor     Int          @default(0)
  netMinor        Int          @default(0)
  currency        String       @default("INR")
  status          PayoutStatus @default(PENDING)
  scheduledAt     DateTime?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([status])
}

// ─────────── Offline gate check-in (ADR-035) — DISABLED by default ───────────
// A registered, org/event-scoped device that may validate tickets during a
// temporary connectivity loss against a server-signed manifest. Private keys
// never leave the device; only a reference is stored. Feature-flagged off until
// live conflict/device-loss/reconciliation drills pass — see OFFLINE-CHECKIN docs.

enum CheckInDeviceStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
}

model CheckInDevice {
  id                  String              @id @default(cuid())
  organizationId      String
  eventId             String?
  eventSessionId      String?
  assignedStaffUserId String?
  name                String
  platform            String?
  // Reference to the device's public key (never a private key). Non-secret.
  publicKeyRef        String?
  status              CheckInDeviceStatus @default(PENDING)
  manifestVersion     Int                 @default(0)
  keyVersion          Int                 @default(1)
  expiresAt           DateTime?
  lastSeenAt          DateTime?
  approvedByUserId    String?
  createdByUserId     String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([organizationId])
  @@index([eventId])
  @@index([status])
}

// Audit header for a signed offline manifest issued for a session (the entries
// themselves are derived from tickets at build time and transmitted, not stored).
model CheckInManifest {
  id              String   @id @default(cuid())
  organizationId  String
  eventId         String
  eventSessionId  String
  version         Int
  validFrom       DateTime
  expiresAt       DateTime
  ticketCount     Int
  signature       String
  createdByUserId String?
  createdAt       DateTime @default(now())

  @@unique([eventSessionId, version])
  @@index([organizationId])
  @@index([eventSessionId])
}

// Recorded result of a live/browser offline certification drill (ADR-035). The
// activation gate reads the latest PASS per drill key within a freshness window as
// evidence — a drill never recorded, last FAILED, or stale keeps the gate closed
// (fail-closed). Evidence is structured + non-secret (ticket/device ids, outcomes);
// never PII or credentials.
enum OfflineDrillKey {
  TWO_DEVICE_CONFLICT
  DEVICE_LOSS
  RECONCILIATION
  NETWORK_LOSS
}

enum OfflineDrillOutcome {
  PASS
  FAIL
}

model OfflineDrillRun {
  id             String              @id @default(cuid())
  organizationId String
  eventId        String?
  eventSessionId String?
  drillKey       OfflineDrillKey
  outcome        OfflineDrillOutcome
  summary        String
  evidence       Json?
  ranByUserId    String?
  createdAt      DateTime            @default(now())

  @@index([organizationId, drillKey, createdAt])
}

// A recorded administrator decision to activate offline gate check-in for a specific
// scope (ADR-035). Activation is never a bare flag flip: it is scoped to an
// org/event/session and an explicit set of approved devices, may only be recorded
// when every blocking readiness + drill check is green and current, carries an
// immutable evidence snapshot, and is fully audited + revocable. mustDowngrade and
// the activation policy remain authoritative at read time.
enum OfflineActivationState {
  ACTIVE
  REVOKED
  SUPERSEDED
}

model OfflineActivation {
  id               String                 @id @default(cuid())
  organizationId   String
  eventId          String
  eventSessionId   String
  deviceIds        String[]
  state            OfflineActivationState @default(ACTIVE)
  reason           String
  // Immutable snapshot of the ActivationInputs + derived checks at approval time.
  evidenceSnapshot Json
  approvedByUserId String
  approvedAt       DateTime               @default(now())
  revokedByUserId  String?
  revokedAt        DateTime?
  revokeReason     String?
  createdAt        DateTime               @default(now())

  @@index([organizationId, eventSessionId, state])
}

// A durable per-item record of an offline check-in reconciliation (ADR-035). Written
// by the reconcile engine for every queued item it processes, this is the ledger the
// Reconciliation Console reads. The outcome is IMMUTABLE — supervisor resolution is an
// audit-only annotation that never converts an outcome into an admission.
enum ReconcileReviewState {
  NOT_REQUIRED
  PENDING
  RESOLVED
}

enum ReconcileResolutionAction {
  ACKNOWLEDGED
  DISMISSED
}

model OfflineReconciliationRecord {
  id               String                     @id @default(cuid())
  organizationId   String
  eventId          String?
  eventSessionId   String
  deviceId         String
  ticketId         String
  operatorUserId   String?
  localScannedAt   DateTime
  reconciledAt     DateTime                   @default(now())
  outcome          String
  wasOverride      Boolean                    @default(false)
  reviewState      ReconcileReviewState       @default(NOT_REQUIRED)
  resolutionAction ReconcileResolutionAction?
  resolutionReason String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime                   @default(now())

  @@index([organizationId, eventSessionId])
  @@index([organizationId, reviewState])
  @@index([organizationId, outcome])
  @@index([deviceId])
  @@index([ticketId])
}

// A manager/admin acknowledgement of a Live Event Command Center alert (ADR-035).
// Alerts themselves are DERIVED deterministically per poll (deduped by key); only the
// acknowledgement is persisted. Acknowledging records who/when/why for audit — it
// never suppresses the underlying condition (the alert keeps deriving) or changes the
// gate. Unique per (session, alertKey) so re-acknowledging is idempotent.
model OfflineAlertAck {
  id                   String   @id @default(cuid())
  organizationId       String
  eventSessionId       String
  alertKey             String
  severityAtAck        String
  reason               String
  acknowledgedByUserId String
  acknowledgedAt       DateTime @default(now())

  @@unique([eventSessionId, alertKey])
  @@index([organizationId, eventSessionId])
}

// ─────────────────────────── Operations ───────────────────────────

model CheckIn {
  id               String            @id @default(cuid())
  ticketId         String
  ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventSessionId   String
  eventSession     EventSession      @relation(fields: [eventSessionId], references: [id])
  result           CheckInResultType
  byUserId         String?
  by               User?             @relation("CheckInActor", fields: [byUserId], references: [id])
  deviceInfo       String?
  reversed         Boolean           @default(false)
  reversedByUserId String?
  reversedAt       DateTime?
  createdAt        DateTime          @default(now())

  @@index([ticketId])
  @@index([eventSessionId])
  @@index([byUserId])
}

model Notification {
  id           String           @id @default(cuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id])
  type         NotificationType
  channel      String           @default("email") // email | sms | whatsapp | push | in_app
  locale       String           @default("en")
  toEmail      String?
  payload      Json
  // PENDING | SCHEDULED | SENT | FAILED | CANCELLED
  status       String           @default("PENDING")
  scheduledFor DateTime? // set for scheduled (deferred) sends
  attempts     Int              @default(0)
  lastError    String?
  sentAt       DateTime?
  cancelledAt  DateTime?
  // Read state for the in-app notification center (v1.2 WS8); null = unread.
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([userId])
  @@index([type])
  @@index([status, scheduledFor])
  @@index([userId, channel, readAt])
  // Serves the inbox cursor + `ORDER BY createdAt DESC` (v2.1 audit); the readAt
  // composite above only serves the unread-count/mark-all path.
  @@index([userId, channel, createdAt])
}

// Per-user opt-out for a (type, channel). Absence of a row = enabled.
model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  channel   String
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([userId, type, channel])
  @@index([userId])
}

// Customer-success submissions: contact/bug/feature/general + satisfaction surveys.
enum FeedbackKind {
  CONTACT
  BUG
  FEATURE
  GENERAL
  CSAT // customer satisfaction (rating)
  ORGANIZER_CSAT // organizer satisfaction (rating)
}

model Feedback {
  id        String       @id @default(cuid())
  kind      FeedbackKind
  userId    String?
  user      User?        @relation(fields: [userId], references: [id])
  email     String?
  subject   String?
  message   String
  rating    Int? // 1..5 for CSAT/ORGANIZER_CSAT
  metadata  Json? // url, userAgent, appVersion, etc.
  status    String       @default("OPEN") // OPEN | TRIAGED | CLOSED
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([kind])
  @@index([status])
  @@index([createdAt])
  @@index([userId])
}

model AuditLog {
  id             String   @id @default(cuid())
  actorUserId    String?
  actor          User?    @relation(fields: [actorUserId], references: [id])
  organizationId String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  correlationId  String?
  ip             String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([actorUserId])
}

model IdempotencyRecord {
  id           String    @id @default(cuid())
  scope        String
  key          String
  requestHash  String?
  responseJson Json?
  status       String    @default("IN_PROGRESS")
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?

  @@unique([scope, key])
}

// Monotonic per-(country, year) sequence backing human-readable booking references
// (ADR-030). `scope` is "<ALPHA3>-<YEAR>" e.g. "IND-2026"; `value` is the last
// number issued. Incremented atomically inside the booking-confirm transaction so
// references are collision-free and gap-tolerant under concurrency and multi-region.
model BookingReferenceCounter {
  scope     String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Configurable, tiered platform fee rules. Admin-managed (section 13).
model FeeRule {
  id        String   @id @default(cuid())
  label     String
  minMinor  Int
  maxMinor  Int?
  feeMinor  Int
  currency  String   @default("INR")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

/// What a tax rule is levied on.
///
/// Split because the answer differs by jurisdiction and is a question for a tax advisor,
/// not for this codebase: some places tax the admission only, some also tax the booking
/// fee, and the two can carry different rates.
enum TaxBase {
  TICKETS
  FEES
  TICKETS_AND_FEES
}

/// One tax a customer may be charged, entirely configuration.
///
/// ── WHY THIS IS DATA AND NOT CODE ──────────────────────────────────────────────────
/// Rates, thresholds and what is taxable are a jurisdiction's business and they change.
/// Encoding "18%" or "GST" as a literal anywhere would mean shipping a release every time
/// a rate moves or a market is added, and would make this repository a place where tax law
/// is asserted by engineers. So the platform can REPRESENT any of the three launch markets'
/// taxes and asserts none of them.
///
/// `active` defaults to FALSE. An empty or unconfigured table charges nothing and every
/// total is exactly what it is today — the only safe default when the alternative is
/// silently over- or under-charging a customer.
///
/// Several rules can apply at once, which is the normal case in Canada (federal plus
/// provincial) and the US (state plus city). Each produces its own BookingTaxLine so a
/// receipt can itemise them and an auditor can reconstruct the arithmetic.
model TaxRule {
  id    String @id @default(cuid())
  /// Shown to the customer and printed on the receipt, e.g. "GST", "HST", "Sales tax".
  label String

  /// Rate in BASIS POINTS: 1800 = 18.00%. Integers only, because a float rate reintroduces
  /// exactly the rounding drift that integer minor units exist to prevent.
  rateBasisPoints Int
  appliesTo       TaxBase @default(TICKETS)

  /// Matching, most specific first. '*' matches anything.
  country  String @default("*")
  /// State / province, for the second tax layer the US and Canada both have.
  region   String @default("*")
  currency String @default("*")

  /// Lower runs first. Only matters for presentation order on a receipt; each line is
  /// computed on its own base, so no rule compounds on another.
  priority Int     @default(100)
  active   Boolean @default(false)

  /// When this rate came into force and when it stopped. A rate change is a NEW rule with
  /// a later `effectiveFrom`, never an edit — editing would silently rewrite the tax on
  /// bookings already taken.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, country, region])
}

/// One tax actually charged on one booking, snapshotted at checkout.
///
/// A copy, not a reference: the rule it came from may later be deactivated or superseded,
/// and a receipt reprinted a year afterwards must show what the customer was charged on the
/// day — not what the rules say now.
model BookingTaxLine {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  label           String
  rateBasisPoints Int
  /// The amount this rate was applied to, so the arithmetic is reproducible from the row.
  baseMinor       Int
  amountMinor     Int

  createdAt DateTime @default(now())

  @@index([bookingId])
}

// ─────────────────── Runtime payment configuration (ADR-020) ───────────────────
// Env-scoped, admin-editable configuration for the multi-country / multi-provider
// payment platform. NO raw secrets are ever stored here — only non-secret public
// identifiers and secret *references* (a path/key resolved from the secret manager
// at runtime). Production fails closed when this configuration is invalid; see
// PaymentConfigValidator.

// One payment provider's configuration within one environment.
model PaymentProviderConfig {
  id       String              @id @default(cuid())
  env      PaymentEnv
  provider String // 'dummy' | 'stripe' | 'razorpay' | 'paypal' | 'square'
  enabled  Boolean             @default(false)
  mode     PaymentProviderMode @default(TEST)

  // Non-secret public identifier (publishable key / client id) — safe to store.
  publicKey        String?
  // Secret REFERENCES only, e.g. 'payments/stripe/test/secret-key'. Never raw.
  secretKeyRef     String?
  webhookSecretRef String?
  // Optional endpoint override (e.g. a sandbox base URL). Not hardcoded in code.
  apiBaseUrl       String?

  // Operational controls (failover / circuit-breaker / timeouts) consumed by the
  // orchestrator. Editable per env without a deploy.
  timeoutMs               Int @default(15000)
  maxRetries              Int @default(2)
  retryBackoffMs          Int @default(500)
  circuitFailureThreshold Int @default(5)
  circuitCooldownMs       Int @default(30000)
  // Lower value = higher priority when several providers can serve a route.
  priority                Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  merchantAccounts MerchantAccount[]

  @@unique([env, provider])
  @@index([env, enabled])
}

// A merchant/settlement account for a provider config, optionally scoped to a
// country and/or currency (null = applies to anything the provider serves). Holds
// only non-secret identifiers and secret references.
model MerchantAccount {
  id            String                @id @default(cuid())
  configId      String
  config        PaymentProviderConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  label         String
  country       String? // ISO-3166 alpha-2; null = any
  currency      String? // ISO-4217; null = any
  // Provider-side account identifier (e.g. Stripe connected account id). Reference,
  // not a secret credential.
  merchantIdRef String?
  active        Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([configId, country, currency])
  @@index([configId, active])
}

// Merchant onboarding workflow (ADR-025). Tracks a merchant/provider application
// from DRAFT to ACTIVE, per environment. Stores only provider account IDs and
// secret REFERENCES / external-account references — never bank credentials.
enum MerchantOnboardingStatus {
  DRAFT
  PENDING_CONFIGURATION
  PENDING_VERIFICATION
  TESTING
  READY_FOR_LIVE
  ACTIVE
  SUSPENDED
  REJECTED
}

model MerchantOnboarding {
  id                    String                   @id @default(cuid())
  env                   PaymentEnv
  organizationId        String?
  organization          Organization?            @relation(fields: [organizationId], references: [id])
  // Business identity.
  country               String // ISO-3166 alpha-2
  legalBusinessName     String
  displayName           String
  merchantType          String                   @default("STANDARD") // STANDARD | MARKETPLACE | INDIVIDUAL
  settlementCurrency    String // ISO-4217
  // Provider binding.
  provider              String // stripe | razorpay | paypal | square
  mode                  PaymentProviderMode      @default(TEST)
  // Provider-side account identifier + secret REFERENCES (never raw secrets).
  accountIdentifier     String?
  secretKeyRef          String?
  webhookSecretRef      String?
  publicKey             String?
  // Settlement + payout (references only; never bank credentials).
  settlementSchedule    String                   @default("T_PLUS_2") // e.g. T_PLUS_2, WEEKLY
  payoutDestinationRef  String?
  // Verification + webhook posture.
  webhookEndpointStatus String                   @default("NOT_CONFIGURED") // NOT_CONFIGURED | CONFIGURED | VERIFIED
  verificationStatus    String                   @default("UNVERIFIED") // UNVERIFIED | IN_REVIEW | VERIFIED | FAILED
  // Terms + lifecycle.
  termsAcceptedAt       DateTime?
  termsAcceptedBy       String?
  status                MerchantOnboardingStatus @default(DRAFT)
  activatedAt           DateTime?
  suspendedAt           DateTime?
  rejectedReason        String?
  // Linked runtime merchant account once activated.
  merchantAccountId     String?
  createdByUserId       String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@index([env, status])
  @@index([organizationId])
  @@index([provider])
}

// Finance reconciliation discrepancy queue (ADR-029). Detected differences between
// our records and provider truth, triaged by finance ops. Financial records are
// NEVER auto-corrected — resolution is a human, audited action.
enum DiscrepancyType {
  PAYMENT_MISSING_INTERNALLY
  PAYMENT_MISSING_AT_PROVIDER
  AMOUNT_MISMATCH
  CURRENCY_MISMATCH
  DUPLICATE_CAPTURE
  REFUND_MISMATCH
  CHARGEBACK
  SETTLEMENT_MISMATCH
  GATEWAY_FEE_MISMATCH
  ORGANIZER_PAYABLE_MISMATCH
}

enum DiscrepancyStatus {
  OPEN
  ASSIGNED
  RESOLVED
  IGNORED
}

model ReconciliationDiscrepancy {
  id               String            @id @default(cuid())
  env              PaymentEnv
  type             DiscrepancyType
  provider         String
  // The business/transaction key this discrepancy is about (bookingId / providerRef).
  entityRef        String
  amountMinor      Int?
  currency         String?
  detail           String?
  status           DiscrepancyStatus @default(OPEN)
  assignedToUserId String?
  resolutionNotes  String?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([status])
  @@index([env, type])
  @@index([entityRef])
}

// Sandbox certification of a merchant/provider combination (ADR-027). Records the
// result of the automated end-to-end certification run (health → payment → webhook
// → confirm → ticket → partial refund → refund webhook → reconcile → settlement).
enum CertificationResult {
  PASS
  PARTIAL
  FAIL
}

model MerchantCertification {
  id                   String              @id @default(cuid())
  merchantOnboardingId String?
  env                  PaymentEnv
  provider             String
  result               CertificationResult
  // Steps: [{ step, label, status: PASS|FAIL|SKIP, detail, ref }] (refs are tx ids,
  // never secrets).
  steps                Json
  passedCount          Int                 @default(0)
  failedCount          Int                 @default(0)
  skippedCount         Int                 @default(0)
  operator             String?
  createdAt            DateTime            @default(now())

  @@index([merchantOnboardingId])
  @@index([env, provider])
}

// Controlled environment promotion of a provider configuration (ADR-026). A
// promotion is validated, then approved (two-person for PRODUCTION), then applied —
// never copied blindly. The report + approvals are retained for audit.
enum PromotionStatus {
  PENDING_APPROVAL
  APPROVED
  APPLIED
  REJECTED
}

model PromotionRequest {
  id                String          @id @default(cuid())
  provider          String
  fromEnv           PaymentEnv
  toEnv             PaymentEnv
  status            PromotionStatus @default(PENDING_APPROVAL)
  requiredApprovals Int             @default(1)
  // Validation report snapshot at request time: { ok, checks: [...] }.
  report            Json
  // Approvals list: [{ userId, at, note }] — distinct users; 2 required for prod.
  approvals         Json            @default("[]")
  requestedByUserId String?
  rejectedReason    String?
  appliedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([toEnv, status])
  @@index([provider])
}

// Editable routing policy. For an environment a (country, currency, method) tuple
// selects a primary provider and an optional failover provider. '*' is a wildcard;
// the most specific active row wins, ties broken by priority (lower first).
model PaymentRoute {
  id               String     @id @default(cuid())
  env              PaymentEnv
  country          String     @default("*") // ISO-3166 alpha-2 or '*'
  currency         String     @default("*") // ISO-4217 or '*'
  method           String     @default("*") // PaymentMethod or '*'
  provider         String // primary provider name
  failoverProvider String? // optional secondary provider
  priority         Int        @default(100)
  active           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([env, country, currency, method])
  @@index([env, active])
}

// ─────────── Stripe Connect marketplace models (US) ───────────

// A per-organizer connected account (distinct from the platform-level MerchantAccount,
// which models ETicketsGo's OWN provider accounts). Holds only non-secret Stripe
// identifiers + capability flags synced from account.updated. One per org per provider.
model OrganizerPaymentAccount {
  id                String                  @id @default(cuid())
  organizationId    String
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          String                  @default("stripe")
  // Stripe connected account id (acct_...). A non-secret reference, never a credential.
  providerAccountId String?
  accountType       String                  @default("express") // express | standard | custom
  onboardingStatus  ConnectOnboardingStatus @default(NOT_STARTED)
  detailsSubmitted  Boolean                 @default(false)
  chargesEnabled    Boolean                 @default(false)
  payoutsEnabled    Boolean                 @default(false)
  // Stripe requirements.currently_due (field names only, never PII).
  requirementsDue   String[]                @default([])
  disabledReason    String?
  country           String                  @default("US")
  defaultCurrency   String                  @default("usd")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  settlements Settlement[]

  @@unique([organizationId, provider])
  @@index([providerAccountId])
}

// Event-scoped settlement batch: the organizer's held proceeds and their release
// lifecycle. Funds only leave the platform via an authorised transfer after the event.
model Settlement {
  id                 String                   @id @default(cuid())
  organizationId     String
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId            String
  event              Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accountId          String?
  account            OrganizerPaymentAccount? @relation(fields: [accountId], references: [id])
  provider           String                   @default("stripe")
  currency           String                   @default("usd")
  // Ledger (integer minor units), recomputed immediately before release.
  grossSalesMinor    Int                      @default(0)
  refundsMinor       Int                      @default(0)
  disputesMinor      Int                      @default(0)
  platformFeesMinor  Int                      @default(0)
  reserveMinor       Int                      @default(0)
  payableMinor       Int                      @default(0)
  transferredMinor   Int                      @default(0)
  // Stripe transfer id (tr_...) once released, and the destination connected account.
  providerTransferId String?
  connectedAccountId String?
  status             SettlementStatus         @default(PENDING)
  approvedByUserId   String?
  blockedReason      String?
  failureMessage     String?
  releasedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  payments Payment[]

  @@unique([eventId, currency])
  @@index([organizationId, status])
  @@index([status])
  @@index([providerTransferId])
  @@index([accountId])
}

// Provider webhook idempotency + dead-letter store, keyed on the provider event id.
model WebhookEvent {
  id               String                  @id @default(cuid())
  provider         String                  @default("stripe")
  providerEventId  String
  eventType        String
  // SHA-256 of the raw payload (tamper-evidence); the parsed event is kept in `payload`.
  payloadHash      String?
  payload          Json?
  processingStatus WebhookProcessingStatus @default(RECEIVED)
  attempts         Int                     @default(0)
  processedAt      DateTime?
  errorMessage     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  // Provider event ids are globally unique — the idempotency guarantee.
  @@unique([provider, providerEventId])
  @@index([processingStatus])
  @@index([provider, eventType])
}

// Chargeback/dispute mirrored from Stripe. The platform is the merchant of record
// (Separate Charges & Transfers), so disputes settle against the platform account.
model Dispute {
  id                String        @id @default(cuid())
  provider          String        @default("stripe")
  providerDisputeId String
  paymentId         String?
  payment           Payment?      @relation(fields: [paymentId], references: [id])
  bookingId         String?
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id])
  eventId           String?
  amountMinor       Int
  currency          String        @default("usd")
  reason            String?
  status            DisputeStatus @default(NEEDS_RESPONSE)
  // Raw Stripe dispute.status for audit (e.g. warning_needs_response, won, lost).
  stripeStatus      String?
  evidenceDueBy     DateTime?
  resolvedAt        DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([provider, providerDisputeId])
  @@index([organizationId])
  @@index([status])
  @@index([paymentId])
}

// ─── External inventory synchronization platform (ADR-040, P4) ───

enum SyncEventStatus {
  RECEIVED // persisted, not yet verified/processed
  VERIFIED // signature verified
  REJECTED // failed security (signature/replay/size) — terminal
  QUEUED // enqueued for async processing
  PROCESSING // worker running
  PROCESSED // applied successfully
  RETRYABLE_FAILURE // transient failure; will retry
  PERMANENT_FAILURE // unrecoverable schema/permanent error — terminal
  DEAD_LETTERED // exceeded max attempts — terminal, ops review
  MANUAL_REVIEW // ambiguous/ordering/mapping — needs a human
  DUPLICATE // a re-delivery of an already-seen event
}

enum ProviderMappingStatus {
  ACTIVE
  UNMAPPED
  AMBIGUOUS
  DISABLED
  DELETED
  MANUAL_REVIEW
}

enum InventoryOwnershipMode {
  LOCAL_AUTHORITATIVE
  PROVIDER_AUTHORITATIVE
  ALLOCATED
}

/// Durable, reprocessable raw external inventory event (ADR-040). Stores enough of the
/// original event to reprocess, investigate, verify signatures, and reconcile. Raw
/// payloads are never exposed to customers. Identity = (providerCode, providerTenantId,
/// externalEventId); when the provider has no stable id, a deterministic idempotency key
/// derived from normalized fields + payload hash is used (never the receipt timestamp).
model RawProviderEvent {
  id                 String          @id @default(cuid())
  providerCode       String
  providerTenantId   String          @default("")
  externalEventId    String
  eventType          String
  eventVersion       Int?
  externalEntityId   String?
  receivedAt         DateTime        @default(now())
  providerOccurredAt DateTime?
  signatureStatus    String          @default("UNVERIFIED")
  processingStatus   SyncEventStatus @default(RECEIVED)
  attemptCount       Int             @default(0)
  payloadHash        String
  payloadJson        Json?
  headersMetadata    Json?
  correlationId      String?
  lastErrorCode      String?
  lastErrorMessage   String?
  processedAt        DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([providerCode, providerTenantId, externalEventId])
  @@index([processingStatus])
  @@index([providerCode, eventType])
  @@index([receivedAt])
}

/// Durable mapping of a provider entity to an ETicketsGo entity (ADR-040). A single
/// provider external id maps to at most one internal record within a provider scope
/// (the unique constraint). Ambiguity is never guessed — it is recorded as AMBIGUOUS /
/// MANUAL_REVIEW and fails safe. `externalVersion` guards against stale/out-of-order
/// updates. `ownershipMode` selects the sync rules that apply.
model ProviderMapping {
  id                    String                 @id @default(cuid())
  providerCode          String
  providerTenantId      String                 @default("")
  externalEntityType    String
  externalEntityId      String
  internalEntityType    String?
  internalEntityId      String?
  externalVersion       Int?
  ownershipMode         InventoryOwnershipMode @default(PROVIDER_AUTHORITATIVE)
  lastProviderUpdatedAt DateTime?
  lastSyncedAt          DateTime?
  status                ProviderMappingStatus  @default(UNMAPPED)
  mappingMetadata       Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([providerCode, providerTenantId, externalEntityType, externalEntityId])
  @@index([status])
  @@index([internalEntityType, internalEntityId])
}

/// Durable polling checkpoint per (provider, tenant, resource). The cursor/watermark is
/// only advanced AFTER all records in a page are durably accepted. A lease column
/// records the current owner + expiry so only one node polls a resource at a time.
model ProviderSyncCheckpoint {
  id                   String    @id @default(cuid())
  providerCode         String
  providerTenantId     String    @default("")
  resource             String
  cursor               String?
  watermark            DateTime?
  lastSuccessfulPollAt DateTime?
  nextPollAt           DateTime?
  leaseOwner           String?
  leaseExpiresAt       DateTime?
  failureCount         Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([providerCode, providerTenantId, resource])
  @@index([nextPollAt])
}

/// Provider-imported ADVISORY inventory state for a mapped session (ADR-040 §14–16).
/// This is an imported VIEW of provider-owned stock — it NEVER overwrites authoritative
/// local inventory (ShowSeat / TicketInventory). `version` enforces monotonic ordering.
model ProviderInventoryState {
  id                String                 @id @default(cuid())
  providerCode      String
  providerTenantId  String                 @default("")
  externalSessionId String
  ownershipMode     InventoryOwnershipMode @default(PROVIDER_AUTHORITATIVE)
  /// Per-seat advisory state keyed by stable external seat id.
  seatStates        Json?
  layoutVersion     String?
  providerRemaining Int?
  providerCapacity  Int?
  /// pending local provider-confirmations tracked separately from provider availability.
  pendingLocal      Int                    @default(0)
  /// Authoritative ALLOCATED-inventory consumption (ADR-042 P5.3A.1). Maintained
  /// transactionally: held on initiate (guarded so heldLocal+confirmedLocal never exceeds
  /// providerCapacity), moved held→confirmed on confirmation, released on expire/unpaid-cancel.
  heldLocal         Int                    @default(0)
  confirmedLocal    Int                    @default(0)
  safetyBuffer      Int                    @default(0)
  version           Int                    @default(0)
  providerUpdatedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([providerCode, providerTenantId, externalSessionId])
  @@index([externalSessionId])
}

// ─── Transactional outbox + durable domain-event delivery (ADR-041, P2.1) ───

enum OutboxStatus {
  PENDING // recorded in the business tx; awaiting dispatch
  PROCESSING // claimed by a dispatcher (leased)
  DELIVERED // all required handlers completed
  RETRYABLE_FAILURE // transient failure; will retry after availableAt
  DEAD_LETTERED // exceeded max attempts — terminal, ops review
  MANUAL_REVIEW // ambiguous/permanent-review — needs a human
  CANCELLED // operator-cancelled (never delivered)
}

/// Durable outbox row written in the SAME PostgreSQL transaction as the business
/// mutation (ADR-041). The dispatcher later claims and delivers it via the P2
/// DomainEventBus with at-least-once semantics. Preserves the P2 DomainEvent envelope
/// exactly. No secrets, card data, provider credentials, or unnecessary PII.
model OutboxEvent {
  id               String       @id @default(cuid())
  eventId          String       @unique
  eventType        String
  eventVersion     Int
  aggregateType    String
  aggregateId      String
  occurredAt       DateTime
  correlationId    String?
  causationId      String?
  actorId          String?
  tenantId         String?
  payloadJson      Json
  metadataJson     Json?
  payloadHash      String
  status           OutboxStatus @default(PENDING)
  priority         Int          @default(0)
  /// Shadow rows (dual_write_shadow mode) are recorded for comparison and NEVER
  /// delivered to production handlers by the dispatcher.
  shadow           Boolean      @default(false)
  availableAt      DateTime     @default(now())
  attemptCount     Int          @default(0)
  maxAttempts      Int          @default(12)
  lockedAt         DateTime?
  lockedBy         String?
  lockExpiresAt    DateTime?
  lastAttemptAt    DateTime?
  deliveredAt      DateTime?
  failedAt         DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Claim ordering + stale-lease recovery + aggregate/correlation lookups.
  @@index([status, availableAt, priority, createdAt])
  @@index([aggregateType, aggregateId])
  @@index([correlationId])
  @@index([status, lockExpiresAt])
}

enum HandlerDeliveryStatus {
  PROCESSING
  COMPLETED
  FAILED
}

/// Durable per-handler idempotency (ADR-041). At-least-once delivery means a handler
/// may be invoked more than once for the same eventId; the unique (eventId, handlerName)
/// row makes the side effect run once. A COMPLETED row short-circuits redelivery; a
/// FAILED row may be re-claimed for retry. Handler identity must be stable across
/// deploys (renaming a handler is a migration concern).
model ProcessedDomainEvent {
  id            String                @id @default(cuid())
  eventId       String
  handlerName   String
  status        HandlerDeliveryStatus @default(PROCESSING)
  attemptCount  Int                   @default(1)
  processedAt   DateTime?
  lastErrorCode String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([eventId, handlerName])
  @@index([eventId])
}

// ─── Provider-neutral booking orchestration (ADR-042, P5) ───

enum BookingWorkflowState {
  DRAFT
  INVENTORY_RESOLVED
  LOCK_PENDING
  LOCKED
  PROVIDER_RESERVATION_PENDING
  PROVIDER_RESERVED
  PAYMENT_PENDING
  PAYMENT_AUTHORIZED
  PROVIDER_CONFIRM_PENDING
  PROVIDER_CONFIRMED
  CONFIRMING
  CONFIRMED
  TICKET_PENDING
  TICKET_ISSUED
  CANCELLATION_PENDING
  CANCELLED
  REFUND_PENDING
  REFUNDED
  EXPIRING
  EXPIRED
  COMPENSATION_PENDING
  COMPENSATED
  MANUAL_REVIEW
  FAILED
}

/// Durable booking-workflow ownership (ADR-042, P5.2A). Decided SERVER-SIDE — the client
/// never selects the owner type. USER = authenticated principal; ANONYMOUS_SESSION = a
/// server-issued, cryptographically-strong guest session (persisted only as a hash);
/// INTERNAL = a trusted system/worker identity for privileged operations.
enum BookingOwnerType {
  USER
  ANONYMOUS_SESSION
  INTERNAL
}

/// Durable orchestration workflow for one booking (ADR-042). The orchestrator is the ONLY
/// writer; every advance uses optimistic concurrency (`version`) so two workers/callbacks
/// cannot advance the same workflow inconsistently. Holds durable lock identity (lockId +
/// fencingToken) for full bidirectional reconciliation, the selected provider + ownership
/// mode, and provider/payment references. No secrets or raw provider payloads.
model BookingWorkflow {
  id                             String                 @id @default(cuid())
  bookingId                      String                 @unique
  workflowType                   String                 @default("BOOKING")
  state                          BookingWorkflowState   @default(DRAFT)
  version                        Int                    @default(0)
  selectedProviderCode           String?
  inventoryOwnershipMode         InventoryOwnershipMode @default(LOCAL_AUTHORITATIVE)
  /// Durable server-decided ownership (ADR-042 P5.2A). ownerId is the user id for USER,
  /// the SHA-256 hash of the anonymous session token for ANONYMOUS_SESSION (never the raw
  /// token), or a trusted service identity for INTERNAL. Every customer operation validates
  /// the request owner against these fields — a valid bookingId alone never suffices.
  ownerType                      BookingOwnerType?
  ownerId                        String?
  /// Tenant (organization) + organizer scope captured at initiation for isolation checks.
  tenantId                       String?
  organizerId                    String?
  lockId                         String?
  fencingToken                   Int?
  paymentProvider                String?
  providerReservationId          String?
  providerBookingId              String?
  providerStatus                 String?
  /// External booking provider lifecycle (ADR-042 §9, P5.2B). Durable enough to safely
  /// continue and reconcile a PROVIDER_AUTHORITATIVE workflow across restarts. No provider
  /// secrets or raw response payloads are stored here — only summarized state.
  providerRequestIdempotencyKey  String?
  providerReservationExpiresAt   DateTime?
  providerVersion                Int?
  providerLastAttemptAt          DateTime?
  providerAttemptCount           Int                    @default(0)
  providerLastErrorCode          String?
  providerLastResponseCategory   String?
  providerConfirmedAt            DateTime?
  providerCancelledAt            DateTime?
  providerReconciliationRequired Boolean                @default(false)
  /// ALLOCATED-inventory accounting linkage + exactly-once marker (ADR-042 P5.3A.1). The
  /// marker guards the held→confirmed move and the held release so each happens exactly once
  /// per booking even under duplicate callbacks / repeated sweeps.
  allocationProviderCode         String?
  allocationExternalRef          String?
  allocationHeldQty              Int?
  allocationAccountingState      String                 @default("NONE") // NONE | HELD | CONFIRMED | RELEASED
  attemptCount                   Int                    @default(0)
  nextActionAt                   DateTime?
  lastErrorCode                  String?
  manualReviewReason             String?
  correlationId                  String?
  /// Idempotency key from the initiating request (same key ⇒ same workflow/booking).
  idempotencyKey                 String?
  requestFingerprint             String?
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  @@unique([workflowType, idempotencyKey])
  /// A provider reservation reference is unique within its provider scope (idempotent reserve).
  @@unique([selectedProviderCode, providerReservationId])
  /// A provider booking reference is unique within its provider scope.
  @@unique([selectedProviderCode, providerBookingId])
  @@index([state, nextActionAt])
  @@index([selectedProviderCode])
  @@index([correlationId])
  @@index([ownerType, ownerId])
  @@index([tenantId])
  /// Pending provider confirmation (payment done, provider not yet confirmed).
  @@index([state, providerStatus])
  /// Expired provider reservations awaiting cleanup.
  @@index([providerReservationExpiresAt])
  /// Workflows flagged for reconciliation.
  @@index([providerReconciliationRequired])
}

/// A single booking-compensation action (ADR-043, P5.3A). Focused durable model — NOT a
/// generic task table. Each row is one planned recovery action for one booking, with a
/// stable idempotency identity so duplicate planning/execution can never move money twice or
/// cancel a provider booking twice. Execution is gated by flags (all off by default); money-
/// moving actions stay disabled in P5.3A. No secrets or raw provider payloads are stored.
enum CompensationType {
  PAYMENT_VOID
  PAYMENT_REFUND
  PROVIDER_RESERVATION_CANCEL
  PROVIDER_BOOKING_CANCEL
  LOCAL_HOLD_RELEASE
  REDIS_LOCK_RELEASE
  LOCAL_CONFIRMATION_RETRY
  PROVIDER_STATUS_RECOVERY
  MANUAL_REVIEW
}

enum CompensationState {
  PLANNED
  READY
  PROCESSING
  RETRYABLE_FAILURE
  COMPLETED
  DEAD_LETTERED
  MANUAL_REVIEW
  CANCELLED
}

model BookingCompensation {
  id                    String            @id @default(cuid())
  bookingId             String
  workflowId            String?
  tenantId              String?
  compensationType      CompensationType
  state                 CompensationState @default(PLANNED)
  version               Int               @default(0)
  reasonCode            String
  /// The concrete target this action operates on (payment ref, reservation id, lock id, …).
  /// Part of the idempotency identity so one action per target is enforced by the DB.
  targetReference       String            @default("")
  /// Bumps only when an authoritative new generation of a booking's recovery is required.
  generation            Int               @default(1)
  paymentProvider       String?
  paymentReference      String?
  externalProviderCode  String?
  providerReservationId String?
  providerBookingId     String?
  amountMinor           Int?
  currency              String?
  /// Server-generated stable key for the executor's provider/payment idempotency.
  idempotencyKey        String
  autoExecutable        Boolean           @default(false)
  attemptCount          Int               @default(0)
  maxAttempts           Int               @default(5)
  availableAt           DateTime          @default(now())
  lockedBy              String?
  lockedAt              DateTime?
  lockExpiresAt         DateTime?
  lastAttemptAt         DateTime?
  completedAt           DateTime?
  failedAt              DateTime?
  lastErrorCode         String?
  lastErrorMessage      String?
  manualReviewReason    String?
  correlationId         String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  /// Idempotency: one action per (booking, type, target, generation). A concurrent planner
  /// loses the unique race and re-reads the existing record.
  // Explicit constraint name pinned to what PostgreSQL actually stored: the migration wrote a
  // 76-char index name which Postgres truncated to 63 chars. Without this map, Prisma derives a
  // different 63-char truncation (`..._targetRefere_key`) → schema/DB drift (P6.3 migration gate).
  @@unique([bookingId, compensationType, targetReference, generation], map: "BookingCompensation_bookingId_compensationType_targetReference_")
  @@unique([idempotencyKey])
  @@index([state, availableAt])
  @@index([bookingId])
  @@index([tenantId])
  @@index([lockExpiresAt])
}

/// What kind of document this is.
///
/// The distinction is not cosmetic. A TAX_INVOICE can only be issued by a seller who has a
/// tax registration to put on it — issuing one without a registration number is a document
/// that claims something untrue. So the platform issues a plain RECEIPT until an organizer
/// records their registration, and upgrades from there. Nothing about this decides what tax
/// is owed; it only decides what the document is honestly called.
enum ReceiptKind {
  RECEIPT
  TAX_INVOICE
  CREDIT_NOTE
}

/// An issued financial document: a receipt or tax invoice for a sale, or a credit note for a
/// refund.
///
/// ── WHY THIS IS A ROW AND NOT A RENDERED VIEW ─────────────────────────────────────────
/// Rendering a receipt on demand from the live booking looks equivalent and is not. The
/// seller's legal name changes; the platform's fee structure changes; a tax rule is
/// superseded. A document reprinted two years later must show what was true on the day it
/// was issued, so the whole thing is snapshotted into `documentJson` at issue time and never
/// recomputed.
///
/// Numbering is sequential and gapless per organization, because a numbering scheme with
/// holes in it is the first thing an auditor asks about.
model Receipt {
  id     String      @id @default(cuid())
  /// Human-readable, e.g. "INV-2026-000042". Unique within the ISSUING ORGANIZATION, which
  /// is the only scope in which an invoice number means anything — a seller's books are
  /// numbered independently of every other seller's. Making it globally unique would force
  /// the platform's identity into the number and give each organizer a series full of holes.
  number String
  kind   ReceiptKind

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  bookingId      String
  booking        Booking      @relation(fields: [bookingId], references: [id])

  /// Set to the booking id on a sale document, null on a credit note. This is how "at most
  /// one receipt per booking" becomes a DATABASE constraint rather than a hope: a nullable
  /// unique column ignores the nulls, so any number of credit notes can coexist with exactly
  /// one sale document. Two concurrent confirmations cannot both issue.
  saleForBookingId String?   @unique
  /// Set on a credit note, and unique, so a retried refund cannot issue a second one.
  refundId         String?   @unique
  refund           Refund?   @relation(fields: [refundId], references: [id])
  /// The sale document a credit note reverses.
  reversesId       String?
  reverses         Receipt?  @relation("ReceiptReversal", fields: [reversesId], references: [id])
  reversedBy       Receipt[] @relation("ReceiptReversal")

  issuedAt DateTime @default(now())
  currency String

  /// Denormalised for listing and reconciliation without parsing JSON. Credit notes carry
  /// NEGATIVE amounts, so summing a period's documents gives net revenue directly.
  subtotalMinor Int
  discountMinor Int
  feeMinor      Int
  taxMinor      Int
  totalMinor    Int

  /// The immutable rendered document: seller identity, buyer, lines, tax breakdown, totals.
  documentJson Json

  createdAt DateTime @default(now())

  @@unique([organizationId, number])
  @@index([organizationId, issuedAt])
  @@index([bookingId])
}

/// Per-scope gapless counter behind `Receipt.number`, incremented inside the issuing
/// transaction. Same mechanism as BookingReferenceCounter.
model ReceiptCounter {
  scope String @id
  value Int    @default(0)
}

/// An affirmative, provable record that somebody agreed to receive commercial messages.
///
/// ── WHY THIS IS NOT A BOOLEAN ON USER ─────────────────────────────────────────────
/// Canada's anti-spam law expects a sender to be able to PRODUCE the consent — when it was
/// given, through what, and by whom. A boolean answers "are they subscribed now" and
/// nothing else: it cannot show that consent was ever given rather than defaulted on, it
/// is destroyed by the next write, and a withdrawal leaves no trace that it happened.
///
/// So consent is an append-only log. The current state is the newest row for a
/// (subject, channel); a withdrawal is a new row with `granted = false`, never an edit.
/// `source` records HOW it was obtained, because "checkbox at checkout" and "imported from
/// a spreadsheet" are not the same thing and only one of them is defensible.
///
/// Keyed on EMAIL as well as user id: guests buy tickets without an account, and consent
/// belongs to the person, not to whether they happen to have registered.
model MarketingConsent {
  id      String  @id @default(cuid())
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  /// Lower-cased. The stable subject when there is no account.
  email   String
  /// 'email' | 'push' | 'sms' | 'whatsapp' — matches the notification channel keys.
  channel String

  granted   Boolean
  /// Free text describing how it was obtained, e.g. 'checkout-optin', 'account-settings',
  /// 'withdrawn-by-user', 'unsubscribe-link'. Recorded verbatim; never inferred.
  source    String
  /// Retained only for consent provenance, and only when the request carried it.
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  /// Newest row per subject+channel is the current state, so the read is an index scan.
  @@index([email, channel, createdAt])
  @@index([userId, channel, createdAt])
}

/// One back-office capability held by one account.
///
/// ── WHY A ROW PER GRANT, NOT A COLUMN OF ROLES ────────────────────────────────────
/// A grant has provenance: who gave it, when, and — when it ends — who took it away. A
/// role column answers "what can they do now" and destroys the answer to "who decided
/// that", which is the question asked after something goes wrong. Splitting back-office
/// duties is pointless if nobody can reconstruct who held which duty on the day.
///
/// Revocation deletes the row and the audit log records it, so the live table stays a
/// simple answer to "what can this person do right now" while the history lives where
/// history belongs.
model AdminGrant {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("AdminGrantHolder", fields: [userId], references: [id], onDelete: Cascade)

  /// A member of the AdminPermission catalogue in shared-types. Stored as text rather than
  /// a Prisma enum so adding a capability is a code change and not a migration — the
  /// catalogue is the source of truth and an unknown value simply grants nothing.
  permission String

  grantedByUserId String?
  grantedBy       User?   @relation("AdminGrantIssuer", fields: [grantedByUserId], references: [id], onDelete: SetNull)
  /// Free text from whoever granted it: which ticket, which approval, which rota.
  note            String?

  createdAt DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}
