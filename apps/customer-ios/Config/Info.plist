<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ETGEnvironment</key>
	<string>$(APP_ENV)</string>
	<key>ETGAPIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>ETGAllowMutations</key>
	<string>$(ALLOW_MUTATIONS)</string>
	<key>ETGWebHost</key>
	<string>$(WEB_HOST)</string>
	<key>ETGNativeCheckout</key>
	<string>$(NATIVE_CHECKOUT)</string>
	<key>ETGAllowBookingWrites</key>
	<string>$(ALLOW_BOOKING_WRITES)</string>
	<key>ETGQATestAccounts</key>
	<string>$(QA_TEST_ACCOUNTS)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.eticketsgo.customer.native.return</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(APP_URL_SCHEME)</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
