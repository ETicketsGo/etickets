// Settings shared by every configuration of the ETicketsGo app target.
// Per-environment values (API host, bundle id, mutation policy) live in Mock/QA/Prod.xcconfig.
// Nothing in these files is a secret: API hosts are public, and no keys or tokens belong here.

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0

PRODUCT_NAME = ETicketsGo
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

INFOPLIST_FILE = Config/Info.plist
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = $(APP_DISPLAY_NAME)
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UIApplicationSceneManifest_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UIUserInterfaceStyle = Automatic

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

CODE_SIGN_STYLE = Automatic
ENABLE_PREVIEWS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_EMIT_LOC_STRINGS = YES
CLANG_ENABLE_MODULES = YES
ALWAYS_SEARCH_USER_PATHS = NO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
