// PROD — release build against the production API. Read-only in Phase 1: APIClient refuses
// every non-GET request in this environment regardless of ALLOW_MUTATIONS.
#include "Base.xcconfig"

APP_ENV = prod
API_BASE_URL = https:/$()/api.eticketsgo.com/api
ALLOW_MUTATIONS = NO
QA_TEST_ACCOUNTS =
APP_DISPLAY_NAME = ETicketsGo
// Placeholder: the Expo app ships as com.eticketsgo.customer. Whether the native app takes
// over that identifier is an open release decision (see README).
PRODUCT_BUNDLE_IDENTIFIER = com.eticketsgo.customer.native

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
VALIDATE_PRODUCT = YES
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
