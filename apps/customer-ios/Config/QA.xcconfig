// QA — reads from the Railway QA API (apps/customer-mobile/eas.json "qa" profile).
// `//` starts a comment in xcconfig, hence the `$()` inside the scheme separator.
#include "Base.xcconfig"

APP_ENV = qa
API_BASE_URL = https:/$()/api-qa.eticketsgo.com/api
ALLOW_MUTATIONS = YES
// QA writes — including sign-in, sign-up and OTP — are allowed only for the identities in
// QA_TEST_ACCOUNTS: exact email addresses or E.164 phone numbers of approved QA test accounts,
// space-separated. No wildcards. Empty (the committed default) means nobody.
//
// The real list is not committed: put it in Config/QA.local.xcconfig (git-ignored), e.g.
//   QA_TEST_ACCOUNTS = qa.tester1@<approved-domain> +<approved test number>
QA_TEST_ACCOUNTS =
// Holds, payments and cancellations against QA. Off until separately approved.
ALLOW_BOOKING_WRITES = NO
// Hosted checkout from the app. Off until real QA checkout is certified.
NATIVE_CHECKOUT = NO
WEB_HOST = qa.eticketsgo.com
// Payment-return links when universal links aren't available. Distinct from the Expo app's
// `etickets` scheme so the two apps never claim each other's links.
APP_URL_SCHEME = etgnative-qa
#include? "QA.local.xcconfig"
APP_DISPLAY_NAME = ETicketsGo QA
PRODUCT_BUNDLE_IDENTIFIER = com.eticketsgo.customer.native.qa

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
DEBUG_INFORMATION_FORMAT = dwarf
