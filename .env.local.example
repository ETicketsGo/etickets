# ─────────────────────────────────────────────────────────────
# ETicketsGo — LOCAL environment (developer machine)
# Payment posture: simulated dummy provider only, no external calls, no real money.
# Copy the FULL variable set from .env.example; this file shows the LOCAL deltas.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_ENV=LOCAL

# Payments run entirely on the in-process dummy/mock provider. The mock "simulate
# payment" path is allowed (guarded by NODE_ENV != production).
PAYMENT_PROVIDER_NAME=mock
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret-change-me"
# PAYMENTS_MOCK_ENABLED=true

# Runtime routing (seeded): LOCAL routes every currency to the dummy provider.
# No gateway credentials are required. Do NOT enable a real provider in LOCAL.
