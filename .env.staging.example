# ─────────────────────────────────────────────────────────────
# ETicketsGo — STAGING environment (production mirror)
# Payment posture: real providers in LIVE mode. FAIL CLOSED — the API refuses to
# boot if payment configuration is invalid (disabled/placeholder providers,
# routes to disabled providers, dummy enabled, or no route). Real money moves.
# Copy the FULL variable set from .env.example; this file shows the STAGING deltas.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
APP_ENV=STAGING

PAYMENT_PROVIDER_NAME=stripe
PAYMENT_WEBHOOK_SECRET="staging-webhook-secret-from-secret-manager"

# LIVE credentials, injected from secret-manager references at boot:
#   payments/stripe/staging/secret-key       payments/stripe/staging/webhook-secret
#   payments/razorpay/staging/secret-key      payments/razorpay/staging/webhook-secret
STRIPE_SECRET_KEY="sk_live_replace_from_secret_manager"
STRIPE_WEBHOOK_SECRET="whsec_replace_from_secret_manager"
STRIPE_SUCCESS_URL="https://staging.eticketsgo.com/checkout/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="https://staging.eticketsgo.com/checkout/cancel"
RAZORPAY_KEY_ID="rzp_live_replace_from_secret_manager"
RAZORPAY_KEY_SECRET="replace_from_secret_manager"
RAZORPAY_WEBHOOK_SECRET="replace_from_secret_manager"

# Enable + verify each provider in the admin console (Test connection) before it
# serves traffic. Never commit real credentials.
